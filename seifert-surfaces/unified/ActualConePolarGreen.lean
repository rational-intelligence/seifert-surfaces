/-- The original cone and displayed jets in positive-radius polar coordinates. -/
theorem actual_cone_polar_pullback (R : ℝ) (Ω : SmoothFlatJordanDomain R)
    (r t : ℝ) (r_pos : 0 < r) :
  let angle : E2 → ℝ := fun z => Complex.arg ((z 0 : ℂ) + (z 1 : ℂ) * Complex.I)
  let cone : E2 → E2 := fun z => ‖z‖ • Ω.boundary.gamma (angle z)
  let jets : Fin 2 → E2 → E2 := fun i z =>
    if z = 0 then 0 else
      (Ω.boundary.gamma (angle z) i / ‖z‖) • z +
      (deriv Ω.boundary.gamma (angle z) i / ‖z‖) •
        (EuclideanSpace.equiv (Fin 2) ℝ).symm ![-z 1, z 0]
  cone (r • unitCircleParameter t) = r • Ω.boundary.gamma t ∧
    ∀ i : Fin 2, jets i (r • unitCircleParameter t) =
      (Ω.boundary.gamma t i) • unitCircleParameter t +
        (deriv Ω.boundary.gamma t i) •
          (EuclideanSpace.equiv (Fin 2) ℝ).symm
            ![-unitCircleParameter t 1, unitCircleParameter t 0] := by run_tac do Lean.Elab.Tactic.evalTactic (← Lean.ofExcept (Lean.Parser.runParserCategory (← Lean.getEnv) `tactic "exact (by\n  classical\n  have circle_norm : ‖unitCircleParameter t‖ = 1 := by\n    have hs : ‖unitCircleParameter t‖ ^ 2 = 1 := by\n      rw [EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_two]\n      exact Real.cos_sq_add_sin_sq t\n    nlinarith [norm_nonneg (unitCircleParameter t)]\n  have radial_norm : ‖r • unitCircleParameter t‖ = r := by\n    rw [norm_smul, Real.norm_eq_abs, abs_of_pos r_pos, circle_norm, mul_one]\n  have radial_ne : r • unitCircleParameter t ≠ 0 := by\n    intro h\n    have hzero : ‖r • unitCircleParameter t‖ = 0 := by rw [h, norm_zero]\n    rw [radial_norm] at hzero\n    exact r_pos.ne' hzero\n  have complex_radial :\n      (((r • unitCircleParameter t) 0 : ℂ) +\n        ((r • unitCircleParameter t) 1 : ℂ) * Complex.I) =\n        (r : ℂ) * (Circle.exp t : ℂ) := by\n    change ((r * Real.cos t : ℝ) : ℂ) + ((r * Real.sin t : ℝ) : ℂ) * Complex.I =\n      (r : ℂ) * (Circle.exp t : ℂ)\n    simp only [Complex.ofReal_mul, Circle.coe_exp, Complex.exp_mul_I]\n    rw [← Complex.ofReal_cos, ← Complex.ofReal_sin]\n    ring\n  have angle_eq :\n      Complex.arg (((r • unitCircleParameter t) 0 : ℂ) +\n        ((r • unitCircleParameter t) 1 : ℂ) * Complex.I) =\n        Complex.arg (Circle.exp t : ℂ) := by\n    rw [complex_radial, Complex.arg_real_mul _ r_pos]\n  obtain ⟨n, hn⟩ := Circle.exp_eq_exp.mp (Circle.exp_arg (Circle.exp t))\n  have gamma_eq : Ω.boundary.gamma (Complex.arg (Circle.exp t : ℂ)) =\n      Ω.boundary.gamma t := by\n    rw [hn]\n    exact Ω.boundary.periodic.int_mul n t\n  have derivative_periodic : Function.Periodic (deriv Ω.boundary.gamma) (2 * Real.pi) := by\n    have hf : (fun x => Ω.boundary.gamma (x + 2 * Real.pi)) = Ω.boundary.gamma :=\n      funext Ω.boundary.periodic\n    intro x\n    rw [← deriv_comp_add_const, hf]\n  have derivative_eq : deriv Ω.boundary.gamma (Complex.arg (Circle.exp t : ℂ)) =\n      deriv Ω.boundary.gamma t := by\n    rw [hn]\n    exact derivative_periodic.int_mul n t\n  have rotation_smul :\n      (EuclideanSpace.equiv (Fin 2) ℝ).symm\n        ![-(r • unitCircleParameter t) 1, (r • unitCircleParameter t) 0] =\n      r • (EuclideanSpace.equiv (Fin 2) ℝ).symm\n        ![-unitCircleParameter t 1, unitCircleParameter t 0] := by\n    apply PiLp.ext\n    intro j\n    fin_cases j\n    · change -(r * unitCircleParameter t 1) = r * (-unitCircleParameter t 1)\n      ring\n    · rfl\n  dsimp only\n  constructor\n  · rw [radial_norm, angle_eq, gamma_eq]\n  · intro i\n    rw [ite_eq_right radial_ne, radial_norm, angle_eq, gamma_eq, derivative_eq, rotation_smul]\n    simp only [smul_smul]\n    rw [div_mul_cancel₀ _ r_pos.ne', div_mul_cancel₀ _ r_pos.ne']\n)"))

/-- Exact E2-volume transport of the actual cone Green integrand to the polar rectangle. -/
theorem actual_cone_polar_disc_integral (R : ℝ) (Ω : SmoothFlatJordanDomain R)
    (psi : E2 → ℝ) (smooth_test : ContDiff ℝ ∞ psi) (i j : Fin 2) :
  let angle : E2 → ℝ := fun z => Complex.arg ((z 0 : ℂ) + (z 1 : ℂ) * Complex.I)
  let cone : E2 → E2 := fun z => ‖z‖ • Ω.boundary.gamma (angle z)
  let jets : Fin 2 → E2 → E2 := fun i z =>
    if z = 0 then 0 else
      (Ω.boundary.gamma (angle z) i / ‖z‖) • z +
      (deriv Ω.boundary.gamma (angle z) i / ‖z‖) •
        (EuclideanSpace.equiv (Fin 2) ℝ).symm ![-z 1, z 0]
  (∫ x in disc 1, cone x i * fderiv ℝ psi x (coordinateVector 2 j) +
    jets i x j * psi x) =
    (∫ t in Icc 0 (2 * Real.pi), ∫ r in Icc (0 : ℝ) 1,
      r * (r * Ω.boundary.gamma t i *
        fderiv ℝ psi (r • unitCircleParameter t) (coordinateVector 2 j) +
        (Ω.boundary.gamma t i * unitCircleParameter t j +
          deriv Ω.boundary.gamma t i *
            ((EuclideanSpace.equiv (Fin 2) ℝ).symm
              ![-unitCircleParameter t 1, unitCircleParameter t 0]) j) *
          psi (r • unitCircleParameter t))) := by run_tac do Lean.Elab.Tactic.evalTactic (← Lean.ofExcept (Lean.Parser.runParserCategory (← Lean.getEnv) `tactic "exact (by\n  classical\n  dsimp only\n  let angle : E2 → ℝ := fun z => Complex.arg ((z 0 : ℂ) + (z 1 : ℂ) * Complex.I)\n  let cone : E2 → E2 := fun z => ‖z‖ • Ω.boundary.gamma (angle z)\n  let jets : Fin 2 → E2 → E2 := fun k z =>\n    if z = 0 then 0 else\n      (Ω.boundary.gamma (angle z) k / ‖z‖) • z +\n      (deriv Ω.boundary.gamma (angle z) k / ‖z‖) •\n        (EuclideanSpace.equiv (Fin 2) ℝ).symm ![-z 1, z 0]\n  let f : E2 → ℝ := fun z => cone z i * fderiv ℝ psi z (coordinateVector 2 j) + jets i z j * psi z\n  let c : ℝ → E2 := unitCircleParameter\n  let v : ℝ → E2 := fun t => (EuclideanSpace.equiv (Fin 2) ℝ).symm ![-Real.sin t, Real.cos t]\n  let g : ℝ → ℝ := fun t => Ω.boundary.gamma t i\n  let gp : ℝ → ℝ := fun t => deriv Ω.boundary.gamma t i\n  let H : ℝ → ℝ → ℝ := fun t r => r * (r * g t *\n    fderiv ℝ psi (r • c t) (coordinateVector 2 j) + (g t * c t j + gp t * v t j) * psi (r • c t))\n  change (∫ z in disc 1, f z) = ∫ t in Icc 0 (2 * Real.pi), ∫ r in Icc (0 : ℝ) 1, H t r\n  have hc : Continuous c := by\n    apply (EuclideanSpace.equiv (Fin 2) ℝ).symm.continuous.comp\n    exact continuous_pi fun k : Fin 2 => by fin_cases k <;> simp <;> fun_prop\n  have hv : Continuous v := by\n    apply (EuclideanSpace.equiv (Fin 2) ℝ).symm.continuous.comp\n    exact continuous_pi fun k : Fin 2 => by fin_cases k <;> simp <;> fun_prop\n  have hg : Continuous g := (EuclideanSpace.proj (𝕜 := ℝ) i).continuous.comp Ω.boundary.smooth.continuous\n  have hgp : Continuous gp := (EuclideanSpace.proj (𝕜 := ℝ) i).continuous.comp\n    (Ω.boundary.smooth.continuous_deriv (by simp))\n  have hp : Continuous (fun z : ℝ × ℝ => z.2 • c z.1) := continuous_snd.smul (hc.comp continuous_fst)\n  have hcj : Continuous (fun z : ℝ × ℝ => c z.1 j) :=\n    (EuclideanSpace.proj (𝕜 := ℝ) j).continuous.comp (hc.comp continuous_fst)\n  have hvj : Continuous (fun z : ℝ × ℝ => v z.1 j) :=\n    (EuclideanSpace.proj (𝕜 := ℝ) j).continuous.comp (hv.comp continuous_fst)\n  have hD : Continuous (fderiv ℝ psi) := smooth_test.continuous_fderiv (by simp)\n  have hH : Continuous (uncurry H) := by\n    exact continuous_snd.mul (((continuous_snd.mul (hg.comp continuous_fst)).mul\n      ((hD.comp hp).clm_apply continuous_const)).add\n      ((((hg.comp continuous_fst).mul hcj).add ((hgp.comp continuous_fst).mul hvj)).mul\n        (smooth_test.continuous.comp hp)))\n  have hHr : Continuous (fun z : ℝ × ℝ => H z.2 z.1) := hH.comp continuous_swap\n  have hHi : IntegrableOn (fun z : ℝ × ℝ => H z.2 z.1)\n      (Icc (0 : ℝ) 1 ×ˢ Icc (-Real.pi) Real.pi) :=\n    hHr.continuousOn.integrableOn_compact (isCompact_Icc.prod isCompact_Icc)\n  let Q : Set (ℝ × ℝ) := Ioo (0 : ℝ) 1 ×ˢ Ioo (-Real.pi) Real.pi\n  have hQ : MeasurableSet Q := measurableSet_Ioo.prod measurableSet_Ioo\n  have hQi : IntegrableOn (fun z : ℝ × ℝ => H z.2 z.1) Q :=\n    hHi.mono_set (prod_mono Ioo_subset_Icc_self Ioo_subset_Icc_self)\n  have hQsub : Q ⊆ polarCoord.target := by\n    intro z hz\n    exact ⟨hz.1.1, hz.2⟩\n  let e : E2 ≃ᵐ ℝ × ℝ :=\n    (EuclideanSpace.equiv (Fin 2) ℝ).toHomeomorph.toMeasurableEquiv.trans MeasurableEquiv.finTwoArrow\n  have he : MeasurePreserving e volume volume :=\n    (volume_preserving_finTwoArrow ℝ).comp (PiLp.volume_preserving_ofLp (Fin 2))\n  have hepolar (z : ℝ × ℝ) : e.symm (polarCoord.symm z) = z.1 • c z.2 := by\n    ext k\n    fin_cases k <;> rfl\n  have hn (t : ℝ) : ‖c t‖ = 1 := by\n    have hs : ‖c t‖ ^ 2 = 1 := by\n      rw [EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_two]\n      exact Real.cos_sq_add_sin_sq t\n    nlinarith [norm_nonneg (c t)]\n  have hpull (r t : ℝ) (hr : 0 < r) : r * f (r • c t) = H t r := by\n    have hb := actual_cone_polar_pullback R Ω r t hr\n    change cone (r • c t) = r • Ω.boundary.gamma t ∧\n      ∀ k, jets k (r • c t) = (Ω.boundary.gamma t k) • c t + (deriv Ω.boundary.gamma t k) • v t at hb\n    dsimp only [f, H, g, gp]\n    rw [hb.1, hb.2 i]\n    rfl\n  let F : ℝ × ℝ → ℝ := fun z => (disc 1).indicator f (e.symm z)\n  have htransform (z : ℝ × ℝ) (hz : z ∈ polarCoord.target) :\n      z.1 • F (polarCoord.symm z) = Q.indicator (fun z => H z.2 z.1) z := by\n    have hr : 0 < z.1 := hz.1\n    have hm : e.symm (polarCoord.symm z) ∈ disc 1 ↔ z ∈ Q := by\n      rw [hepolar]\n      change z.1 • c z.2 ∈ Metric.ball (0 : E2) 1 ↔ z ∈ Q\n      rw [Metric.mem_ball, dist_zero_right]\n      rw [norm_smul, Real.norm_eq_abs, abs_of_pos hr, hn, mul_one]\n      change z.1 < 1 ↔ (0 < z.1 ∧ z.1 < 1) ∧ (-Real.pi < z.2 ∧ z.2 < Real.pi)\n      exact ⟨fun h => ⟨⟨hr, h⟩, hz.2⟩, fun h => h.1.2⟩\n    dsimp only [F]\n    by_cases hzQ : z ∈ Q\n    · rw [indicator_of_mem (hm.mpr hzQ), indicator_of_mem hzQ, hepolar]\n      exact hpull z.1 z.2 hr\n    · rw [indicator_of_notMem (mt hm.mp hzQ), indicator_of_notMem hzQ, smul_zero]\n  have hJac : IntegrableOn\n      (fun z => |(fderivPolarCoordSymm z).det| • F (polarCoord.symm z)) polarCoord.target := by\n    have hind : Integrable (Q.indicator (fun z => H z.2 z.1)) :=\n      (integrable_indicator_iff hQ).mpr hQi\n    apply hind.integrableOn.congr_fun _ polarCoord.open_target.measurableSet\n    intro z hz\n    dsimp only\n    rw [det_fderivPolarCoordSymm, abs_of_pos hz.1]\n    exact (htransform z hz).symm\n  have hFi : Integrable F := by\n    have himage : IntegrableOn F (polarCoord.symm '' polarCoord.target) :=\n      (integrableOn_image_iff_integrableOn_abs_det_fderiv_smul volume\n        polarCoord.open_target.measurableSet\n        (fun z _ => (hasFDerivAt_polarCoord_symm z).hasFDerivWithinAt)\n        polarCoord.symm.injOn F).mpr hJac\n    rw [polarCoord.symm_image_target_eq_source] at himage\n    have huniv : IntegrableOn F univ :=\n      himage.congr_set_ae polarCoord_source_ae_eq_univ.symm\n    simpa only [IntegrableOn, Measure.restrict_univ] using huniv\n  have native_bulk_integrable : IntegrableOn f (disc 1) := by\n    apply (integrable_indicator_iff measurableSet_ball).mp\n    exact ((he.symm e).integrable_comp_emb e.symm.measurableEmbedding).mp hFi\n  have hpolar : (∫ z in disc 1, f z) = ∫ z in Q, H z.2 z.1 := by\n    calc\n      (∫ z in disc 1, f z) = ∫ z, (disc 1).indicator f z := (integral_indicator measurableSet_ball).symm\n      _ = ∫ z, F z := (he.symm e).integral_comp' ((disc 1).indicator f) |>.symm\n      _ = ∫ z in polarCoord.target, z.1 • F (polarCoord.symm z) := (integral_comp_polarCoord_symm F).symm\n      _ = ∫ z in polarCoord.target, Q.indicator (fun z => H z.2 z.1) z :=\n        setIntegral_congr_fun polarCoord.open_target.measurableSet htransform\n      _ = ∫ z in Q, H z.2 z.1 := by\n        rw [setIntegral_indicator hQ, inter_eq_right.mpr hQsub]\n  rw [hpolar]\n  have hrectangle : (∫ z in Q, H z.2 z.1) =\n      ∫ z in Icc (0 : ℝ) 1 ×ˢ Icc (-Real.pi) Real.pi, H z.2 z.1 :=\n    setIntegral_congr_set (Measure.set_prod_ae_eq Ioo_ae_eq_Icc Ioo_ae_eq_Icc)\n  rw [hrectangle]\n  change (∫ z in Icc (0 : ℝ) 1 ×ˢ Icc (-Real.pi) Real.pi, H z.2 z.1 ∂(volume.prod volume)) = _\n  rw [← Measure.prod_restrict]\n  have hprod : Integrable (fun z : ℝ × ℝ => H z.2 z.1)\n      ((volume.restrict (Icc (0 : ℝ) 1)).prod (volume.restrict (Icc (-Real.pi) Real.pi))) := by\n    rw [Measure.prod_restrict]\n    exact hHi\n  rw [integral_prod_symm _ hprod]\n  have hgper : Periodic g (2 * Real.pi) := fun t => congrArg (fun x : E2 => x i) (Ω.boundary.periodic t)\n  have hgpper : Periodic gp (2 * Real.pi) := by\n    have hf : (fun x => Ω.boundary.gamma (x + 2 * Real.pi)) = Ω.boundary.gamma := funext Ω.boundary.periodic\n    intro t\n    dsimp only [gp]\n    rw [← deriv_comp_add_const, hf]\n  have hcper : Periodic c (2 * Real.pi) := by\n    intro t\n    ext k\n    fin_cases k\n    · exact Real.cos_periodic t\n    · exact Real.sin_periodic t\n  have hvper : Periodic v (2 * Real.pi) := by\n    intro t\n    ext k\n    fin_cases k\n    · exact congrArg Neg.neg (Real.sin_periodic t)\n    · exact Real.cos_periodic t\n  have hHper (r : ℝ) : Periodic (fun t => H t r) (2 * Real.pi) := by\n    intro t\n    dsimp only [H]\n    rw [hgper t, hgpper t, hcper t, hvper t]\n  have hinnerper : Periodic (fun t => ∫ r in Icc (0 : ℝ) 1, H t r) (2 * Real.pi) := by\n    intro t\n    apply integral_congr_ae\n    filter_upwards [] with r\n    exact hHper r t\n  have heq := hinnerper.intervalIntegral_add_eq (-Real.pi) 0\n  rw [show -Real.pi + 2 * Real.pi = Real.pi by ring, zero_add,\n    intervalIntegral.integral_of_le (by linarith [Real.pi_pos]),\n    intervalIntegral.integral_of_le (by positivity)] at heq\n  rwa [← integral_Icc_eq_integral_Ioc, ← integral_Icc_eq_integral_Ioc] at heq\n\n)"))

/-- Radial and periodic angular integration by parts for the same gamma and scalar test. -/
theorem actual_cone_polar_parameter_green (R : ℝ) (Ω : SmoothFlatJordanDomain R)
    (psi : E2 → ℝ) (smooth_test : ContDiff ℝ ∞ psi) (i j : Fin 2) :
    (∫ t in Icc 0 (2 * Real.pi), ∫ r in Icc (0 : ℝ) 1,
      r * (r * Ω.boundary.gamma t i *
        fderiv ℝ psi (r • unitCircleParameter t) (coordinateVector 2 j) +
        (Ω.boundary.gamma t i * unitCircleParameter t j +
          deriv Ω.boundary.gamma t i *
            ((EuclideanSpace.equiv (Fin 2) ℝ).symm
              ![-unitCircleParameter t 1, unitCircleParameter t 0]) j) *
          psi (r • unitCircleParameter t))) =
    ∫ t in Icc 0 (2 * Real.pi), liftedBoundaryValue Ω (fun t => t) t i *
      psi (unitCircleParameter t) * unitCircleParameter t j := by run_tac do Lean.Elab.Tactic.evalTactic (← Lean.ofExcept (Lean.Parser.runParserCategory (← Lean.getEnv) `tactic "exact (by\n  set_option backward.isDefEq.respectTransparency false in\n    classical\n    let c : ℝ → E2 := unitCircleParameter\n    let v : ℝ → E2 := fun t => (EuclideanSpace.equiv (Fin 2) ℝ).symm ![-Real.sin t, Real.cos t]\n    let g : ℝ → ℝ := fun t => Ω.boundary.gamma t i\n    let gp : ℝ → ℝ := fun t => deriv Ω.boundary.gamma t i\n    let p : ℝ → ℝ → E2 := fun t r => r • c t\n    let A : ℝ → ℝ → ℝ := fun t r =>\n      2 * r * g t * c t j * psi (p t r) +\n        r ^ 2 * g t * c t j * fderiv ℝ psi (p t r) (c t)\n    let B : ℝ → ℝ → ℝ := fun t r =>\n      r * gp t * v t j * psi (p t r) - r * g t * c t j * psi (p t r) +\n        r ^ 2 * g t * v t j * fderiv ℝ psi (p t r) (v t)\n    have hc : Continuous c := by\n      apply (EuclideanSpace.equiv (Fin 2) ℝ).symm.continuous.comp\n      exact continuous_pi fun k : Fin 2 => by fin_cases k <;> simp <;> fun_prop\n    have hv : Continuous v := by\n      apply (EuclideanSpace.equiv (Fin 2) ℝ).symm.continuous.comp\n      exact continuous_pi fun k : Fin 2 => by fin_cases k <;> simp <;> fun_prop\n    have hg : Continuous g := (EuclideanSpace.proj (𝕜 := ℝ) i).continuous.comp Ω.boundary.smooth.continuous\n    have hgp : Continuous gp := (EuclideanSpace.proj (𝕜 := ℝ) i).continuous.comp\n      (Ω.boundary.smooth.continuous_deriv (by simp))\n    have hcd (t : ℝ) : HasDerivAt c (v t) t := by\n      have hh : HasDerivAt (fun t : ℝ => ![Real.cos t, Real.sin t]) ![-Real.sin t, Real.cos t] t := by\n        apply hasDerivAt_pi.mpr\n        intro k\n        fin_cases k\n        · simpa using Real.hasDerivAt_cos t\n        · simpa using Real.hasDerivAt_sin t\n      exact ((EuclideanSpace.equiv (Fin 2) ℝ).symm.toContinuousLinearMap.hasFDerivAt).comp_hasDerivAt t hh\n    have hvd (t : ℝ) : HasDerivAt v (-c t) t := by\n      have hh : HasDerivAt (fun t : ℝ => ![-Real.sin t, Real.cos t]) ![-Real.cos t, -Real.sin t] t := by\n        apply hasDerivAt_pi.mpr\n        intro k\n        fin_cases k\n        · convert (Real.hasDerivAt_sin t).neg using 1 <;> rfl\n        · simpa using Real.hasDerivAt_cos t\n      have he := ((EuclideanSpace.equiv (Fin 2) ℝ).symm.toContinuousLinearMap.hasFDerivAt).comp_hasDerivAt t hh\n      have hvneg : (EuclideanSpace.equiv (Fin 2) ℝ).symm ![-Real.cos t, -Real.sin t] = -c t := by\n        ext k\n        fin_cases k <;> rfl\n      convert he using 1\n      · funext u\n        rfl\n      · exact hvneg.symm\n    have hgd (t : ℝ) : HasDerivAt g (gp t) t := by\n      exact ((EuclideanSpace.proj (𝕜 := ℝ) i).hasFDerivAt).comp_hasDerivAt t\n        ((Ω.boundary.smooth.differentiable (by simp) t).hasDerivAt)\n    have hpsir (t r : ℝ) : HasDerivAt (fun r => psi (p t r))\n        (fderiv ℝ psi (p t r) (c t)) r := by\n      have hpr : HasDerivAt (fun r : ℝ => r • c t) (c t) r := by\n        simpa only [one_smul, id_eq] using (hasDerivAt_id r).smul_const (c t)\n      exact ((smooth_test.differentiable (by simp) (p t r)).hasFDerivAt).comp_hasDerivAt r hpr\n    have hpsit (t r : ℝ) : HasDerivAt (fun t => psi (p t r))\n        (r * fderiv ℝ psi (p t r) (v t)) t := by\n      have ht := ((smooth_test.differentiable (by simp) (p t r)).hasFDerivAt).comp_hasDerivAt t\n        ((hcd t).const_smul r)\n      convert ht using 1\n      · funext u\n        rfl\n      · rw [ContinuousLinearMap.map_smul]\n        rfl\n    have hAr (t r : ℝ) : HasDerivAt\n        (fun r => r ^ 2 * g t * c t j * psi (p t r)) (A t r) r := by\n      have hh := (((hasDerivAt_id r).pow 2).mul_const (g t)).mul_const (c t j) |>.mul (hpsir t r)\n      convert hh using 1\n      · rfl\n      · dsimp only [A, id_eq, Pi.mul_apply, Pi.pow_apply]\n        ring\n    have hBt (t r : ℝ) : HasDerivAt\n        (fun t => r * g t * v t j * psi (p t r)) (B t r) t := by\n      have hj : HasDerivAt (fun t => v t j) (-c t j) t := by\n        exact ((EuclideanSpace.proj (𝕜 := ℝ) j).hasFDerivAt).comp_hasDerivAt t (hvd t)\n      have hh := (((hgd t).const_mul r).mul hj).mul (hpsit t r)\n      convert hh using 1\n      · dsimp only [B, Pi.mul_apply]\n        ring\n    have hp : Continuous (fun z : ℝ × ℝ => p z.1 z.2) := continuous_snd.smul (hc.comp continuous_fst)\n    have hcj : Continuous (fun z : ℝ × ℝ => c z.1 j) :=\n      (EuclideanSpace.proj (𝕜 := ℝ) j).continuous.comp (hc.comp continuous_fst)\n    have hvj : Continuous (fun z : ℝ × ℝ => v z.1 j) :=\n      (EuclideanSpace.proj (𝕜 := ℝ) j).continuous.comp (hv.comp continuous_fst)\n    have hD : Continuous (fderiv ℝ psi) := smooth_test.continuous_fderiv (by simp)\n    have hAc : Continuous (uncurry A) := by\n      exact (((((continuous_const.mul continuous_snd).mul (hg.comp continuous_fst)).mul hcj).mul\n        (smooth_test.continuous.comp hp)).add\n        ((((continuous_snd.pow 2).mul (hg.comp continuous_fst)).mul hcj).mul\n          ((hD.comp hp).clm_apply (hc.comp continuous_fst))))\n    have hBc : Continuous (uncurry B) := by\n      exact (((((continuous_snd.mul (hgp.comp continuous_fst)).mul hvj).mul\n        (smooth_test.continuous.comp hp)).sub\n        (((continuous_snd.mul (hg.comp continuous_fst)).mul hcj).mul (smooth_test.continuous.comp hp))).add\n        ((((continuous_snd.pow 2).mul (hg.comp continuous_fst)).mul hvj).mul\n          ((hD.comp hp).clm_apply (hv.comp continuous_fst))))\n    have hAi : Integrable (uncurry A)\n        ((volume.restrict (Icc 0 (2 * Real.pi))).prod (volume.restrict (Icc (0 : ℝ) 1))) := by\n      rw [Measure.prod_restrict]\n      exact (hAc.continuousOn).integrableOn_compact (isCompact_Icc.prod isCompact_Icc)\n    have hBi : Integrable (uncurry B)\n        ((volume.restrict (Icc 0 (2 * Real.pi))).prod (volume.restrict (Icc (0 : ℝ) 1))) := by\n      rw [Measure.prod_restrict]\n      exact (hBc.continuousOn).integrableOn_compact (isCompact_Icc.prod isCompact_Icc)\n    have hradial (t : ℝ) : (∫ r in Icc (0 : ℝ) 1, A t r) = g t * c t j * psi (c t)