/-- Exact remaining actual polar-cone Green identity; all formulae are local and upstream-only. -/
theorem actual_cone_polar_green_identity (R : ℝ) (Ω : SmoothFlatJordanDomain R) :
  let angle : E2 → ℝ := fun z => Complex.arg ((z 0 : ℂ) + (z 1 : ℂ) * Complex.I)
  let cone : E2 → E2 := fun z => ‖z‖ • Ω.boundary.gamma (angle z)
  let jets : Fin 2 → E2 → E2 := fun i z =>
    if z = 0 then 0 else
      (Ω.boundary.gamma (angle z) i / ‖z‖) • z +
      (deriv Ω.boundary.gamma (angle z) i / ‖z‖) •
        (EuclideanSpace.equiv (Fin 2) ℝ).symm ![-z 1, z 0]
  ∀ psi : E2 → ℝ, ContDiff ℝ ∞ psi → ∀ i j : Fin 2,
      (∫ x in disc 1, cone x i * fderiv ℝ psi x (coordinateVector 2 j) +
        jets i x j * psi x) =
      ∫ t in Icc 0 (2 * Real.pi), liftedBoundaryValue Ω (fun t => t) t i *
        psi (unitCircleParameter t) * unitCircleParameter t j := by run_tac do Lean.Elab.Tactic.evalTactic (← Lean.ofExcept (Lean.Parser.runParserCategory (← Lean.getEnv) `tactic "exact (by\n  dsimp only\n  intro psi smooth_test i j\n  exact (actual_cone_polar_disc_integral R Ω psi smooth_test i j).trans\n    (actual_cone_polar_parameter_green R Ω psi smooth_test i j)\n)"))

