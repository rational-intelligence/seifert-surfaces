/-- Literal quarter turn; no global angle lift is chosen. -/
def quarterTurn (w : Euc 2) : Euc 2 := !₂[-w 1, w 0]
def fiberFrame (v : Circle → Circle) (z : Circle) (s y : ℝ) : Euc 2 :=
  s • unitVector (v z) + y • quarterTurn (unitVector (v z))
def frameFirst (v : Circle → Circle) (z : Circle) (w : Euc 2) : ℝ :=
  inner ℝ w (unitVector (v z))
def frameSecond (v : Circle → Circle) (z : Circle) (w : Euc 2) : ℝ :=
  inner ℝ w (quarterTurn (unitVector (v z)))

theorem quarter_turn_frame_equivalence :
    (∃ J : Euc 2 ≃L[ℝ] Euc 2, (∀ w, J w = quarterTurn w) ∧
      (∀ w, J.symm w = !₂[w 1, -w 0])) ∧
    ∀ (v : Circle → Circle) z s y,
      frameFirst v z (fiberFrame v z s y) = s ∧
      frameSecond v z (fiberFrame v z s y) = y ∧
      ∀ w, fiberFrame v z (frameFirst v z w) (frameSecond v z w) = w  := by
