structure SmoothHeightGerm (h : Circle × ℝ → ℝ) (a : ℝ) : Prop where
  radius_pos : 0 < a
  smooth : ContMDiffOn ((𝓡 1).prod 𝓘(ℝ, ℝ)) 𝓘(ℝ, ℝ) ∞ h {p | |p.2| < a}
  zero : ∀ z, h (z, 0) = 0
  first_jet : ∀ z, deriv (fun s => h (z, s)) 0 = 0

structure SupportedFiberShear (v : Circle → Circle) (h : Circle × ℝ → ℝ) (a : ℝ) where
  a₀ : ℝ
  a₁ : ℝ
  b₀ : ℝ
  b₁ : ℝ
  a₀_pos : 0 < a₀
  a₀_lt : a₀ < a₁
  b₀_pos : 0 < b₀
  b₀_lt : b₀ < b₁
  rectangle_in_disk : a₁ ^ 2 + b₁ ^ 2 < 4
  a₁_lt_germ : a₁ < a
  chi : ℝ → ℝ
  eta : ℝ → ℝ
  chi_smooth : ContDiff ℝ ∞ chi
  eta_smooth : ContDiff ℝ ∞ eta
  chi_one : ∀ s, |s| ≤ a₀ → chi s = 1
  chi_support : Function.support chi ⊆ Ioo (-a₁) a₁
  eta_one : ∀ y, |y| ≤ b₀ → eta y = 1
  eta_support : Function.support eta ⊆ Ioo (-b₁) b₁
  chi_range : ∀ s, chi s ∈ Icc (0 : ℝ) 1
  eta_range : ∀ y, eta y ∈ Icc (0 : ℝ) 1
  height_small : ∀ z s, 0 ≤ s → s ≤ a₀ → |h (z, s)| < b₀
  derivative_bound : ∀ z s y, |chi s * deriv eta y * h (z, s)| < 1 / 2
  fiber_derivative_positive : ∀ z s y,
    1 / 2 < deriv (fun r => r - chi s * eta r * h (z, s)) y
  plane : Diffeomorph ((𝓡 1).prod 𝓘(ℝ, Euc 2))
    ((𝓡 1).prod 𝓘(ℝ, Euc 2)) (Circle × Euc 2) (Circle × Euc 2) ∞
  plane_formula : ∀ z s y,
    plane (z, fiberFrame v z s y) =
      (z, fiberFrame v z s (y - chi s * eta y * h (z, s)))
  plane_inverse_smooth : ContMDiff ((𝓡 1).prod 𝓘(ℝ, Euc 2))
    ((𝓡 1).prod 𝓘(ℝ, Euc 2)) ∞ plane.symm
  disk_preserved : ∀ p : Circle × Euc 2, (plane p).2 ∈ tubeDiskOpen ↔ p.2 ∈ tubeDiskOpen
  tube : Diffeomorph TubeModel TubeModel TubeDomain TubeDomain ∞
  tube_formula : ∀ p, (tube p).1 = (plane (p.1, (p.2 : Euc 2))).1 ∧
    ((tube p).2 : Euc 2) = (plane (p.1, (p.2 : Euc 2))).2
  core_fixed : ∀ z (w : TubeDisk), (w : Euc 2) = 0 → tube (z, w) = (z, w)
  compact_support : ∃ S : Set TubeDomain, IsCompact S ∧
    (∀ p ∈ S, |frameFirst v p.1 p.2| ≤ a₁ ∧ |frameSecond v p.1 p.2| ≤ b₁) ∧
    (∀ p ∉ S, tube p = p)
  flatten : ∀ z s (_hs : 0 ≤ s) (_hsa : s ≤ a₀) (w : TubeDisk),
    (w : Euc 2) = fiberFrame v z s (h (z, s)) →
      (tube (z, w)).1 = z ∧ ((tube (z, w)).2 : Euc 2) = s • unitVector (v z)


structure TubeSupport (Psi : Diffeomorph TubeModel TubeModel TubeDomain TubeDomain ∞) where
  radius : ℝ
  radius_pos : 0 < radius
  radius_lt : radius < 2
  compact : Set TubeDomain
  isCompact : IsCompact compact
  contained : ∀ p ∈ compact, ‖(p.2 : Euc 2)‖ < radius
  outside : ∀ p ∉ compact, Psi p = p
  core : ∀ z (w : TubeDisk), (w : Euc 2) = 0 → Psi (z, w) = (z, w)

structure SphereTubeExtension {K : OrientedKnot} (T : TubularNeighborhood K)
    (D : TubeCoordinates T) (Psi : Diffeomorph TubeModel TubeModel TubeDomain TubeDomain ∞) where
  ambient : Diffeomorph (𝓡 3) (𝓡 3) ThreeSphere ThreeSphere ∞
  inside : ∀ p, ambient (T.tube 0 p) = T.tube 0 (Psi p)
  inverse_inside : ∀ p, ambient.symm (T.tube 0 p) = T.tube 0 (Psi.symm p)
  outside : ∀ x ∉ Set.range (T.tube 0), ambient x = x
  core : ∀ z, ambient (K.component 0 z) = K.component 0 z
  identity_near_outside : ∀ x ∉ Set.range (T.tube 0),
    ∃ U : Set ThreeSphere, IsOpen U ∧ x ∈ U ∧ EqOn ambient id U ∧ EqOn ambient.symm id U

theorem supported_shear_tube_support (v : Circle → Circle) (h : Circle × ℝ → ℝ) (a : ℝ)
    (P : SupportedFiberShear v h a) : Nonempty (TubeSupport P.tube) := by
  obtain ⟨S, hS, hSb, hSid⟩ := P.compact_support
  let r := Real.sqrt (P.a₁ ^ 2 + P.b₁ ^ 2)
  have hr0 : 0 ≤ r := Real.sqrt_nonneg _
  have hrsq : r ^ 2 = P.a₁ ^ 2 + P.b₁ ^ 2 :=
    Real.sq_sqrt (add_nonneg (sq_nonneg _) (sq_nonneg _))
  have hr2 : r < 2 := by nlinarith [P.rectangle_in_disk]
  have ha1 : 0 < P.a₁ := P.a₀_pos.trans P.a₀_lt
  have hb1 : 0 < P.b₁ := P.b₀_pos.trans P.b₀_lt
  refine ⟨{ radius := (r + 2) / 2
            radius_pos := by linarith
            radius_lt := by linarith
            compact := S
            isCompact := hS
            contained := ?_
            outside := hSid
            core := P.core_fixed }⟩
  intro p hp
  obtain ⟨hs, ht⟩ := hSb p hp
  have hs2 : (frameFirst v p.1 p.2) ^ 2 ≤ P.a₁ ^ 2 := by
    nlinarith [sq_abs (frameFirst v p.1 p.2), abs_nonneg (frameFirst v p.1 p.2)]
  have ht2 : (frameSecond v p.1 p.2) ^ 2 ≤ P.b₁ ^ 2 := by
    nlinarith [sq_abs (frameSecond v p.1 p.2), abs_nonneg (frameSecond v p.1 p.2)]
  have hunit : (unitVector (v p.1) 0) ^ 2 + (unitVector (v p.1) 1) ^ 2 = 1 := by
    have hn := real_inner_self_eq_norm_sq (unitVector (v p.1))
    rw [unitVector_norm] at hn
    simpa only [PiLp.inner_apply, Fin.sum_univ_two, RCLike.inner_apply,
      conj_trivial, one_pow, pow_two, one_mul] using hn
  have hnorm : ‖(p.2 : Euc 2)‖ ^ 2 =
      (frameFirst v p.1 p.2) ^ 2 + (frameSecond v p.1 p.2) ^ 2 := by
    rw [EuclideanSpace.real_norm_sq_eq]
    simp [frameFirst, frameSecond, quarterTurn, PiLp.inner_apply, Fin.sum_univ_two]
    linear_combination -((p.2 : Euc 2) 0 ^ 2 + (p.2 : Euc 2) 1 ^ 2) * hunit
  have hle : ‖(p.2 : Euc 2)‖ ≤ r := by
    nlinarith [norm_nonneg (p.2 : Euc 2)]
  linarith

end
