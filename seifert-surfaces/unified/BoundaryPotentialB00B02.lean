theorem B01_fixed_radial_cutoff (r : ℝ) (radius_positive : 0 < r)
    (gamma : ℝ≥0) (gamma_positive : 0 < gamma) (gamma_lt_one : gamma < 1) :
    ∃ chi : E2 → ℝ, ∃ D : ℝ, ∃ Cchi Cgrad : ℝ≥0,
      ContDiff ℝ ∞ chi ∧ HasCompactSupport chi ∧
      tsupport chi ⊆ disc (2 * r / 3) ∧
      (∀ y ∈ closedDisc (r / 2), chi y = 1) ∧
      (∀ y, 0 ≤ chi y ∧ chi y ≤ 1) ∧
      (∀ y z, ‖y‖ = ‖z‖ → chi y = chi z) ∧
      0 ≤ D ∧ (∀ y, ‖fderiv ℝ chi y‖ ≤ D ∧ ‖planarGradient chi y‖ ≤ D) ∧
      HolderWith Cchi gamma chi ∧ HolderWith Cgrad gamma (planarGradient chi) := by run_tac do modifyThe Lean.Core.State (fun s => { s with nextMacroScope := 257 }); Lean.Elab.Tactic.evalTactic (← Lean.ofExcept (Lean.Parser.runParserCategory (← Lean.getEnv) `tactic "exact (by\n  let b := ContDiffBumpBase.ofInnerProductSpace E2\n  let rin : ℝ := r / 2\n  let rout : ℝ := 7 * r / 12\n  have hri : 0 < rin := by dsimp [rin]; linarith\n  have hio : rin < rout := by dsimp [rin, rout]; linarith\n  have hR : 1 < rout / rin := (one_lt_div hri).2 hio\n  let chi : E2 → ℝ := fun x => b.toFun (rout / rin) (rin⁻¹ • x)\n  have hsm : ContDiff ℝ ∞ chi := by\n    exact b.smooth.comp_contDiff\n      (contDiff_const.prodMk (contDiff_id.const_smul _)) (fun x => ⟨hR, mem_univ _⟩)\n  have hts : tsupport chi = Metric.closedBall 0 rout := by\n    have hs : Function.support chi = Metric.ball 0 rout := by\n      ext x\n      change (rin⁻¹ • x ∈ Function.support (b.toFun (rout / rin))) ↔ _\n      rw [b.support _ hR]\n      change dist (rin⁻¹ • x) 0 < rout / rin ↔ dist x 0 < rout\n      simp only [dist_zero_right, norm_smul, Real.norm_eq_abs,\n        abs_inv, abs_of_pos hri]\n      rw [← div_eq_inv_mul]\n      exact div_lt_div_iff_of_pos_right hri\n    rw [tsupport, hs, closure_ball _ (by dsimp [rout]; linarith : rout ≠ 0)]\n  have hcomp : HasCompactSupport chi := by\n    rw [HasCompactSupport, hts]\n    exact isCompact_closedBall _ _\n  have hgsm : ContDiff ℝ ∞ (planarGradient chi) := by\n    unfold planarGradient\n    apply ContDiff.sum\n    intro i hi\n    exact ((hsm.fderiv_right (by simp)).clm_apply contDiff_const).smul contDiff_const\n  have hgcomp : HasCompactSupport (planarGradient chi) := by\n    apply hcomp.mono'\n    intro x hx\n    by_contra hn\n    have hd : fderiv ℝ chi x = 0 := fderiv_of_notMem_tsupport ℝ hn\n    have hz : planarGradient chi x = 0 := by\n      unfold planarGradient\n      rw [hd]\n      simp only [zero_apply, zero_smul, Finset.sum_const_zero]\n    exact hx hz\n  have holder_of : ∀ (F : Type) [NormedAddCommGroup F] [NormedSpace ℝ F]\n      (f : E2 → F), ContDiff ℝ ∞ f → HasCompactSupport f →\n      ∃ C : ℝ≥0, HolderWith C gamma f := by\n    intro F _ _ f hf hc\n    obtain ⟨L, hL⟩ := hf.lipschitzWith_of_hasCompactSupport hc (by simp)\n    obtain ⟨M, hM⟩ := hc.exists_bound_of_continuous hf.continuous\n    let A : ℝ≥0 := ⟨2 * max M 0, by positivity⟩\n    have h0 : HolderWith A 0 f := by\n      intro x y\n      simp only [NNReal.coe_zero, ENNReal.rpow_zero, mul_one, edist_dist]\n      apply ENNReal.ofReal_le_coe.2\n      change dist (f x) (f y) ≤ 2 * max M 0\n      calc\n        dist (f x) (f y) = ‖f x - f y‖ := dist_eq_norm _ _\n        _ ≤ ‖f x‖ + ‖f y‖ := norm_sub_le _ _\n        _ ≤ 2 * max M 0 := by linarith [hM x, hM y, le_max_left M 0]\n    exact ⟨max A L, h0.of_le_of_le hL.holderWith (by positivity) gamma_lt_one.le⟩\n  obtain ⟨Cchi, hCchi⟩ := holder_of ℝ chi hsm hcomp\n  obtain ⟨Cgrad, hCgrad⟩ := holder_of E2 (planarGradient chi) hgsm hgcomp\n  obtain ⟨Md, hMd⟩ := (hcomp.fderiv ℝ).exists_bound_of_continuous\n    (hsm.continuous_fderiv (by simp))\n  obtain ⟨Mg, hMg⟩ := hgcomp.exists_bound_of_continuous hgsm.continuous\n  refine ⟨chi, max 0 (max Md Mg), Cchi, Cgrad, hsm, hcomp, ?_, ?_, ?_, ?_,\n    le_max_left _ _, ?_, hCchi, hCgrad⟩\n  · rw [hts]\n    intro x hx\n    change dist x 0 < 2 * r / 3\n    have hb := Metric.mem_closedBall.1 hx\n    dsimp [rout] at hb\n    linarith\n  · intro x hx\n    apply b.eq_one _ hR\n    rw [norm_smul, Real.norm_eq_abs, abs_inv, abs_of_pos hri, ← div_eq_inv_mul]\n    exact (div_le_one hri).2 (by simpa only [dist_zero_right] using Metric.mem_closedBall.1 hx)\n  · intro x\n    exact b.mem_Icc _ _\n  · intro x y hxy\n    dsimp [chi, b, ContDiffBumpBase.ofInnerProductSpace]\n    rw [norm_smul, norm_smul, hxy]\n  · intro x\n    exact ⟨(hMd x).trans ((le_max_left Md Mg).trans (le_max_right 0 _)),\n      (hMg x).trans ((le_max_right Md Mg).trans (le_max_right 0 _))⟩\n)"))

theorem B02_constant_antisymmetric_cancellation
    (K : Mat2) (antisymmetric : K.transpose = -K)
    (U : Set E2) (U_open : IsOpen U)
    (u : E2 → ℝ) (du : E2 → E2) (phi : E2 → ℝ) (dphi : E2 → E2)
    (u_H1 : H1On U u du) (phi_H10 : H10On U phi dphi) :
    IntegrableOn (fun y => inner ℝ (matrixAction K (du y)) (dphi y)) U ∧
      (∫ y in U, inner ℝ (matrixAction K (du y)) (dphi y)) = 0 := by run_tac do Lean.Elab.Tactic.evalTactic (← Lean.ofExcept (Lean.Parser.runParserCategory (← Lean.getEnv) `tactic "set_option maxHeartbeats 0 in\nset_option maxRecDepth 4000 in\nexact (by\n  classical\n  have operatorLp (U : Set E2) (K : Mat2) (f : E2 → E2) (hf : MemLp f 2 (volume.restrict U)) :\n      MemLp (fun y => matrixAction K (f y)) 2 (volume.restrict U) := by\n    apply memLp_piLp_iff.mpr\n    intro i\n    have ht (j : Fin 2) : MemLp (fun y => K i j * f y j) 2 (volume.restrict U) :=\n      (memLp_piLp_iff.mp hf j).const_mul (K i j)\n    convert (ht 0).add (ht 1) using 1\n    funext y\n    dsimp only [matrixAction]\n    simp only [Fin.sum_univ_two]\n    rfl\n  have skewAlgebra (K : Mat2) (hk : K.transpose = -K) (d g : E2) :\n      inner ℝ (matrixAction K d) g = K 0 1 * (d 1 * g 0 - d 0 * g 1) := by\n    have h00 : K 0 0 = 0 := by\n      have h := congrFun (congrFun hk 0) 0\n      change K 0 0 = -K 0 0 at h\n      linarith\n    have h11 : K 1 1 = 0 := by\n      have h := congrFun (congrFun hk 1) 1\n      change K 1 1 = -K 1 1 at h\n      linarith\n    have h10 : K 1 0 = -K 0 1 := by\n      have h := congrFun (congrFun hk 0) 1\n      exact h\n    simp only [PiLp.inner_apply,Fin.sum_univ_two,RCLike.inner_apply,conj_trivial]\n    dsimp only [matrixAction]\n    simp only [Fin.sum_univ_two]\n    change g 0 * (K 0 0 * d 0 + K 0 1 * d 1) +\n      g 1 * (K 1 0 * d 0 + K 1 1 * d 1) = _\n    rw [h00,h11,h10]\n    ring\n  have mixedPartial (psi : E2 → ℝ) (hs : ContDiff ℝ ∞ psi) (y : E2) :\n      fderiv ℝ (fun z => fderiv ℝ psi z (coordinateVector 2 1)) y (coordinateVector 2 0) =\n      fderiv ℝ (fun z => fderiv ℝ psi z (coordinateVector 2 0)) y (coordinateVector 2 1) := by\n    have hd : ContDiff ℝ ∞ (fderiv ℝ psi) := hs.fderiv_right (by simp)\n    rw [fderiv_clm_apply (hd.differentiable (by simp) y) (differentiableAt_const _),\n      fderiv_clm_apply (hd.differentiable (by simp) y) (differentiableAt_const _)]\n    rw [fderiv_const_apply,fderiv_const_apply]\n    simp only [ContinuousLinearMap.comp_zero,zero_add,ContinuousLinearMap.flip_apply]\n    exact hs.contDiffAt.isSymmSndFDerivAt (by simp) _ _\n  have partialTest (psi : E2 → ℝ) (hs : ContDiff ℝ ∞ psi) (hc : HasCompactSupport psi)\n      (U : Set E2) (hu : tsupport psi ⊆ U) (i : Fin 2) :\n      ContDiff ℝ ∞ (fun z => fderiv ℝ psi z (coordinateVector 2 i)) ∧\n      HasCompactSupport (fun z => fderiv ℝ psi z (coordinateVector 2 i)) ∧\n      tsupport (fun z => fderiv ℝ psi z (coordinateVector 2 i)) ⊆ U := by\n    have hd : ContDiff ℝ ∞ (fderiv ℝ psi) := hs.fderiv_right (by simp)\n    exact ⟨hd.clm_apply contDiff_const,hc.fderiv_apply (𝕜 := ℝ) _,(tsupport_fderiv_apply_subset ℝ _).trans hu⟩\n  have gradCoord (psi : E2 → ℝ) (y : E2) (i : Fin 2) :\n      planarGradient psi y i = fderiv ℝ psi y (coordinateVector 2 i) := by\n    fin_cases i <;> dsimp only [planarGradient,coordinateVector] <;>\n      simp [Fin.sum_univ_two,EuclideanSpace.single]\n  have smoothLp (U : Set E2) (psi : E2 → ℝ) (hs : ContDiff ℝ ∞ psi) (hc : HasCompactSupport psi) :\n      MemLp psi 2 (volume.restrict U) ∧ MemLp (planarGradient psi) 2 (volume.restrict U) := by\n    have hgc : HasCompactSupport (planarGradient psi) := by\n      apply hc.mono'\n      intro y hy\n      by_contra hn\n      exact hy (planarGradient_eq_zero_off_support psi hn)\n    exact ⟨(hs.continuous.memLp_of_hasCompactSupport (μ := volume) hc).restrict U,\n      ((continuous_planarGradient hs).memLp_of_hasCompactSupport (μ := volume) hgc).restrict U⟩\n  have pairingInt (U : Set E2) (f g : E2 → E2)\n      (hf : MemLp f 2 (volume.restrict U)) (hg : MemLp g 2 (volume.restrict U)) :\n      IntegrableOn (fun y => inner ℝ (f y) (g y)) U := by\n    change Integrable (fun y => inner ℝ (f y) (g y)) (volume.restrict U)\n    have ht (i : Fin 2) : Integrable (fun y => f y i * g y i) (volume.restrict U) :=\n      (memLp_piLp_iff.mp hf i).integrable_mul (memLp_piLp_iff.mp hg i)\n    convert (ht 0).add (ht 1) using 1\n    funext y\n    change inner ℝ (f y) (g y) = f y 0 * g y 0 + f y 1 * g y 1\n    simp only [PiLp.inner_apply, Fin.sum_univ_two, RCLike.inner_apply, conj_trivial]\n    ring\n  have testExtension (U : Set E2)\n      (P : E2 → E2) (Q : E2 → ℝ)\n      (hP : MemLp P 2 (volume.restrict U)) (hQ : MemLp Q 2 (volume.restrict U))\n      (htest : ∀ (psi : E2 → ℝ), ContDiff ℝ ∞ psi → HasCompactSupport psi → tsupport psi ⊆ U →\n        (∫ y in U, inner ℝ (P y) (planarGradient psi y)) = ∫ y in U, Q y * psi y)\n      (phi : E2 → ℝ) (dphi : E2 → E2) (hphi : H10On U phi dphi) :\n      (∫ y in U, inner ℝ (P y) (dphi y)) = ∫ y in U, Q y * phi y := by\n    let mu := volume.restrict U\n    have pair (E : Type) [NormedAddCommGroup E] [InnerProductSpace ℝ E]\n        (f g : E2 → E) (hf : MemLp f 2 mu) (hg : MemLp g 2 mu) :\n        (∫ y, inner ℝ (f y) (g y) ∂mu) = inner ℝ (hf.toLp f) (hg.toLp g) := by\n      rw [MeasureTheory.L2.inner_def]\n      apply integral_congr_ae\n      filter_upwards [hf.coeFn_toLp,hg.coeFn_toLp] with y hfy hgy\n      rw [hfy,hgy]\n    have nsq (E : Type) [NormedAddCommGroup E] [InnerProductSpace ℝ E]\n        (f : E2 → E) (hf : MemLp f 2 mu) :\n        ‖hf.toLp f‖ ^ 2 = ∫ y, ‖f y‖ ^ 2 ∂mu := by\n      rw [← real_inner_self_eq_norm_sq, MeasureTheory.L2.inner_def]\n      apply integral_congr_ae\n      filter_upwards [hf.coeFn_toLp] with y hy\n      rw [hy,real_inner_self_eq_norm_sq]\n    have smoothLp (psi : E2 → ℝ) (hs : ContDiff ℝ ∞ psi) (hc : HasCompactSupport psi) :\n        MemLp psi 2 mu ∧ MemLp (planarGradient psi) 2 mu := by\n      have hgc : HasCompactSupport (planarGradient psi) := by\n        apply hc.mono'\n        intro y hy\n        by_contra hn\n        exact hy (planarGradient_eq_zero_off_support psi hn)\n      exact ⟨(hs.continuous.memLp_of_hasCompactSupport (μ := volume) hc).restrict U,\n        ((continuous_planarGradient hs).memLp_of_hasCompactSupport (μ := volume) hgc).restrict U⟩\n    have hp : MemLp phi 2 mu := hphi.1.2.1\n    have hd : MemLp dphi 2 mu := hphi.1.2.2\n    let I : ℝ := inner ℝ (hP.toLp P) (hd.toLp dphi) - inner ℝ (hQ.toLp Q) (hp.toLp phi)\n    have hI : I = 0 := by\n      by_contra hn\n      have hIpos : 0 < |I| := abs_pos.mpr hn\n      let C : ℝ := ‖hP.toLp P‖ + ‖hQ.toLp Q‖ + 1\n      have hC : 0 < C := by dsimp [C]; positivity\n      let delta : ℝ := |I| / (2 * C)\n      have hdelta : 0 < delta := div_pos hIpos (by positivity)\n      obtain ⟨psi,hs,hc,hu,he⟩ := hphi.2 (delta ^ 2) (sq_pos_of_pos hdelta)\n      obtain ⟨hps,hgs⟩ := smoothLp psi hs hc\n      have hsmallv : ‖hp.toLp phi - hps.toLp psi‖ ^ 2 = ∫ y, |phi y - psi y| ^ 2 ∂mu := by\n        rw [← MemLp.toLp_sub hp hps]\n        simpa only [Pi.sub_apply,Real.norm_eq_abs] using nsq ℝ (phi - psi) (hp.sub hps)\n      have hsmalld : ‖hd.toLp dphi - hgs.toLp (planarGradient psi)‖ ^ 2 =\n          ∫ y, ‖dphi y - planarGradient psi y‖ ^ 2 ∂mu := by\n        rw [← MemLp.toLp_sub hd hgs]\n        exact nsq E2 (dphi - planarGradient psi) (hd.sub hgs)\n      have hvi : Integrable (fun y => |phi y - psi y| ^ 2) mu := by\n        convert (hp.sub hps).norm.integrable_mul (hp.sub hps).norm using 1\n        funext y\n        simp only [Pi.sub_apply,Real.norm_eq_abs,pow_two]\n        rfl\n      have hdi : Integrable (fun y => ‖dphi y - planarGradient psi y‖ ^ 2) mu := by\n        convert (hd.sub hgs).norm.integrable_mul (hd.sub hgs).norm using 1\n        funext y\n        simp only [Pi.sub_apply,pow_two]\n        rfl\n      have hsmall : ‖hp.toLp phi - hps.toLp psi‖ ^ 2 +\n          ‖hd.toLp dphi - hgs.toLp (planarGradient psi)‖ ^ 2 < delta ^ 2 := by\n        rw [hsmallv,hsmalld,← integral_add hvi hdi]\n        exact he\n      have hv : ‖hp.toLp phi - hps.toLp psi‖ < delta := by\n        nlinarith [sq_nonneg ‖hd.toLp dphi - hgs.toLp (planarGradient psi)‖,norm_nonneg (hp.toLp phi - hps.toLp psi)]\n      have hg : ‖hd.toLp dphi - hgs.toLp (planarGradient psi)‖ < delta := by\n        nlinarith [sq_nonneg ‖hp.toLp phi - hps.toLp psi‖,norm_nonneg (hd.toLp dphi - hgs.toLp (planarGradient psi))]\n      have hz : inner ℝ (hP.toLp P) (hgs.toLp (planarGradient psi)) -\n          inner ℝ (hQ.toLp Q) (hps.toLp psi) = 0 := by\n        rw [← pair E2 P (planarGradient psi) hP hgs,← pair ℝ Q psi hQ hps]\n        simpa only [RCLike.inner_apply,conj_trivial,mul_comm] using sub_eq_zero.mpr (htest psi hs hc hu)\n      have hdiff : I = inner ℝ (hP.toLp P) (hd.toLp dphi - hgs.toLp (planarGradient psi)) -\n          inner ℝ (hQ.toLp Q) (hp.toLp phi - hps.toLp psi) := by\n        rw [inner_sub_right,inner_sub_right]\n        dsimp only [I]\n        linarith\n      have hb : |I| ≤ (‖hP.toLp P‖ + ‖hQ.toLp Q‖) * delta := by\n        rw [hdiff,← Real.norm_eq_abs]\n        apply (norm_sub_le _ _).trans\n        apply (add_le_add (norm_inner_le_norm _ _) (norm_inner_le_norm _ _)).trans\n        nlinarith [norm_nonneg (hP.toLp P),norm_nonneg (hQ.toLp Q)]\n      have hdeltac : 2 * C * delta = |I| := by\n        dsimp only [delta]\n        field_simp\n      dsimp only [C] at hdeltac\n      nlinarith [norm_nonneg (hP.toLp P),norm_nonneg (hQ.toLp Q)]\n    dsimp only [I] at hI\n    rw [← pair E2 P dphi hP hd,← pair ℝ Q phi hQ hp] at hI\n    simpa only [I,RCLike.inner_apply,conj_trivial,mul_comm] using sub_eq_zero.mp hI\n  have hP : MemLp (fun y => matrixAction K (du y)) 2 (volume.restrict U) :=\n    operatorLp U K du u_H1.2.2\n  have hI : IntegrableOn (fun y => inner ℝ (matrixAction K (du y)) (dphi y)) U :=\n    pairingInt U _ dphi hP phi_H10.1.2.2\n  have smoothTest (psi : E2 → ℝ) (hs : ContDiff ℝ ∞ psi) (hc : HasCompactSupport psi)\n      (hu : tsupport psi ⊆ U) :\n      (∫ y in U, inner ℝ (matrixAction K (du y)) (planarGradient psi y)) = 0 := by\n    obtain ⟨_,hgp⟩ := smoothLp U psi hs hc\n    have h01 : IntegrableOn (fun y => du y 0 * planarGradient psi y 1) U :=\n      (memLp_piLp_iff.mp u_H1.2.2 0).integrable_mul (memLp_piLp_iff.mp hgp 1)\n    have h10 : IntegrableOn (fun y => du y 1 * planarGradient psi y 0) U :=\n      (memLp_piLp_iff.mp u_H1.2.2 1).integrable_mul (memLp_piLp_iff.mp hgp 0)\n    have hw (i j : Fin 2) := u_H1.1.2.2\n      (fun y => fderiv ℝ psi y (coordinateVector 2 j))\n      (partialTest psi hs hc U hu j).1 (partialTest psi hs hc U hu j).2.1\n      (partialTest psi hs hc U hu j).2.2 i\n    have hh : (∫ y in U, u y * fderiv ℝ (fun z => fderiv ℝ psi z (coordinateVector 2 1)) y (coordinateVector 2 0)) =\n        ∫ y in U, u y * fderiv ℝ (fun z => fderiv ℝ psi z (coordinateVector 2 0)) y (coordinateVector 2 1) := by\n      apply integral_congr_ae\n      filter_upwards with y\n      rw [mixedPartial psi hs y]\n    have heq : (∫ y in U, du y 1 * planarGradient psi y 0) =\n        ∫ y in U, du y 0 * planarGradient psi y 1 := by\n      have hg (i j : Fin 2) : (∫ y in U, du y i * planarGradient psi y j) =\n          ∫ y in U, du y i * fderiv ℝ psi y (coordinateVector 2 j) := by\n        apply integral_congr_ae\n        filter_upwards with y\n        rw [gradCoord psi y j]\n      rw [hg 1 0,hg 0 1]\n      have h0 := hw 0 1\n      have h1 := hw 1 0\n      linarith\n    calc\n      _ = ∫ y in U, K 0 1 * (du y 1 * planarGradient psi y 0 - du y 0 * planarGradient psi y 1) := by\n        apply integral_congr_ae\n        filter_upwards with y\n        exact skewAlgebra K antisymmetric _ _\n      _ = 0 := by rw [integral_const_mul,integral_sub h10 h01,heq,sub_self,mul_zero]\n  refine ⟨hI,?_⟩\n  have heq := testExtension U (fun y => matrixAction K (du y)) (fun _ => (0 : ℝ))\n    hP (MemLp.zero) (by\n      intro psi hs hc hu\n      simpa only [zero_mul,integral_zero] using smoothTest psi hs hc hu) phi dphi phi_H10\n  simpa only [zero_mul,integral_zero] using heq\n)"))

theorem B02_frozen_symmetric_operator
    (A0 : Mat2) (U : Set E2) (U_open : IsOpen U)
    (u : E2 → ℝ) (du : E2 → E2) (phi : E2 → ℝ) (dphi : E2 → E2)
    (u_H1 : H1On U u du) (phi_H10 : H10On U phi dphi) :
    IntegrableOn (fun y => inner ℝ (matrixAction A0 (du y)) (dphi y)) U ∧
    IntegrableOn (fun y => inner ℝ (matrixAction (symmetricPart A0) (du y)) (dphi y)) U ∧
      (∫ y in U, inner ℝ (matrixAction A0 (du y)) (dphi y)) =
        ∫ y in U, inner ℝ (matrixAction (symmetricPart A0) (du y)) (dphi y) := by run_tac do modifyThe Lean.Core.State (fun s => { s with nextMacroScope := 167 }); Lean.Elab.Tactic.evalTactic (← Lean.ofExcept (Lean.Parser.runParserCategory (← Lean.getEnv) `tactic "exact (by\n  classical\n  have hpair (A : Mat2) (i j : Fin 2) :\n      Integrable (fun y => (A i j * du y j) * dphi y i) (volume.restrict U) :=\n    ((u_H1.2.2.eval_piLp j).const_mul (A i j)).integrable_mul\n      (phi_H10.1.2.2.eval_piLp i)\n  have hexpand (A : Mat2) (y : E2) :\n      inner ℝ (matrixAction A (du y)) (dphi y) =\n        ∑ i : Fin 2, ∑ j : Fin 2, (A i j * du y j) * dphi y i := by\n    rw [PiLp.inner_apply]\n    change (∑ i : Fin 2, dphi y i * (∑ j : Fin 2, A i j * du y j)) = _\n    apply Finset.sum_congr rfl\n    intro i hi\n    rw [Finset.mul_sum]\n    apply Finset.sum_congr rfl\n    intro j hj\n    ring\n  have hint (A : Mat2) :\n      IntegrableOn (fun y => inner ℝ (matrixAction A (du y)) (dphi y)) U := by\n    have hs : Integrable (fun y => ∑ i : Fin 2, ∑ j : Fin 2,\n        (A i j * du y j) * dphi y i) (volume.restrict U) :=\n      integrable_finsetSum _ fun i _ => integrable_finsetSum _ fun j _ => hpair A i j\n    exact hs.congr (.of_forall fun y => (hexpand A y).symm)\n  let K : Mat2 := A0 - symmetricPart A0\n  have hK : K.transpose = -K := by\n    ext i j\n    change A0 j i - (1 / 2 : ℝ) * (A0 j i + A0 i j) =\n      -(A0 i j - (1 / 2 : ℝ) * (A0 i j + A0 j i))\n    ring\n  have heq (y : E2) :\n      inner ℝ (matrixAction A0 (du y)) (dphi y) -\n        inner ℝ (matrixAction (symmetricPart A0) (du y)) (dphi y) =\n      inner ℝ (matrixAction K (du y)) (dphi y) := by\n    rw [hexpand, hexpand, hexpand, ← Finset.sum_sub_distrib]\n    apply Finset.sum_congr rfl\n    intro i hi\n    rw [← Finset.sum_sub_distrib]\n    apply Finset.sum_congr rfl\n    intro j hj\n    change _ = ((A0 i j - symmetricPart A0 i j) * du y j) * dphi y i\n    ring\n  have htest (psi : E2 → ℝ) (hs : ContDiff ℝ ∞ psi)\n      (hc : HasCompactSupport psi) (ht : tsupport psi ⊆ U) :\n      (∫ y in U, inner ℝ (matrixAction K (du y)) (planarGradient psi y)) = 0 := by\n    let d (i : Fin 2) (x : E2) := fderiv ℝ psi x (coordinateVector 2 i)\n    have hds (i : Fin 2) : ContDiff ℝ ∞ (d i) :=\n      (hs.fderiv_right (by simp)).clm_apply contDiff_const\n    have hdc (i : Fin 2) : HasCompactSupport (d i) := hc.fderiv_apply ℝ _\n    have hdt (i : Fin 2) : tsupport (d i) ⊆ U := (tsupport_fderiv_apply_subset ℝ _).trans ht\n    have hdmem (i : Fin 2) : MemLp (d i) 2 (volume.restrict U) :=\n      ((hds i).continuous.memLp_of_hasCompactSupport (hdc i)).mono_measure Measure.restrict_le_self\n    have hderiv (i j : Fin 2) (x : E2) :\n        fderiv ℝ (d i) x (coordinateVector 2 j) =\n          fderiv ℝ (fderiv ℝ psi) x (coordinateVector 2 j) (coordinateVector 2 i) := by\n      dsimp only [d]\n      rw [fderiv_clm_apply ((hs.fderiv_right (m := ∞) (by simp)).differentiable (by simp) x)\n        (differentiableAt_const _)]\n      simp only [fderiv_fun_const, Pi.zero_apply, ContinuousLinearMap.comp_zero,\n        zero_add, ContinuousLinearMap.flip_apply]\n    have hsecond (x : E2) :\n        fderiv ℝ (d 1) x (coordinateVector 2 0) =\n          fderiv ℝ (d 0) x (coordinateVector 2 1) := by\n      rw [hderiv, hderiv]\n      exact (hs.contDiffAt.isSymmSndFDerivAt (by simp)).eq _ _\n    have hweak0 := u_H1.1.2.2 (d 1) (hds 1) (hdc 1) (hdt 1) 0\n    have hweak1 := u_H1.1.2.2 (d 0) (hds 0) (hdc 0) (hdt 0) 1\n    have hleft : (∫ x in U, u x * fderiv ℝ (d 1) x (coordinateVector 2 0)) =\n        ∫ x in U, u x * fderiv ℝ (d 0) x (coordinateVector 2 1) :=\n      integral_congr_ae (.of_forall fun x => congrArg (u x * ·) (hsecond x))\n    have hcross : (∫ x in U, du x 0 * d 1 x) = ∫ x in U, du x 1 * d 0 x := by\n      linarith [hweak0, hweak1, hleft]\n    have hentries (i j : Fin 2) : K j i = -K i j := congrFun (congrFun hK i) j\n    have h00 : K 0 0 = 0 := by linarith [hentries 0 0]\n    have h11 : K 1 1 = 0 := by linarith [hentries 1 1]\n    have h10 : K 1 0 = -K 0 1 := hentries 0 1\n    have hgrad (i : Fin 2) (x : E2) : planarGradient psi x i = d i x := by\n      fin_cases i <;> simp [planarGradient, coordinateVector, Fin.sum_univ_two, d]\n    have hpoint (x : E2) : inner ℝ (matrixAction K (du x)) (planarGradient psi x) =\n        K 0 1 * (du x 1 * d 0 x - du x 0 * d 1 x) := by\n      rw [PiLp.inner_apply, Fin.sum_univ_two]\n      change planarGradient psi x 0 * (∑ j : Fin 2, K 0 j * du x j) +\n        planarGradient psi x 1 * (∑ j : Fin 2, K 1 j * du x j) = _\n      rw [Fin.sum_univ_two, Fin.sum_univ_two, hgrad, hgrad, h00, h11, h10]\n      ring\n    have hi0 : Integrable (fun x => du x 0 * d 1 x) (volume.restrict U) :=\n      (u_H1.2.2.eval_piLp 0).integrable_mul (hdmem 1)\n    have hi1 : Integrable (fun x => du x 1 * d 0 x) (volume.restrict U) :=\n      (u_H1.2.2.eval_piLp 1).integrable_mul (hdmem 0)\n    rw [integral_congr_ae (.of_forall hpoint), integral_const_mul,\n      integral_sub hi1 hi0, hcross, sub_self, mul_zero]\n  let mu := volume.restrict U\n  have hmatrixMem (A : Mat2) : MemLp (fun y => matrixAction A (du y)) 2 mu := by\n    let L : E2 →ₗ[ℝ] E2 :=\n      { toFun := matrixAction A\n        map_add' := by\n          intro p q\n          ext i\n          change (∑ j : Fin 2, A i j * (p j + q j)) =\n            (∑ j : Fin 2, A i j * p j) + ∑ j : Fin 2, A i j * q j\n          rw [← Finset.sum_add_distrib]\n          apply Finset.sum_congr rfl\n          intro j hj\n          ring\n        map_smul' := by\n          intro c p\n          ext i\n          change (∑ j : Fin 2, A i j * (c * p j)) = c * ∑ j : Fin 2, A i j * p j\n          rw [Finset.mul_sum]\n          apply Finset.sum_congr rfl\n          intro j hj\n          ring }\n    exact L.toContinuousLinearMap.comp_memLp' u_H1.2.2\n  have pair (f g : E2 → E2) (hf : MemLp f 2 mu) (hg : MemLp g 2 mu) :\n      Integrable (fun y => inner ℝ (f y) (g y)) mu ∧\n      (∫ y, inner ℝ (f y) (g y) ∂mu) = inner ℝ (hf.toLp f) (hg.toLp g) := by\n    refine ⟨(L2.integrable_inner (𝕜 := ℝ) (hf.toLp f) (hg.toLp g)).congr ?_, ?_⟩\n    · filter_upwards [hf.coeFn_toLp, hg.coeFn_toLp] with y hy hy'\n      rw [hy, hy']\n    · rw [L2.inner_def]\n      apply integral_congr_ae\n      filter_upwards [hf.coeFn_toLp, hg.coeFn_toLp] with y hy hy'\n      rw [hy, hy']\n  let Q : E2 → E2 := fun y => matrixAction K (du y)\n  have hQ : MemLp Q 2 mu := hmatrixMem K\n  have hdphi : MemLp dphi 2 mu := phi_H10.1.2.2\n  have hz : (∫ y in U, inner ℝ (matrixAction K (du y)) (dphi y)) = 0 := by\n    by_contra hn\n    let I := ∫ y, inner ℝ (Q y) (dphi y) ∂mu\n    let qLp := hQ.toLp Q\n    let c : ℝ := |I| / (‖qLp‖ + 1)\n    have hI : 0 < |I| := abs_pos.mpr hn\n    have hden : 0 < ‖qLp‖ + 1 := by positivity\n    have hc : 0 < c := div_pos hI hden\n    obtain ⟨psi, hs, hsupp, ht, herr⟩ := phi_H10.2 (c ^ 2) (sq_pos_of_pos hc)\n    have hcompact : HasCompactSupport (planarGradient psi) := by\n      apply hsupp.mono'\n      intro x hx\n      by_contra hn\n      exact hx (planarGradient_eq_zero_off_support psi hn)\n    have hpsiGrad : MemLp (planarGradient psi) 2 mu :=\n      ((continuous_planarGradient hs).memLp_of_hasCompactSupport hcompact).mono_measure\n        Measure.restrict_le_self\n    have hpsi : MemLp psi 2 mu :=\n      (hs.continuous.memLp_of_hasCompactSupport hsupp).mono_measure Measure.restrict_le_self\n    let D : E2 → E2 := fun y => dphi y - planarGradient psi y\n    have hD : MemLp D 2 mu := hdphi.sub hpsiGrad\n    let dLp := hD.toLp D\n    have hnormD : ‖dLp‖ ^ 2 = ∫ y, ‖D y‖ ^ 2 ∂mu := by\n      rw [← real_inner_self_eq_norm_sq, L2.inner_def]\n      apply integral_congr_ae\n      filter_upwards [hD.coeFn_toLp] with y hy\n      rw [hy, real_inner_self_eq_norm_sq]\n    have hgraderror : (∫ y, ‖D y‖ ^ 2 ∂mu) < c ^ 2 := by\n      apply lt_of_le_of_lt _ herr\n      have huerr : Integrable (fun y => |phi y - psi y| ^ 2) mu := by\n        simpa only [sq_abs, Pi.sub_apply] using (phi_H10.1.2.1.sub hpsi).integrable_sq\n      apply integral_mono (hD.integrable_norm_pow (by norm_num : (2 : ℕ) ≠ 0))\n        (huerr.add (hD.integrable_norm_pow (by norm_num : (2 : ℕ) ≠ 0)))\n      intro y\n      exact le_add_of_nonneg_left (sq_nonneg _)\n    have hdsmall : ‖dLp‖ < c :=\n      (sq_lt_sq₀ (norm_nonneg _) hc.le).mp (hnormD.trans_lt hgraderror)\n    have hpsiPair : inner ℝ qLp (hpsiGrad.toLp (planarGradient psi)) = 0 := by\n      rw [← (pair _ _ hQ hpsiGrad).2]\n      exact htest psi hs hsupp ht\n    have hId : inner ℝ qLp dLp = I := by\n      change inner ℝ (hQ.toLp Q) ((hdphi.sub hpsiGrad).toLp (dphi - planarGradient psi)) = I\n      rw [hdphi.toLp_sub hpsiGrad, inner_sub_right, hpsiPair, sub_zero]\n      exact (pair _ _ hQ hdphi).2.symm\n    have hbound : |I| ≤ ‖qLp‖ * c := by\n      rw [← hId]\n      exact (abs_real_inner_le_norm _ _).trans\n        (mul_le_mul_of_nonneg_left hdsmall.le (norm_nonneg _))\n    have hstrict : ‖qLp‖ * c < |I| := by\n      have hh := mul_lt_mul_of_pos_right (by linarith : ‖qLp‖ < ‖qLp‖ + 1) hc\n      apply hh.trans_eq\n      dsimp [c]\n      field_simp (disch := positivity)\n    exact (hbound.trans_lt hstrict).false\n  refine ⟨hint A0, hint (symmetricPart A0), ?_⟩\n  have hd : (∫ y in U, inner ℝ (matrixAction A0 (du y)) (dphi y)) -\n      (∫ y in U, inner ℝ (matrixAction (symmetricPart A0) (du y)) (dphi y)) = 0 := by\n    rw [← integral_sub (hint A0) (hint (symmetricPart A0))]\n    exact (integral_congr_ae (.of_forall heq)).trans hz\n  exact sub_eq_zero.mp hd)"))

theorem B02_dimension_two_operator_bound
    (A : Mat2) (delta : ℝ) (delta_nonnegative : 0 ≤ delta)
    (entry_bound : ∀ i j, |A i j| ≤ delta) :
    ∀ p : E2, ‖matrixAction A p‖ ≤ 2 * delta * ‖p‖ := by { intro p; have hcoordinate (i : Fin 2) : |matrixAction A p i| ≤ delta * (|p 0| + |p 1|) := by { dsimp only [matrixAction]; simp only [Fin.sum_univ_two]; change |A i 0 * p 0 + A i 1 * p 1| ≤ _; rw [mul_add]; exact (abs_add_le _ _).trans (by { rw [abs_mul, abs_mul]; exact add_le_add (mul_le_mul_of_nonneg_right (entry_bound i 0) (abs_nonneg _)) (mul_le_mul_of_nonneg_right (entry_bound i 1) (abs_nonneg _)) }) }; have h0 := pow_le_pow_left₀ (abs_nonneg (matrixAction A p 0)) (hcoordinate 0) 2; have h1 := pow_le_pow_left₀ (abs_nonneg (matrixAction A p 1)) (hcoordinate 1) 2; have hnorm : ‖matrixAction A p‖ ^ 2 = (matrixAction A p 0) ^ 2 + (matrixAction A p 1) ^ 2 := by { rw [EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_two] }; have hp : ‖p‖ ^ 2 = (p 0) ^ 2 + (p 1) ^ 2 := by { rw [EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_two] }; have habs : (|p 0| + |p 1|) ^ 2 ≤ 2 * ‖p‖ ^ 2 := by { rw [hp]; nlinarith [sq_nonneg (|p 0| - |p 1|),sq_abs (p 0),sq_abs (p 1)] }; have hscaled := mul_le_mul_of_nonneg_left habs (sq_nonneg delta); have hsq : ‖matrixAction A p‖ ^ 2 ≤ (2 * delta * ‖p‖) ^ 2 := by { rw [hnorm]; rw [sq_abs] at h0 h1; nlinarith }; exact (sq_le_sq₀ (norm_nonneg _) (by positivity)).mp hsq }

theorem B02_frozen_coefficient_bounds
    (r : ℝ) (radius_positive : 0 < r)
    (gamma : ℝ≥0) (gamma_positive : 0 < gamma) (gamma_lt_one : gamma < 1)
    (a : E2 → Mat2) (ell Lambda : ℝ) (ell_positive : 0 < ell)
    (Lambda_positive : 0 < Lambda)
    (bounds : ∀ y : E2, ∀ p : E2,
      ell * ‖p‖ ^ 2 ≤ inner ℝ p (matrixAction (a y) p) ∧ (∀ i j, |a y i j| ≤ Lambda))
    (Ca : ℝ≥0) (coefficient_holder : ∀ i j, HolderWith Ca gamma (fun y => a y i j)) :
    ∃ ccut cpert : ℝ, 0 < ccut ∧ 0 < cpert ∧
      ∀ center : E2, ∀ rho : ℝ, 0 < rho → rho ≤ r →
      ∃ eta : E2 → ℝ, ∃ Ceta Cosc : ℝ≥0,
        ContDiff ℝ ∞ eta ∧ HasCompactSupport eta ∧
        tsupport eta ⊆ Metric.ball center rho ∧
        (∀ y ∈ Metric.closedBall center (rho / 2), eta y = 1) ∧
        (∀ y, 0 ≤ eta y ∧ eta y ≤ 1) ∧
        (∀ y z, ‖y - center‖ = ‖z - center‖ → eta y = eta z) ∧
        HolderWith Ceta gamma eta ∧
        Real.rpow rho (gamma : ℝ) * (Ceta : ℝ) ≤ ccut ∧
        (∀ y p, ell * ‖p‖ ^ 2 ≤ inner ℝ p (matrixAction (frozenField a center eta y) p)) ∧
        (∀ y i j, |frozenField a center eta y i j| ≤ Lambda) ∧
        (∀ y p, ‖matrixAction (frozenField a center eta y - a center) p‖ ≤
          cpert * (Ca : ℝ) * Real.rpow rho (gamma : ℝ) * ‖p‖) ∧
        (∀ i j, HolderWith Cosc gamma (fun y => (frozenField a center eta y - a center) i j)) ∧
        Real.rpow rho (gamma : ℝ) * (Cosc : ℝ) ≤
          cpert * (Ca : ℝ) * Real.rpow rho (gamma : ℝ) := by run_tac do let stx ← Lean.ofExcept (Lean.Parser.runParserCategory (← Lean.getEnv) `term "by\n  let b := ContDiffBumpBase.ofInnerProductSpace E2\n  let chi : E2 → ℝ := fun x => b.toFun (3 / 2) ((2 : ℝ) • x)\n  have hsm : ContDiff ℝ ∞ chi := by\n    exact b.smooth.comp_contDiff\n      (contDiff_const.prodMk (contDiff_id.const_smul _))\n      (fun x => ⟨by norm_num, mem_univ _⟩)\n  have hsupport : Function.support chi = Metric.ball 0 (3 / 4 : ℝ) := by\n    ext x\n    change ((2 : ℝ) • x ∈ Function.support (b.toFun (3 / 2))) ↔ _\n    rw [b.support _ (by norm_num)]\n    simp only [Metric.mem_ball, dist_zero_right, norm_smul, Real.norm_eq_abs,\n      abs_of_pos (by norm_num : (0 : ℝ) < 2)]\n    constructor <;> intro h <;> linarith\n  have hts : tsupport chi = Metric.closedBall 0 (3 / 4 : ℝ) := by\n    rw [tsupport, hsupport, closure_ball _ (by norm_num)]\n  have hcompact : HasCompactSupport chi := by\n    rw [HasCompactSupport, hts]\n    exact isCompact_closedBall _ _\n  have hunit (x : E2) : 0 ≤ chi x ∧ chi x ≤ 1 := b.mem_Icc _ _\n  obtain ⟨L, hL⟩ := hsm.lipschitzWith_of_hasCompactSupport hcompact (by simp)\n  have hzero : HolderWith 1 0 chi := by\n    intro x y\n    simp only [NNReal.coe_zero, ENNReal.rpow_zero, mul_one, edist_dist]\n    apply ENNReal.ofReal_le_coe.2\n    change |chi x - chi y| ≤ (1 : ℝ)\n    exact abs_le.2 ⟨by linarith [(hunit x).1, (hunit y).2],\n      by linarith [(hunit x).2, (hunit y).1]⟩\n  let K : ℝ≥0 := max 1 L\n  have hchi : HolderWith K gamma chi :=\n    hzero.of_le_of_le hL.holderWith (by positivity) gamma_lt_one.le\n  refine ⟨(K : ℝ) + 1, (K : ℝ) + 3, by positivity, by positivity, ?_⟩\n  intro center rho hrho hr\n  let rr : ℝ≥0 := ⟨rho, hrho.le⟩\n  let eta : E2 → ℝ := fun y => chi (rho⁻¹ • (y - center))\n  let Ceta : ℝ≥0 := K * (rr⁻¹) ^ (gamma : ℝ)\n  let Cosc : ℝ≥0 := (K + 1) * Ca\n  have heta_smooth : ContDiff ℝ ∞ eta :=\n    hsm.comp ((contDiff_id.sub contDiff_const).const_smul _)\n  have heta_support : Function.support eta = Metric.ball center (3 * rho / 4) := by\n    ext y\n    change (rho⁻¹ • (y - center) ∈ Function.support chi) ↔ _\n    rw [hsupport]\n    simp only [Metric.mem_ball, dist_zero_right, dist_eq_norm, sub_zero, norm_smul,\n      Real.norm_eq_abs, abs_inv, abs_of_pos hrho]\n    rw [← div_eq_inv_mul, div_lt_iff₀ hrho]\n    constructor <;> intro h <;> linarith\n  have heta_ts : tsupport eta = Metric.closedBall center (3 * rho / 4) := by\n    rw [tsupport, heta_support, closure_ball _ (by positivity)]\n  have heta_compact : HasCompactSupport eta := by\n    rw [HasCompactSupport, heta_ts]\n    exact isCompact_closedBall _ _\n  have heta_sub : tsupport eta ⊆ Metric.ball center rho := by\n    rw [heta_ts]\n    intro y hy\n    have hy' := Metric.mem_closedBall.mp hy\n    exact Metric.mem_ball.mpr (by linarith)\n  have heta_unit (y : E2) : 0 ≤ eta y ∧ eta y ≤ 1 := hunit _\n  have hscale : LipschitzWith (rr⁻¹) (fun y : E2 => rho⁻¹ • (y - center)) := by\n    apply LipschitzWith.of_dist_le_mul\n    intro y z\n    simp only [dist_eq_norm, ← smul_sub, sub_sub_sub_cancel_right, norm_smul,\n      Real.norm_eq_abs, abs_inv, abs_of_pos hrho, NNReal.coe_inv, rr]\n    rfl\n  have heta_holder : HolderWith Ceta gamma eta := by\n    simpa only [mul_one, Function.comp_def] using hchi.comp hscale.holderWith\n  have hpow : 0 < Real.rpow rho (gamma : ℝ) := Real.rpow_pos_of_pos hrho _\n  have heta_constant : Real.rpow rho (gamma : ℝ) * (Ceta : ℝ) = K := by\n    simp only [Ceta, NNReal.coe_mul, NNReal.coe_rpow]\n    change Real.rpow rho (gamma : ℝ) * ((K : ℝ) * Real.rpow (rho⁻¹) (gamma : ℝ)) = K\n    rw [Real.rpow_eq_pow, Real.rpow_eq_pow, Real.inv_rpow hrho.le]\n    field_simp\n  have coefficient_near (y : E2) (hy : eta y ≠ 0) (i j : Fin 2) :\n      |a y i j - a center i j| ≤ (Ca : ℝ) * Real.rpow rho (gamma : ℝ) := by\n    have hd : dist y center ≤ rho := (Metric.mem_ball.mp (heta_sub (subset_tsupport eta hy))).le\n    simpa only [Real.dist_eq, Real.r