 phi y + phi y • planarGradient (eta : E2 → ℝ) y := by\n      unfold planarGradient\n      rw [fderiv_fun_mul (heSmooth.differentiable (by simp) y) (hp.differentiable (by simp) y)]\n      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,\n        smul_eq_mul, add_smul, mul_smul, Finset.sum_add_distrib, Finset.smul_sum]\n    have hL2 {F : Type} [NormedAddCommGroup F] [SecondCountableTopology F]\n        (f : E2 → F) (hf : Continuous f) : MemLp f 2 (volume.restrict (halfDisc r)) := by\n      haveI : IsFiniteMeasure (volume.restrict (halfDisc r)) :=\n        isFiniteMeasure_restrict.mpr ((Metric.isBounded_ball.subset (fun x hx => hx.1) :\n          Bornology.IsBounded (halfDisc r)).measure_lt_top.ne)\n      obtain ⟨C, hC⟩ := (isCompact_closedBall (0 : E2) r).exists_bound_of_continuousOn hf.continuousOn\n      apply MemLp.of_bound hf.aestronglyMeasurable C\n      filter_upwards [ae_restrict_mem hW.measurableSet] with y hy\n      exact hC y (Metric.ball_subset_closedBall hy.1)\n    intro eps heps\n    let C := 3 + 2 * D ^ 2\n    have hC : 0 < C := by dsimp [C]; positivity\n    obtain ⟨phi, hp, hc, hs, herr⟩ := hw.2 (eps / C) (div_pos heps hC)\n    have hprod : ContDiff ℝ ∞ (fun y => eta y * phi y) := eta.contDiff.mul hp\n    have hps : tsupport (fun y => eta y * phi y) ⊆ U := by\n      intro y hy\n      exact ⟨heS (tsupport_mul_subset_left hy), (hs (tsupport_mul_subset_right hy)).2⟩\n    refine ⟨fun y => eta y * phi y, hprod, eta.hasCompactSupport.mul_right, hps, ?_⟩\n    have hpoint (y : E2) (hy : y ∈ halfDisc r) :\n        |w y - eta y * phi y| ^ 2 +\n          ‖dw y - planarGradient (fun x => eta x * phi x) y‖ ^ 2 ≤\n        C * (|w y - phi y| ^ 2 + ‖dw y - planarGradient phi y‖ ^ 2) := by\n      have he : |eta y| ≤ 1 := by rw [abs_of_nonneg eta.nonneg]; exact eta.le_one\n      have hscalar : w y - eta y * phi y = eta y * (w y - phi y) := by\n        rw [mul_sub, (heid y).1]\n      have hvector : dw y - planarGradient (fun x => eta x * phi x) y =\n          eta y • (dw y - planarGradient phi y) + (w y - phi y) • planarGradient (eta : E2 → ℝ) y := by\n        rw [hgradprod phi hp y, smul_sub, sub_smul]\n        calc\n          _ = (eta y • dw y + w y • planarGradient (eta : E2 → ℝ) y) -\n              (eta y • planarGradient phi y + phi y • planarGradient (eta : E2 → ℝ) y) := by rw [(heid y).2]\n          _ = _ := by module\n      have hsbound : |w y - eta y * phi y| ≤ |w y - phi y| := by\n        rw [hscalar, abs_mul]\n        exact mul_le_of_le_one_left (abs_nonneg _) he\n      have hdbound : ‖dw y - planarGradient (fun x => eta x * phi x) y‖ ≤\n          ‖dw y - planarGradient phi y‖ + |w y - phi y| * D := by\n        rw [hvector]\n        apply (norm_add_le _ _).trans\n        simp only [norm_smul, Real.norm_eq_abs]\n        exact add_le_add (mul_le_of_le_one_left (norm_nonneg _) he)\n          (mul_le_mul_of_nonneg_left (hbound y hy) (abs_nonneg _))\n      dsimp [C]\n      nlinarith [sq_nonneg (‖dw y - planarGradient phi y‖ - |w y - phi y| * D),\n        norm_nonneg (dw y - planarGradient (fun x => eta x * phi x) y),\n        norm_nonneg (dw y - planarGradient phi y), abs_nonneg (w y - eta y * phi y),\n        abs_nonneg (w y - phi y), mul_nonneg (sq_nonneg D) (sq_nonneg ‖dw y - planarGradient phi y‖)]\n    have hleft : IntegrableOn (fun y => |w y - eta y * phi y| ^ 2 +\n        ‖dw y - planarGradient (fun x => eta x * phi x) y‖ ^ 2) (halfDisc r) := by\n      unfold IntegrableOn\n      simp only [sq_abs]\n      exact ((hw.1.2.1.sub (hL2 _ hprod.continuous)).integrable_sq).add\n          ((hw.1.2.2.sub (hL2 _ (continuous_planarGradient hprod))).norm.integrable_sq)\n    have hright : IntegrableOn (fun y => |w y - phi y| ^ 2 +\n        ‖dw y - planarGradient phi y‖ ^ 2) (halfDisc r) := by\n      unfold IntegrableOn\n      simp only [sq_abs]\n      exact ((hw.1.2.1.sub (hL2 _ hp.continuous)).integrable_sq).add\n          ((hw.1.2.2.sub (hL2 _ (continuous_planarGradient hp))).norm.integrable_sq)\n    calc\n      _ ≤ ∫ y in halfDisc r, |w y - eta y * phi y| ^ 2 +\n          ‖dw y - planarGradient (fun x => eta x * phi x) y‖ ^ 2 :=\n        setIntegral_mono_set hleft (Eventually.of_forall (fun y => by positivity))\n          (Eventually.of_forall hin)\n      _ ≤ ∫ y in halfDisc r, C * (|w y - phi y| ^ 2 + ‖dw y - planarGradient phi y‖ ^ 2) := by\n        apply integral_mono_ae hleft (hright.const_mul C)\n        filter_upwards [ae_restrict_mem hW.measurableSet] with y hy\n        exact hpoint y hy\n      _ = C * ∫ y in halfDisc r, |w y - phi y| ^ 2 + ‖dw y - planarGradient phi y‖ ^ 2 := integral_const_mul _ _\n      _ < eps := by nlinarith [(mul_lt_mul_of_pos_left herr hC), div_mul_cancel₀ eps (ne_of_gt hC)]\n  refine ⟨hlocal, ?_⟩\n  have hpre : (fun z : E2 => z + center) ⁻¹' U = halfDisc rho := by\n    ext z\n    change (dist (z + center) center < rho ∧ 0 < (z + center) 1) ↔\n      (dist z 0 < rho ∧ 0 < z 1)\n    rw [dist_eq_norm, dist_eq_norm, add_sub_cancel_right, sub_zero, PiLp.add_apply,\n      center_flat, add_zero]\n  have hforward (z : E2) : z ∈ halfDisc rho ↔ z + center ∈ U := by\n    change z ∈ halfDisc rho ↔ z ∈ (fun z : E2 => z + center) ⁻¹' U\n    rw [hpre]\n  have hT : MeasurePreserving (fun z : E2 => z + center)\n      (volume.restrict (halfDisc rho)) (volume.restrict U) := by\n    rw [← hpre]\n    exact (measurePreserving_add_right volume center).restrict_preimage hU.measurableSet\n  have hEmb : MeasurableEmbedding (fun z : E2 => z + center) :=\n    (Homeomorph.addRight center).measurableEmbedding\n  have hInt (f : E2 → ℝ) : (∫ z in halfDisc rho, f (z + center)) = ∫ y in U, f y :=\n    hT.integral_comp hEmb f\n  have hval : MemLp (fun z => w (z + center)) 2 (volume.restrict (halfDisc rho)) :=\n    hlocal.1.2.1.comp_measurePreserving hT\n  have hgrad : MemLp (fun z => dw (z + center)) 2 (volume.restrict (halfDisc rho)) :=\n    hlocal.1.2.2.comp_measurePreserving hT\n  haveI : IsFiniteMeasure (volume.restrict (halfDisc rho)) :=\n    isFiniteMeasure_restrict.mpr ((Metric.isBounded_ball.subset (fun x hx => hx.1) :\n      Bornology.IsBounded (halfDisc rho)).measure_lt_top.ne)\n  refine ⟨⟨⟨IntegrableOn.locallyIntegrableOn (μ := volume) (hval.integrable (by norm_num)),\n    IntegrableOn.locallyIntegrableOn (μ := volume) (hgrad.integrable (by norm_num)), ?_⟩, hval, hgrad⟩, ?_⟩\n  · intro phi hp hc hs i\n    let psi := fun y : E2 => phi (y + (-center))\n    have hpsi : ContDiff ℝ ∞ psi := hp.comp (contDiff_id.add contDiff_const)\n    have hcpsi : HasCompactSupport psi := hc.comp_homeomorph (Homeomorph.addRight (-center))\n    have hspsi : tsupport psi ⊆ U := by\n      intro y hy\n      have hys : y + (-center) ∈ halfDisc rho := hs\n        (tsupport_comp_subset_preimage phi (continuous_id.add continuous_const) hy)\n      have h := (hforward (y + (-center))).mp hys\n      simpa only [neg_add_cancel_right] using h\n    have heq := hlocal.1.1.2.2 psi hpsi hcpsi hspsi i\n    rw [← hInt (fun y => w y * fderiv ℝ psi y (coordinateVector 2 i)),\n      ← hInt (fun y => dw y i * psi y)] at heq\n    simpa only [psi, fderiv_comp_add_right, add_neg_cancel_right] using heq\n  · intro eps heps\n    obtain ⟨phi, hp, hc, hs, herr⟩ := hlocal.2 eps heps\n    have hgshift (z : E2) : planarGradient (fun x => phi (x + center)) z =\n        planarGradient phi (z + center) := by\n      unfold planarGradient\n      rw [fderiv_comp_add_right]\n    refine ⟨fun z => phi (z + center), hp.comp (contDiff_id.add contDiff_const),\n      hc.comp_homeomorph (Homeomorph.addRight center), ?_, ?_⟩\n    · intro z hz\n      exact (hforward z).mpr (hs\n        (tsupport_comp_subset_preimage phi (continuous_id.add continuous_const) hz))\n    · simp_rw [hgshift]\n      change (∫ z in halfDisc rho, |w (z + center) - phi (z + center)| ^ 2 +\n        ‖dw (z + center) - planarGradient phi (z + center)‖ ^ 2) < eps\n      rw [hInt (fun y => |w y - phi y| ^ 2 + ‖dw y - planarGradient phi y‖ ^ 2)]\n      exact herr\n\n)"))

theorem B00_book_sign_bridge :
    ∀ (phi : E2 → ℝ) (dphi : E2 → E2), H10On (halfDisc r) phi dphi →
      IntegrableOn
        (fun y => inner ℝ (matrixAction (a y) (dv y) + (-e y)) (dphi y)) (halfDisc r) ∧
      (∫ y in halfDisc r,
        inner ℝ (matrixAction (a y) (dv y) + (-e y)) (dphi y)) = 0 := by run_tac do Lean.Elab.Tactic.evalTactic (← Lean.ofExcept (Lean.Parser.runParserCategory (← Lean.getEnv) `tactic "exact (by\n  set_option maxHeartbeats 2000000 in\n    have htesting :\n        MemLp (fun y => matrixAction (a y) (dv y)) 2 (volume.restrict (halfDisc r)) ∧\n        MemLp e 2 (volume.restrict (halfDisc r)) ∧\n        ∀ (phi : E2 → ℝ) (dphi : E2 → E2), H10On (halfDisc r) phi dphi →\n          IntegrableOn (fun y => inner ℝ (matrixAction (a y) (dv y)) (dphi y)) (halfDisc r) ∧\n          IntegrableOn (fun y => inner ℝ (e y) (dphi y)) (halfDisc r) ∧\n          (∫ y in halfDisc r, inner ℝ (matrixAction (a y) (dv y)) (dphi y)) =\n            ∫ y in halfDisc r, inner ℝ (e y) (dphi y) := by\n      classical\n      let U := halfDisc r\n      let mu := volume.restrict U\n      have hU : MeasurableSet U := by\n        change MeasurableSet (Metric.ball (0 : E2) r ∩ {y : E2 | (0 : ℝ) < y 1})\n        exact (Metric.isOpen_ball.inter (isOpen_lt\n          (continuous_const : Continuous (fun _ : E2 => (0 : ℝ)))\n          (EuclideanSpace.proj (1 : Fin 2)).continuous)).measurableSet\n      have hclosed : IsCompact (closedHalfDisc r) := by\n        apply (isCompact_closedBall (0 : E2) r).inter_right\n        exact isClosed_le continuous_const (EuclideanSpace.proj (1 : Fin 2)).continuous\n      have hsubset : U ⊆ closedHalfDisc r := by\n        intro y hy\n        exact ⟨Metric.mem_closedBall.mpr (Metric.mem_ball.mp hy.1).le, hy.2.le⟩\n      haveI : IsFiniteMeasure mu := by\n        refine ⟨?_⟩\n        change (volume.restrict U) univ < (⊤ : ℝ≥0∞)\n        rw [Measure.restrict_apply_univ]\n        exact lt_of_le_of_lt (measure_mono (fun y hy => hy.1)) measure_ball_lt_top\n      have bounded_mem (f : E2 → E2) (hf : ContinuousOn f (closedHalfDisc r))\n          (C : ℝ) (hb : ∀ y ∈ closedHalfDisc r, ‖f y‖ ≤ C) : MemLp f 2 mu := by\n        apply MemLp.of_bound ((hf.mono hsubset).aestronglyMeasurable hU) C\n        filter_upwards [ae_restrict_mem hU] with y hy\n        exact hb y (hsubset hy)\n      have hE : MemLp e 2 mu :=\n        bounded_mem e (forcing_holder.continuousOn gamma_positive) Be forcing_bound\n      have hDV : MemLp dv 2 mu := weak_equation.1.2.2\n      have matrix_bound (A : Mat2) (delta : ℝ) (hdelta : 0 ≤ delta)\n          (hA : ∀ i j, |A i j| ≤ delta) (p : E2) :\n          ‖matrixAction A p‖ ≤ 2 * delta * ‖p‖ := by\n        have hcoordinate (i : Fin 2) : |matrixAction A p i| ≤ delta * (|p 0| + |p 1|) := by\n          dsimp only [matrixAction]\n          simp only [Fin.sum_univ_two]\n          change |A i 0 * p 0 + A i 1 * p 1| ≤ _\n          rw [mul_add]\n          exact (abs_add_le _ _).trans (by\n            rw [abs_mul, abs_mul]\n            exact add_le_add (mul_le_mul_of_nonneg_right (hA i 0) (abs_nonneg _))\n              (mul_le_mul_of_nonneg_right (hA i 1) (abs_nonneg _)))\n        have h0 := pow_le_pow_left₀ (abs_nonneg (matrixAction A p 0)) (hcoordinate 0) 2\n        have h1 := pow_le_pow_left₀ (abs_nonneg (matrixAction A p 1)) (hcoordinate 1) 2\n        have hnorm : ‖matrixAction A p‖ ^ 2 = (matrixAction A p 0) ^ 2 + (matrixAction A p 1) ^ 2 := by\n          rw [EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_two]\n        have hp : ‖p‖ ^ 2 = (p 0) ^ 2 + (p 1) ^ 2 := by\n          rw [EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_two]\n        have habs : (|p 0| + |p 1|) ^ 2 ≤ 2 * ‖p‖ ^ 2 := by\n          rw [hp]\n          nlinarith [sq_nonneg (|p 0| - |p 1|), sq_abs (p 0), sq_abs (p 1)]\n        have hscaled := mul_le_mul_of_nonneg_left habs (sq_nonneg delta)\n        have hsq : ‖matrixAction A p‖ ^ 2 ≤ (2 * delta * ‖p‖) ^ 2 := by\n          rw [hnorm]\n          rw [sq_abs] at h0 h1\n          nlinarith\n        exact (sq_le_sq₀ (norm_nonneg _) (by positivity)).mp hsq\n      have ha : Continuous a := continuous_pi fun i => continuous_pi fun j =>\n        (coefficient_holder i j).continuous gamma_positive\n      have hma : Continuous (fun z : Mat2 × E2 => matrixAction z.1 z.2) := by\n        unfold matrixAction\n        fun_prop\n      letI : TopologicalSpace.PseudoMetrizableSpace Mat2 := by\n        change TopologicalSpace.PseudoMetrizableSpace (Fin 2 → Fin 2 → ℝ)\n        infer_instance\n      have hAmeas : AEStronglyMeasurable (fun y => matrixAction (a y) (dv y)) mu :=\n        hma.comp_aestronglyMeasurable (ha.aestronglyMeasurable.prodMk hDV.aestronglyMeasurable)\n      have hA : MemLp (fun y => matrixAction (a y) (dv y)) 2 mu := by\n        apply (hDV.norm.const_mul (2 * Lambda)).mono' hAmeas\n        exact Eventually.of_forall fun y => matrix_bound (a y) Lambda Lambda_positive.le\n          (bounds y 0).2 (dv y)\n      have pair (f g : E2 → E2) (hf : MemLp f 2 mu) (hg : MemLp g 2 mu) :\n          Integrable (fun y => inner ℝ (f y) (g y)) mu ∧\n          (∫ y, inner ℝ (f y) (g y) ∂mu) = inner ℝ (hf.toLp f) (hg.toLp g) := by\n        refine ⟨(L2.integrable_inner (𝕜 := ℝ) (hf.toLp f) (hg.toLp g)).congr ?_, ?_⟩\n        · filter_upwards [hf.coeFn_toLp, hg.coeFn_toLp] with y hy hy'\n          rw [hy, hy']\n        · rw [L2.inner_def]\n          apply integral_congr_ae\n          filter_upwards [hf.coeFn_toLp, hg.coeFn_toLp] with y hy hy'\n          rw [hy, hy']\n      let Q : E2 → E2 := fun y => matrixAction (a y) (dv y) - e y\n      have hQ : MemLp Q 2 mu := hA.sub hE\n      have htest (psi : E2 → ℝ) (hs : ContDiff ℝ ∞ psi) (hc : HasCompactSupport psi)\n          (ht : tsupport psi ⊆ U) : (∫ y, inner ℝ (Q y) (planarGradient psi y) ∂mu) = 0 := by\n        obtain ⟨hiA, hiE, heq⟩ := weak_equation.2 psi hs hc ht\n        have hiE' : Integrable (fun y => inner ℝ (e y) (planarGradient psi y)) mu := by\n          change IntegrableOn (fun y => inner ℝ (e y) (planarGradient psi y)) (halfDisc r)\n          simpa only [zero_mul, add_zero] using hiE\n        have heq' : (∫ y, inner ℝ (matrixAction (a y) (dv y)) (planarGradient psi y) ∂mu) =\n            ∫ y, inner ℝ (e y) (planarGradient psi y) ∂mu := by\n          simpa only [zero_mul, add_zero] using heq\n        change (∫ y, inner ℝ (matrixAction (a y) (dv y) - e y) (planarGradient psi y) ∂mu) = 0\n        simp_rw [inner_sub_left]\n        rw [integral_sub hiA hiE', heq', sub_self]\n      refine ⟨hA, hE, ?_⟩\n      intro phi dphi hphi\n      have hdphi : MemLp dphi 2 mu := hphi.1.2.2\n      refine ⟨(pair _ _ hA hdphi).1, (pair _ _ hE hdphi).1, ?_⟩\n      have hzero : (∫ y, inner ℝ (Q y) (dphi y) ∂mu) = 0 := by\n        by_contra hn\n        let I := ∫ y, inner ℝ (Q y) (dphi y) ∂mu\n        let qLp := hQ.toLp Q\n        let c : ℝ := |I| / (‖qLp‖ + 1)\n        have hI : 0 < |I| := abs_pos.mpr hn\n        have hden : 0 < ‖qLp‖ + 1 := by positivity\n        have hc : 0 < c := div_pos hI hden\n        obtain ⟨psi, hs, hsupp, ht, herr⟩ := hphi.2 (c ^ 2) (sq_pos_of_pos hc)\n        obtain ⟨C, hC⟩ := hclosed.exists_bound_of_continuousOn (continuous_planarGradient hs).continuousOn\n        have hpsiGrad : MemLp (planarGradient psi) 2 mu :=\n          bounded_mem _ (continuous_planarGradient hs).continuousOn C hC\n        have hpsi : MemLp psi 2 mu := by\n          obtain ⟨C', hC'⟩ := hclosed.exists_bound_of_continuousOn hs.continuous.continuousOn\n          apply MemLp.of_bound hs.continuous.aestronglyMeasurable C'\n          filter_upwards [ae_restrict_mem hU] with y hy\n          exact hC' y (hsubset hy)\n        let D : E2 → E2 := fun y => dphi y - planarGradient psi y\n        have hD : MemLp D 2 mu := hdphi.sub hpsiGrad\n        let dLp := hD.toLp D\n        have hnormD : ‖dLp‖ ^ 2 = ∫ y, ‖D y‖ ^ 2 ∂mu := by\n          rw [← real_inner_self_eq_norm_sq, L2.inner_def]\n          apply integral_congr_ae\n          filter_upwards [hD.coeFn_toLp] with y hy\n          rw [hy, real_inner_self_eq_norm_sq]\n        have hgraderror : (∫ y, ‖D y‖ ^ 2 ∂mu) < c ^ 2 := by\n          apply lt_of_le_of_lt _ herr\n          have huerr : Integrable (fun y => |phi y - psi y| ^ 2) mu := by\n            change Integrable (fun y => |phi y - psi y| ^ 2) (volume.restrict (halfDisc r))\n            simpa only [sq_abs, Pi.sub_apply] using (hphi.1.2.1.sub hpsi).integrable_sq\n          apply integral_mono (hD.integrable_norm_pow (by norm_num : (2:ℕ) ≠ 0))\n            (huerr.add (hD.integrable_norm_pow (by norm_num : (2:ℕ) ≠ 0)))\n          intro y\n          exact le_add_of_nonneg_left (sq_nonneg _)\n        have hdsmall : ‖dLp‖ < c :=\n          (sq_lt_sq₀ (norm_nonneg _) hc.le).mp (hnormD.trans_lt hgraderror)\n        have hpsiPair : inner ℝ qLp (hpsiGrad.toLp (planarGradient psi)) = 0 := by\n          rw [← (pair _ _ hQ hpsiGrad).2]\n          exact htest psi hs hsupp ht\n        have hId : inner ℝ qLp dLp = I := by\n          change inner ℝ (hQ.toLp Q) ((hdphi.sub hpsiGrad).toLp (dphi - planarGradient psi)) = I\n          rw [hdphi.toLp_sub hpsiGrad, inner_sub_right, hpsiPair, sub_zero]\n          exact (pair _ _ hQ hdphi).2.symm\n        have hbound : |I| ≤ ‖qLp‖ * c := by\n          rw [← hId]\n          exact (abs_real_inner_le_norm _ _).trans\n            (mul_le_mul_of_nonneg_left hdsmall.le (norm_nonneg _))\n        have hstrict : ‖qLp‖ * c < |I| := by\n          have hh := mul_lt_mul_of_pos_right (by linarith : ‖qLp‖ < ‖qLp‖ + 1) hc\n          apply hh.trans_eq\n          dsimp [c]\n          field_simp (disch := positivity)\n        exact (hbound.trans_lt hstrict).false\n      have hsub : (∫ y, inner ℝ (Q y) (dphi y) ∂mu) =\n          (∫ y, inner ℝ (matrixAction (a y) (dv y)) (dphi y) ∂mu) -\n            ∫ y, inner ℝ (e y) (dphi y) ∂mu := by\n        dsimp only [Q]\n        simp_rw [inner_sub_left]\n        exact integral_sub (pair _ _ hA hdphi).1 (pair _ _ hE hdphi).1\n      exact sub_eq_zero.mp (hsub.symm.trans hzero)\n    intro phi dphi hphi\n    obtain ⟨hA, hE, heq⟩ := htesting.2.2 phi dphi hphi\n    simp_rw [inner_add_left, inner_neg_left]\n    have hEn : IntegrableOn (fun y => -inner ℝ (e y) (dphi y)) (halfDisc r) := hE.neg\n    exact ⟨hA.add hEn, by rw [integral_add hA hEn, integral_neg, heq, add_neg_cancel]⟩\n\n)"))

theorem B01_cutoff_product_equation
    (chi : E2 → ℝ) (chi_smooth : ContDiff ℝ ∞ chi)
    (chi_compact : HasCompactSupport chi) (chi_support : tsupport chi ⊆ disc r) :
    H10On (halfDisc r) (fun y => chi y * v y) (cutoffGradient chi v dv) ∧
    MemLp (cutoffFlux a chi e v) 2 (volume.restrict (halfDisc r)) ∧
    MemLp (cutoffScalar a chi e dv) 2 (volume.restrict (halfDisc r)) ∧
    WeakDivergenceWithData (halfDisc r) a (cutoffFlux a chi e v) (cutoffScalar a chi e dv)
      (fun y => chi y * v y) (cutoffGradient chi v dv) ∧
    ∀ (phi : E2 → ℝ) (dphi : E2 → E2), H10On (halfDisc r) phi dphi →
      IntegrableOn
        (fun y => inner ℝ (matrixAction (a y) (cutoffGradient chi v dv y)) (dphi y))
        (halfDisc r) ∧
      IntegrableOn
        (fun y => inner ℝ (cutoffFlux a chi e v y) (dphi y) + cutoffScalar a chi e dv y * phi y)
        (halfDisc r) ∧
      (∫ y in halfDisc r,
        inner ℝ (matrixAction (a y) (cutoffGradient chi v dv y)) (dphi y)) =
        ∫ y in halfDisc r,
          inner ℝ (cutoffFlux a chi e v y) (dphi y) + cutoffScalar a chi e dv y * phi y := by run_tac do Lean.Elab.Tactic.evalTactic (← Lean.ofExcept (Lean.Parser.runParserCategory (← Lean.getEnv) `tactic "set_option maxHeartbeats 0 in\nset_option maxRecDepth 4000 in\nexact (by\n  classical\n  have operatorLp (p : ℝ≥0∞) (U : Set E2) (a : E2 → Mat2) (Lambda : ℝ)\n      (ha : ∀ i j, Continuous (fun y => a y i j))\n      (hb : ∀ y i j, |a y i j| ≤ Lambda)\n      (f : E2 → E2) (hf : MemLp f p (volume.restrict U)) :\n      MemLp (fun y => matrixAction (a y) (f y)) p (volume.restrict U) := by\n    apply memLp_piLp_iff.mpr\n    intro i\n    have hentry (j : Fin 2) : MemLp (fun y => a y i j) ∞ (volume.restrict U) := by\n      exact memLp_top_of_bound (ha i j).aestronglyMeasurable Lambda\n        (Eventually.of_forall fun y => by simpa only [Real.norm_eq_abs] using hb y i j)\n    have hcomponent (j : Fin 2) : MemLp (fun y => f y j) p (volume.restrict U) :=\n      memLp_piLp_iff.mp hf j\n    have h0 : MemLp (fun y => a y i 0 * f y 0) p (volume.restrict U) :=\n      (hentry 0).mul (hcomponent 0)\n    have h1 : MemLp (fun y => a y i 1 * f y 1) p (volume.restrict U) :=\n      (hentry 1).mul (hcomponent 1)\n    convert h0.add h1 using 1\n    funext y\n    dsimp only [matrixAction]\n    simp only [Fin.sum_univ_two]\n    rfl\n  have smoothTop (U : Set E2) (chi : E2 → ℝ) (hc : ContDiff ℝ ∞ chi)\n      (hs : HasCompactSupport chi) :\n      MemLp chi ∞ (volume.restrict U) ∧\n      MemLp (planarGradient chi) ∞ (volume.restrict U) := by\n    obtain ⟨C, hC⟩ := hs.exists_bound_of_continuous hc.continuous\n    have hgcompact : HasCompactSupport (planarGradient chi) := by\n      apply hs.mono'\n      intro y hy\n      by_contra hn\n      exact hy (planarGradient_eq_zero_off_support chi hn)\n    obtain ⟨D,hD⟩ := hgcompact.exists_bound_of_continuous (continuous_planarGradient hc)\n    exact ⟨memLp_top_of_bound hc.continuous.aestronglyMeasurable C (Eventually.of_forall hC),\n      memLp_top_of_bound (continuous_planarGradient hc).aestronglyMeasurable D (Eventually.of_forall hD)⟩\n  have scalarLp (U : Set E2) (a : E2 → Mat2) (chi : E2 → ℝ) (e dv : E2 → E2)\n      (he : MemLp e 2 (volume.restrict U))\n      (had : MemLp (fun y => matrixAction (a y) (dv y)) 2 (volume.restrict U))\n      (hg : MemLp (planarGradient chi) ∞ (volume.restrict U)) :\n      MemLp (fun y => inner ℝ (e y - matrixAction (a y) (dv y)) (planarGradient chi y))\n        2 (volume.restrict U) := by\n    have hdiff := he.sub had\n    have hterm (i : Fin 2) : MemLp\n        (fun y => (e y i - matrixAction (a y) (dv y) i) * planarGradient chi y i)\n        2 (volume.restrict U) := by\n      exact (memLp_piLp_iff.mp hdiff i).mul (memLp_piLp_iff.mp hg i)\n    convert (hterm 0).add (hterm 1) using 1\n    funext y\n    change inner ℝ (e y - matrixAction (a y) (dv y)) (planarGradient chi y) =\n      (e y 0 - matrixAction (a y) (dv y) 0) * planarGradient chi y 0 +\n      (e y 1 - matrixAction (a y) (dv y) 1) * planarGradient chi y 1\n    simp only [PiLp.inner_apply, Fin.sum_univ_two, RCLike.inner_apply, conj_trivial]\n    change planarGradient chi y 0 * (e y 0 - matrixAction (a y) (dv y) 0) +\n      planarGradient chi y 1 * (e y 1 - matrixAction (a y) (dv y) 1) = _\n    ring\n  have pairingInt (U : Set E2) (f g : E2 → E2)\n      (hf : MemLp f 2 (volume.restrict U)) (hg : MemLp g 2 (volume.restrict U)) :\n      IntegrableOn (fun y => inner ℝ (f y) (g y)) U := by\n    change Integrable (fun y => inner ℝ (f y) (g y)) (volume.restrict U)\n    have ht (i : Fin 2) : Integrable (fun y => f y i * g y i) (volume.restrict U) :=\n      (memLp_piLp_iff.mp hf i).integrable_mul (memLp_piLp_iff.mp hg i)\n    convert (ht 0).add (ht 1) using 1\n    funext y\n    change inner ℝ (f y) (g y) = f y 0 * g y 0 + f y 1 * g y 1\n    simp only [PiLp.inner_apply, Fin.sum_univ_two, RCLike.inner_apply, conj_trivial]\n    ring\n  have prodAlgebra (A : Mat2) (c w s : ℝ) (e d g q : E2) :\n      inner ℝ (matrixAction A (c • d + w • g)) q -\n        (inner ℝ (c • e + w • matrixAction A g) q + inner ℝ (e - matrixAction A d) g * s) =\n      inner ℝ (matrixAction A d - e) (c • q + s • g) := by\n    simp only [PiLp.inner_apply, Fin.sum_univ_two, RCLike.inner_apply, conj_trivial]\n    dsimp only [matrixAction]\n    simp only [Fin.sum_univ_two]\n    change\n      q 0 * (A 0 0 * (c * d 0 + w * g 0) + A 0 1 * (c * d 1 + w * g 1)) +\n        q 1 * (A 1 0 * (c * d 0 + w * g 0) + A 1 1 * (c * d 1 + w * g 1)) -\n        (q 0 * (c * e 0 + w * (A 0 0 * g 0 + A 0 1 * g 1)) +\n         q 1 * (c * e 1 + w * (A 1 0 * g 0 + A 1 1 * g 1)) +\n         (g 0 * (e 0 - (A 0 0 * d 0 + A 0 1 * d 1)) +\n          g 1 * (e 1 - (A 1 0 * d 0 + A 1 1 * d 1))) * s) =\n        (c * q 0 + s * g 0) * (A 0 0 * d 0 + A 0 1 * d 1 - e 0) +\n        (c * q 1 + s * g 1) * (A 1 0 * d 0 + A 1 1 * d 1 - e 1)\n    ring\n  have prodGradient (chi psi : E2 → ℝ) (hc : ContDiff ℝ ∞ chi) (hp : ContDiff ℝ ∞ psi) (y : E2) :\n      planarGradient (fun x => chi x * psi x) y =\n        chi y • planarGradient psi y + psi y • planarGradient chi y := by\n    dsimp only [planarGradient]\n    rw [fderiv_fun_mul (hc.differentiable (by simp) y) (hp.differentiable (by simp) y)]\n    simp only [Fin.sum_univ_two, add_apply, smul_apply, smul_eq_mul,\n      add_smul, mul_smul, smul_add]\n    exact add_add_add_comm _ _ _ _\n  have testExtension (U : Set E2) [IsFiniteMeasure (volume.restrict U)]\n      (P : E2 → E2) (Q : E2 → ℝ)\n      (hP : MemLp P 2 (volume.restrict U)) (hQ : MemLp Q 2 (volume.restrict U))\n      (htest : ∀ (psi : E2 → ℝ), ContDiff ℝ ∞ psi → HasCompactSupport psi → tsupport psi ⊆ U →\n        (∫ y in U, inner ℝ (P y) (planarGradient psi y)) = ∫ y in U, Q y * psi y)\n      (phi : E2 → ℝ) (dphi : E2 → E2) (hphi : H10On U phi dphi) :\n      (∫ y in U, inner ℝ (P y) (dphi y)) = ∫ y in U, Q y * phi y := by\n    let mu := volume.restrict U\n    have pair (E : Type) [NormedAddCommGroup E] [InnerProductSpace ℝ E]\n        (f g : E2 → E) (hf : MemLp f 2 mu) (hg : MemLp g 2 mu) :\n        (∫ y, inner ℝ (f y) (g y) ∂mu) = inner ℝ (hf.toLp f) (hg.toLp g) := by\n      rw [MeasureTheory.L2.inner_def]\n      apply integral_congr_ae\n      filter_upwards [hf.coeFn_toLp,hg.coeFn_toLp] with y hfy hgy\n      rw [hfy,hgy]\n    have nsq (E : Type) [NormedAddCommGroup E] [InnerProductSpace ℝ E]\n        (f : E2 → E) (hf : MemLp f 2 mu) :\n        ‖hf.toLp f‖ ^ 2 = ∫ y, ‖f y‖ ^ 2 ∂mu := by\n      rw [← real_inner_self_eq_norm_sq, MeasureTheory.L2.inner_def]\n      apply integral_congr_ae\n      filter_upwards [hf.coeFn_toLp] with y hy\n      rw [hy,real_inner_self_eq_norm_sq]\n    have smoothLp (psi : E2 → ℝ) (hs : ContDiff ℝ ∞ psi) (hc : HasCompactSupport psi) :\n        MemLp psi 2 mu ∧ MemLp (planarGradient psi) 2 mu := by\n      obtain ⟨C,hC⟩ := hc.exists_bound_of_continuous hs.continuous\n      have hgc : HasCompactSupport (planarGradient psi) := by\n        apply hc.mono'\n        intro y hy\n        by_contra hn\n        exact hy (planarGradient_eq_zero_off_support psi hn)\n      obtain ⟨D,hD⟩ := hgc.exists_bound_of_continuous (continuous_planarGradient hs)\n      exact ⟨MemLp.of_bound hs.continuous.aestronglyMeasurable C (Eventually.of_forall hC),\n        MemLp.of_bound (continuous_planarGradient hs).aestronglyMeasurable D (Eventually.of_forall hD)⟩\n    have hp : MemLp phi 2 mu := hphi.1.2.1\n    have hd : MemLp dphi 2 mu := hphi.1.2.2\n    let I : ℝ := inner ℝ (hP.toLp P) (hd.toLp dphi) - inner ℝ (hQ.toLp Q) (hp.toLp phi)\n    have hI : I = 0 := by\n      by_contra hn\n      have hIpos : 0 < |I| := abs_pos.mpr hn\n      let C : ℝ := ‖hP.toLp P‖ + ‖hQ.toLp Q‖ + 1\n      have hC : 0 < C := by dsimp [C]; positivity\n      let delta : ℝ := |I| / (2 * C)\n      have hdelta : 0 < delta := div_pos hIpos (by positivity)\n      obtain ⟨psi,hs,hc,hu,he⟩ := hphi.2 (delta ^ 2) (sq_pos_of_pos hdelta)\n      obtain ⟨hps,hgs⟩ := smoothLp psi hs hc\n      have hsmallv : ‖hp.toLp phi - hps.toLp psi‖ ^ 2 = ∫ y, |phi y - psi y| ^ 2 ∂mu := by\n        rw [← MemLp.toLp_sub hp hps]\n        simpa only [Pi.sub_apply,Real.norm_eq_abs] using nsq ℝ (phi - psi) (hp.sub hps)\n      have hsmalld : ‖hd.toLp dphi - hgs.toLp (planarGradient psi)‖ ^ 2 =\n          ∫ y, ‖dphi y - planarGradient psi y‖ ^ 2 ∂mu := by\n        rw [← MemLp.toLp_sub hd hgs]\n        exact nsq E2 (dphi - planarGradient psi) (hd.sub hgs)\n      have hvi : Integrable (fun y => |phi y - psi y| ^ 2) mu := by\n        convert (hp.sub hps).norm.integrable_mul (hp.sub hps).norm using 1\n        funext y\n        simp only [Pi.sub_apply,Real.norm_eq_abs,pow_two]\n        rfl\n      have hdi : Integrable (fun y => ‖dphi y - planarGradient psi y‖ ^ 2) mu := by\n        convert (hd.sub hgs).norm.integrable_mul (hd.sub hgs).norm using 1\n        funext y\n        simp only [Pi.sub_apply,pow_two]\n        rfl\n      have hsmall : ‖hp.toLp phi - hps.toLp psi‖ ^ 2 +\n          ‖hd.toLp dphi - hgs.toLp (planarGradient psi)‖ ^ 2 < delta ^ 2 := by\n        rw [hsmallv,hsmalld,← integral_add hvi hdi]\n        exact he\n      have hv : ‖hp.toLp phi - hps.toLp psi‖ < delta := by\n        nlinarith [sq_nonneg ‖hd.toLp dphi - hgs.toLp (planarGradient psi)‖,norm_nonneg (hp.toLp phi - hps.toLp psi)]\n      have hg : ‖hd.toLp dphi - hgs.toLp (planarGradient psi)‖ < delta := by\n        nlinarith [sq_nonneg ‖hp.toLp phi - hps.toLp psi‖,norm_nonneg (hd.toLp dphi - hgs.toLp (planarGradient psi))]\n      have hz : inner ℝ (hP.toLp P) (hgs.toLp (planarGradient psi)) -\n          inner ℝ (hQ.toLp Q) (hps.toLp psi) = 0 := by\n        rw [← pair E2 P (planarGradient psi) hP hgs,← pair ℝ Q psi hQ hps]\n        simpa only [RCLike.inner_apply,conj_trivial,mul_comm] using sub_eq_zero.mpr (htest psi hs hc hu)\n      have hdiff : I = inner ℝ (hP.toLp P) (hd.toLp dphi - hgs.toLp (planarGradient psi)) -\n          inner ℝ (hQ.toLp Q) (hp.toLp phi - hps.toLp psi) := by\n        rw [inner_sub_right,inner_sub_right]\n        dsimp only [I]\n        linarith\n      have hb : |I| ≤ (‖hP.toLp P‖ + ‖hQ.toLp Q‖) * delta := by\n        rw [hdiff,← Real.norm_eq_abs]\n        apply (norm_sub_le _ _).trans\n        apply (add_le_add (norm_inner_le_norm _ _) (norm_inner_le_norm _ _)).trans\n        nlinarith [norm_nonneg (hP.toLp P),norm_nonneg (hQ.toLp Q)]\n      have hdeltac : 2 * C * delta = |I| := by\n        dsimp only [delta]\n        field_simp\n      dsimp only [C] at hdeltac\n      nlinarith [norm_nonneg (hP.toLp P),norm_nonneg (hQ.toLp Q)]\n    dsimp only [I] at hI\n    rw [← pair E2 P dphi hP hd,← pair ℝ Q phi hQ hp] at hI\n    simpa only [I,RCLike.inner_apply,conj_trivial,mul_comm] using sub_eq_zero.mp hI\n  have hUopen : IsOpen (halfDisc r) := Metric.isOpen_ball.inter\n    (isOpen_lt continuous_const (EuclideanSpace.proj (𝕜 := ℝ) (ι := Fin 2) 1).continuous)\n  have hUmeas : MeasurableSet (halfDisc r) := hUopen.measurableSet\n  letI : IsFiniteMeasure (volume.restrict (halfDisc r)) := isFiniteMeasure_restrict.mpr\n    (((Metric.isBounded_ball (x := (0 : E2)) (r := r)).subset fun y hy => hy.1).measure_lt_top.ne)\n  have hclosed : halfDisc r ⊆ closedHalfDisc r := fun y hy =>\n    ⟨Metric.ball_subset_closedBall hy.1,hy.2.le⟩\n  have ha : ∀ i j, Continuous (fun y => a y i j) := fun i j =>\n    (coefficient_holder i j).continuous gamma_positive\n  have hb : ∀ y i j, |a y i j| ≤ Lambda := fun y i j => (bounds y 0).2 i j\n  have he : MemLp e 2 (volume.restrict (halfDisc r)) := MemLp.of_bound\n    (((forcing_holder.continuousOn gamma_positive).mono hclosed).aestronglyMeasurable hUmeas)\n    Be (by filter_upwards [ae_restrict_mem hUmeas] with y hy; exact forcing_bound y (hclosed hy))\n  have hv : MemLp v 2 (volume.restrict (halfDisc r)) := weak_equation.1.2.1\n  have hd : MemLp dv 2 (volume.restrict (halfDisc r)) := weak_equation.1.2.2\n  have htrace := flat_trace chi chi_smooth chi_compact chi_support\n  have hlead : MemLp (fun y => matrixAction (a y) (cutoffGradient chi v dv y))\n      2 (volume.restrict (halfDisc r)) := operatorLp 2 _ a Lambda ha hb _ htrace.1.2.2\n  obtain ⟨hchi,hgrad⟩ := smoothTop (halfDisc r) chi chi_smooth chi_compact\n  have hag : MemLp (fun y => matrixAction (a y) (planarGradient chi y))\n      ∞ (volume.restrict (halfDisc r)) := operatorLp (∞ : ℝ≥0∞) _ a Lambda ha hb _ hgrad\n  have hflux : MemLp (cutoffFlux a chi e v) 2 (volume.restrict (halfDisc r)) := by\n    exact (hchi.smul he).add (hv.smul hag)\n  have hscalar : MemLp (cutoffScalar a chi e dv) 2 (volume.restrict (halfDisc r)) :=\n    scalarLp _ a chi e dv he (operatorLp 2 _ a Lambda ha hb _ hd) hgrad\n  have testIntegrability (phi : E2 → ℝ) (dphi : E2 → E2)\n      (hp : MemLp phi 2 (volume.restrict (halfDisc r)))\n      (hdp : MemLp dphi 2 (volume.restrict (halfDisc r))) :\n      IntegrableOn (fun y => inner ℝ (matrixAction (a y) (cutoffGradient chi v dv y)) (dphi y)) (halfDisc r) ∧\n      IntegrableOn (fun y => inner ℝ (cutoffFlux a chi e v y) (dphi y) + cutoffScalar a chi e dv y * phi y) (halfDisc r) := by\n    exact ⟨pairingInt _ _ _ hlead hdp,(pairingInt _ _ _ hflux hdp).add (hscalar.integrable_mul hp)⟩\n  have smoothTest (psi : E2 → ℝ) (hs : ContDiff ℝ ∞ psi) (hc : HasCompactSupport psi)\n      (hu : tsupport psi ⊆ halfDisc r) :\n      (∫ y in halfDisc r, inner ℝ (matrixAction (a y) (cutoffGradient chi v dv y)) (planarGradient psi y)) =\n      ∫ y in halfDisc r, inner ℝ (cutoffFlux a chi e v y) (planarGradient psi y) + cutoffScalar a chi e dv y * psi y := by\n    obtain ⟨hp,hgp⟩ := smoothTop (halfDisc r) psi hs hc\n    have hp2 : MemLp psi 2 (volume.restrict (halfDisc r)) := hp.mono_exponent le_top\n    have hg2 : MemLp (planarGradient psi) 2 (volume.restrict (halfDisc r)) := hgp.mono_exponent le_top\n    obtain ⟨hli,hri⟩ := testIntegrability psi (planarGradient psi) hp2 hg2\n    have hprod := weak_equation.2 (fun y => chi y * psi y) (chi_smooth.mul hs)\n      hc.mul_left (tsupport_mul_subset_right.trans hu)\n    have hprodR : IntegrableOn (fun y => inner ℝ (e y) (planarGradient (fun y => chi y * psi y) y)) (halfDisc r) := by\n      simpa only [zero_mul,add_zero] using hprod.2.1\n    have hprodEq : (∫ y in halfDisc r, inner ℝ (matrixAction (a y) (dv y)) (planarGradient (fun y => chi y * psi y) y)) =\n        ∫ y in halfDisc r, inner ℝ (e y) (planarGradient (fun y => chi y * psi y) y) := by\n      simpa only [zero_mul,add_zero] using hprod.2.2\n    apply sub_eq_zero.mp\n    rw [← integral_sub hli hri]\n    calc\n      _ = ∫ y in halfDisc r, inner ℝ (matrixAction (a y) (dv y)) (planarGradient (fun y => chi y * psi y) y) -\n          inner ℝ (e y) (planarGradient (fun y => chi y * psi y) y) := by\n        apply integral_congr_ae\n        filter_upwards with y\n        change inner ℝ (matrixAction (a y) (chi y • dv y + v y • planarGradient chi y)) (planarGradient psi y) -\n          (inner ℝ (chi y • e y + v y • matrixAction (a y) (planarGradient chi y)) (planarGradient psi y) +\n           inner ℝ (e y - matrixAction (a y) (dv y)) (planarGradient chi y) * psi y) = _\n        rw [prodAlgebra,prodGradient chi psi chi_smooth hs y,inner_sub_left]\n      _ = 0 := by rw [integral_sub hprod.1 hprodR,hprodEq,sub_self]\n  have hweak : WeakDivergenceWithData (halfDisc r) a (cutoffFlux a chi e v) (cutoffScalar a chi e dv)\n      (fun y => chi y * v y) (cutoffGradient chi v dv) := by\n    refine ⟨htrace.1,?_⟩\n    intro psi hs hc hu\n    obtain ⟨hp,hgp⟩ := smoothTop (halfDisc r) psi hs hc\n    exact ⟨(testIntegrability psi _ (hp.mono_exponent le_top) (hgp.mono_exponent le_top)).1,\n      (testIntegrability psi _ (hp.mono_exponent le_top) (hgp.mono_exponent le_top)).2,smoothTest psi hs hc hu⟩\n  refine ⟨htrace,hflux,hscalar,hweak,?_⟩\n  intro phi dphi hphi\n  obtain ⟨hli,hri⟩ := testIntegrability phi dphi hphi.1.2.1 hphi.1.2.2\n  refine ⟨hli,hri,?_⟩\n  have hres := testExtension (halfDisc r)\n    (fun y => matrixAction (a y) (cutoffGradient chi v dv y) - cutoffFlux a chi e v y)\n    (cutoffScalar a chi e dv) (hlead.sub hflux) hscalar (by\n      intro psi hs hc hu\n      obtain ⟨_,hgp⟩ := smooth