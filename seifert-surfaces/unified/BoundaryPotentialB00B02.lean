theorem B02_fixed_perturbation_radius
    (r : ℝ) (radius_positive : 0 < r)
    (gamma : ℝ≥0) (gamma_positive : 0 < gamma) (gamma_lt_one : gamma < 1)
    (Ca : ℝ≥0) (cpert C0 : ℝ) (cpert_positive : 0 < cpert) (C0_positive : 0 < C0) :
    ∃ rho0 : ℝ, 0 < rho0 ∧ rho0 ≤ r ∧
      ∀ rho : ℝ, 0 < rho → rho ≤ rho0 →
        cpert * C0 * (Ca : ℝ) * Real.rpow rho (gamma : ℝ) ≤ 1 / 2 := by
  let k : ℝ := cpert * C0 * (Ca : ℝ)
  have hk : 0 ≤ k := mul_nonneg (mul_pos cpert_positive C0_positive).le Ca.coe_nonneg
  let t : ℝ := (1 / (2 * k + 1)) ^ ((gamma : ℝ)⁻¹)
  have ht : 0 < t := Real.rpow_pos_of_pos (by positivity) _
  have hg : (gamma : ℝ) ≠ 0 := (NNReal.coe_pos.mpr gamma_positive).ne'
  refine ⟨min r t, lt_min radius_positive ht, min_le_left _ _, ?_⟩
  intro rho hrho hrho0
  have hpow : rho ^ (gamma : ℝ) ≤ 1 / (2 * k + 1) := by
    calc
      _ ≤ t ^ (gamma : ℝ) := Real.rpow_le_rpow hrho.le (hrho0.trans (min_le_right _ _)) gamma.coe_nonneg
      _ = _ := Real.rpow_inv_rpow (by positivity) hg
  change k * rho ^ (gamma : ℝ) ≤ _
  have hbound := mul_le_mul_of_nonneg_left hpow hk
  have hsmall : k * (1 / (2 * k + 1)) ≤ (1 / 2 : ℝ) := by
    rw [mul_one_div]
    apply (div_le_iff₀ (show 0 < 2 * k + 1 by positivity)).mpr
    linarith
  exact hbound.trans hsmall

