def cutoffFlux (a : E2 → Mat2) (chi : E2 → ℝ) (e : E2 → E2)
    (v : E2 → ℝ) (y : E2) : E2 :=
  chi y • e y + v y • matrixAction (a y) (planarGradient chi y)

def cutoffScalar (a : E2 → Mat2) (chi : E2 → ℝ)
    (e dv : E2 → E2) (y : E2) : ℝ :=
  inner ℝ (e y - matrixAction (a y) (dv y)) (planarGradient chi y)

def frozenField (a : E2 → Mat2) (center : E2) (eta : E2 → ℝ) (y : E2) : Mat2 :=
  a center + eta y • (a y - a center)

def symmetricPart (A : Mat2) : Mat2 := (1 / 2 : ℝ) • (A + A.transpose)

section OriginalData
variable (r : ℝ) (radius_positive : 0 < r)
  (gamma : ℝ≥0) (gamma_positive : 0 < gamma) (gamma_lt_one : gamma < 1)
  (a : E2 → Mat2) (ell Lambda : ℝ) (ell_positive : 0 < ell)
  (Lambda_positive : 0 < Lambda)
  (bounds : ∀ y : E2, ∀ p : E2,
    ell * ‖p‖ ^ 2 ≤ inner ℝ p (matrixAction (a y) p) ∧
      (∀ i j, |a y i j| ≤ Lambda))
  (Ca : ℝ≥0) (coefficient_holder : ∀ i j, HolderWith Ca gamma (fun y => a y i j))
  (e : E2 → E2) (v : E2 → ℝ) (dv : E2 → E2)
  (Be : ℝ) (Be_nonnegative : 0 ≤ Be) (Ce : ℝ≥0)
  (forcing_bound : ∀ y ∈ closedHalfDisc r, ‖e y‖ ≤ Be)
  (forcing_holder : HolderOnWith Ce gamma e (closedHalfDisc r))
  (weak_equation : WeakDivergenceWithData (halfDisc r) a e (fun _ => 0) v dv)
  (flat_trace : FlatZeroTrace r v dv)
include radius_positive gamma_positive gamma_lt_one ell_positive Lambda_positive
  bounds coefficient_holder Be_nonnegative forcing_bound forcing_holder weak_equation flat_trace

theorem B00_native_H10_testing :
    MemLp (fun y => matrixAction (a y) (dv y)) 2 (volume.restrict (halfDisc r)) ∧
    MemLp e 2 (volume.restrict (halfDisc r)) ∧
    ∀ (phi : E2 → ℝ) (dphi : E2 → E2), H10On (halfDisc r) phi dphi →
      IntegrableOn (fun y => inner ℝ (matrixAction (a y) (dv y)) (dphi y)) (halfDisc r) ∧
      IntegrableOn (fun y => inner ℝ (e y) (dphi y)) (halfDisc r) ∧
      (∫ y in halfDisc r, inner ℝ (matrixAction (a y) (dv y)) (dphi y)) =
        ∫ y in halfDisc r, inner ℝ (e y) (dphi y) := by run_tac do Lean.Elab.Tactic.evalTactic (← Lean.ofExcept (Lean.Parser.runParserCategory (← Lean.getEnv) `tactic "exact (by\n  set_option maxHeartbeats 2000000 in\n    classical\n    let U := halfDisc r\n    let mu := volume.restrict U\n    have hU : MeasurableSet U := by\n      change MeasurableSet (Metric.ball (0 : E2) r ∩ {y : E2 | (0 : ℝ) < y 1})\n      exact (Metric.isOpen_ball.inter (isOpen_lt\n        (continuous_const : Continuous (fun _ : E2 => (0 : ℝ)))\n        (EuclideanSpace.proj (1 : Fin 2)).continuous)).measurableSet\n    have hclosed : IsCompact (closedHalfDisc r) := by\n      apply (isCompact_closedBall (0 : E2) r).inter_right\n      exact isClosed_le continuous_const (EuclideanSpace.proj (1 : Fin 2)).continuous\n    have hsubset : U ⊆ closedHalfDisc r := by\n      intro y hy\n      exact ⟨Metric.mem_closedBall.mpr (Metric.mem_ball.mp hy.1).le, hy.2.le⟩\n    haveI : IsFiniteMeasure mu := by\n      refine ⟨?_⟩\n      change (volume.restrict U) univ < (⊤ : ℝ≥0∞)\n      rw [Measure.restrict_apply_univ]\n      exact lt_of_le_of_lt (measure_mono (fun y hy => hy.1)) measure_ball_lt_top\n    have bounded_mem (f : E2 → E2) (hf : ContinuousOn f (closedHalfDisc r))\n        (C : ℝ) (hb : ∀ y ∈ closedHalfDisc r, ‖f y‖ ≤ C) : MemLp f 2 mu := by\n      apply MemLp.of_bound ((hf.mono hsubset).aestronglyMeasurable hU) C\n      filter_upwards [ae_restrict_mem hU] with y hy\n      exact hb y (hsubset hy)\n    have hE : MemLp e 2 mu :=\n      bounded_mem e (forcing_holder.continuousOn gamma_positive) Be forcing_bound\n    have hDV : MemLp dv 2 mu := weak_equation.1.2.2\n    have matrix_bound (A : Mat2) (delta : ℝ) (hdelta : 0 ≤ delta)\n        (hA : ∀ i j, |A i j| ≤ delta) (p : E2) :\n        ‖matrixAction A p‖ ≤ 2 * delta * ‖p‖ := by\n      have hcoordinate (i : Fin 2) : |matrixAction A p i| ≤ delta * (|p 0| + |p 1|) := by\n        dsimp only [matrixAction]\n        simp only [Fin.sum_univ_two]\n        change |A i 0 * p 0 + A i 1 * p 1| ≤ _\n        rw [mul_add]\n        exact (abs_add_le _ _).trans (by\n          rw [abs_mul, abs_mul]\n          exact add_le_add (mul_le_mul_of_nonneg_right (hA i 0) (abs_nonneg _))\n            (mul_le_mul_of_nonneg_right (hA i 1) (abs_nonneg _)))\n      have h0 := pow_le_pow_left₀ (abs_nonneg (matrixAction A p 0)) (hcoordinate 0) 2\n      have h1 := pow_le_pow_left₀ (abs_nonneg (matrixAction A p 1)) (hcoordinate 1) 2\n      have hnorm : ‖matrixAction A p‖ ^ 2 = (matrixAction A p 0) ^ 2 + (matrixAction A p 1) ^ 2 := by\n        rw [EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_two]\n      have hp : ‖p‖ ^ 2 = (p 0) ^ 2 + (p 1) ^ 2 := by\n        rw [EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_two]\n      have habs : (|p 0| + |p 1|) ^ 2 ≤ 2 * ‖p‖ ^ 2 := by\n        rw [hp]\n        nlinarith [sq_nonneg (|p 0| - |p 1|), sq_abs (p 0), sq_abs (p 1)]\n      have hscaled := mul_le_mul_of_nonneg_left habs (sq_nonneg delta)\n      have hsq : ‖matrixAction A p‖ ^ 2 ≤ (2 * delta * ‖p‖) ^ 2 := by\n        rw [hnorm]\n        rw [sq_abs] at h0 h1\n        nlinarith\n      exact (sq_le_sq₀ (norm_nonneg _) (by positivity)).mp hsq\n    have ha : Continuous a := continuous_pi fun i => continuous_pi fun j =>\n      (coefficient_holder i j).continuous gamma_positive\n    have hma : Continuous (fun z : Mat2 × E2 => matrixAction z.1 z.2) := by\n      unfold matrixAction\n      fun_prop\n    letI : TopologicalSpace.PseudoMetrizableSpace Mat2 := by\n      change TopologicalSpace.PseudoMetrizableSpace (Fin 2 → Fin 2 → ℝ)\n      infer_instance\n    have hAmeas : AEStronglyMeasurable (fun y => matrixAction (a y) (dv y)) mu :=\n      hma.comp_aestronglyMeasurable (ha.aestronglyMeasurable.prodMk hDV.aestronglyMeasurable)\n    have hA : MemLp (fun y => matrixAction (a y) (dv y)) 2 mu := by\n      apply (hDV.norm.const_mul (2 * Lambda)).mono' hAmeas\n      exact Eventually.of_forall fun y => matrix_bound (a y) Lambda Lambda_positive.le\n        (bounds y 0).2 (dv y)\n    have pair (f g : E2 → E2) (hf : MemLp f 2 mu) (hg : MemLp g 2 mu) :\n        Integrable (fun y => inner ℝ (f y) (g y)) mu ∧\n        (∫ y, inner ℝ (f y) (g y) ∂mu) = inner ℝ (hf.toLp f) (hg.toLp g) := by\n      refine ⟨(L2.integrable_inner (𝕜 := ℝ) (hf.toLp f) (hg.toLp g)).congr ?_, ?_⟩\n      · filter_upwards [hf.coeFn_toLp, hg.coeFn_toLp] with y hy hy'\n        rw [hy, hy']\n      · rw [L2.inner_def]\n        apply integral_congr_ae\n        filter_upwards [hf.coeFn_toLp, hg.coeFn_toLp] with y hy hy'\n        rw [hy, hy']\n    let Q : E2 → E2 := fun y => matrixAction (a y) (dv y) - e y\n    have hQ : MemLp Q 2 mu := hA.sub hE\n    have htest (psi : E2 → ℝ) (hs : ContDiff ℝ ∞ psi) (hc : HasCompactSupport psi)\n        (ht : tsupport psi ⊆ U) : (∫ y, inner ℝ (Q y) (planarGradient psi y) ∂mu) = 0 := by\n      obtain ⟨hiA, hiE, heq⟩ := weak_equation.2 psi hs hc ht\n      have hiE' : Integrable (fun y => inner ℝ (e y) (planarGradient psi y)) mu := by\n        change IntegrableOn (fun y => inner ℝ (e y) (planarGradient psi y)) (halfDisc r)\n        simpa only [zero_mul, add_zero] using hiE\n      have heq' : (∫ y, inner ℝ (matrixAction (a y) (dv y)) (planarGradient psi y) ∂mu) =\n          ∫ y, inner ℝ (e y) (planarGradient psi y) ∂mu := by\n        simpa only [zero_mul, add_zero] using heq\n      change (∫ y, inner ℝ (matrixAction (a y) (dv y) - e y) (planarGradient psi y) ∂mu) = 0\n      simp_rw [inner_sub_left]\n      rw [integral_sub hiA hiE', heq', sub_self]\n    refine ⟨hA, hE, ?_⟩\n    intro phi dphi hphi\n    have hdphi : MemLp dphi 2 mu := hphi.1.2.2\n    refine ⟨(pair _ _ hA hdphi).1, (pair _ _ hE hdphi).1, ?_⟩\n    have hzero : (∫ y, inner ℝ (Q y) (dphi y) ∂mu) = 0 := by\n      by_contra hn\n      let I := ∫ y, inner ℝ (Q y) (dphi y) ∂mu\n      let qLp := hQ.toLp Q\n      let c : ℝ := |I| / (‖qLp‖ + 1)\n      have hI : 0 < |I| := abs_pos.mpr hn\n      have hden : 0 < ‖qLp‖ + 1 := by positivity\n      have hc : 0 < c := div_pos hI hden\n      obtain ⟨psi, hs, hsupp, ht, herr⟩ := hphi.2 (c ^ 2) (sq_pos_of_pos hc)\n      obtain ⟨C, hC⟩ := hclosed.exists_bound_of_continuousOn (continuous_planarGradient hs).continuousOn\n      have hpsiGrad : MemLp (planarGradient psi) 2 mu :=\n        bounded_mem _ (continuous_planarGradient hs).continuousOn C hC\n      have hpsi : MemLp psi 2 mu := by\n        obtain ⟨C', hC'⟩ := hclosed.exists_bound_of_continuousOn hs.continuous.continuousOn\n        apply MemLp.of_bound hs.continuous.aestronglyMeasurable C'\n        filter_upwards [ae_restrict_mem hU] with y hy\n        exact hC' y (hsubset hy)\n      let D : E2 → E2 := fun y => dphi y - planarGradient psi y\n      have hD : MemLp D 2 mu := hdphi.sub hpsiGrad\n      let dLp := hD.toLp D\n      have hnormD : ‖dLp‖ ^ 2 = ∫ y, ‖D y‖ ^ 2 ∂mu := by\n        rw [← real_inner_self_eq_norm_sq, L2.inner_def]\n        apply integral_congr_ae\n        filter_upwards [hD.coeFn_toLp] with y hy\n        rw [hy, real_inner_self_eq_norm_sq]\n      have hgraderror : (∫ y, ‖D y‖ ^ 2 ∂mu) < c ^ 2 := by\n        apply lt_of_le_of_lt _ herr\n        have huerr : Integrable (fun y => |phi y - psi y| ^ 2) mu := by\n          change Integrable (fun y => |phi y - psi y| ^ 2) (volume.restrict (halfDisc r))\n          simpa only [sq_abs, Pi.sub_apply] using (hphi.1.2.1.sub hpsi).integrable_sq\n        apply integral_mono (hD.integrable_norm_pow (by norm_num : (2:ℕ) ≠ 0))\n          (huerr.add (hD.integrable_norm_pow (by norm_num : (2:ℕ) ≠ 0)))\n        intro y\n        exact le_add_of_nonneg_left (sq_nonneg _)\n      have hdsmall : ‖dLp‖ < c :=\n        (sq_lt_sq₀ (norm_nonneg _) hc.le).mp (hnormD.trans_lt hgraderror)\n      have hpsiPair : inner ℝ qLp (hpsiGrad.toLp (planarGradient psi)) = 0 := by\n        rw [← (pair _ _ hQ hpsiGrad).2]\n        exact htest psi hs hsupp ht\n      have hId : inner ℝ qLp dLp = I := by\n        change inner ℝ (hQ.toLp Q) ((hdphi.sub hpsiGrad).toLp (dphi - planarGradient psi)) = I\n        rw [hdphi.toLp_sub hpsiGrad, inner_sub_right, hpsiPair, sub_zero]\n        exact (pair _ _ hQ hdphi).2.symm\n      have hbound : |I| ≤ ‖qLp‖ * c := by\n        rw [← hId]\n        exact (abs_real_inner_le_norm _ _).trans\n          (mul_le_mul_of_nonneg_left hdsmall.le (norm_nonneg _))\n      have hstrict : ‖qLp‖ * c < |I| := by\n        have hh := mul_lt_mul_of_pos_right (by linarith : ‖qLp‖ < ‖qLp‖ + 1) hc\n        apply hh.trans_eq\n        dsimp [c]\n        field_simp (disch := positivity)\n      exact (hbound.trans_lt hstrict).false\n    have hsub : (∫ y, inner ℝ (Q y) (dphi y) ∂mu) =\n        (∫ y, inner ℝ (matrixAction (a y) (dv y)) (dphi y) ∂mu) -\n          ∫ y, inner ℝ (e y) (dphi y) ∂mu := by\n      dsimp only [Q]\n      simp_rw [inner_sub_left]\n      exact integral_sub (pair _ _ hA hdphi).1 (pair _ _ hE hdphi).1\n    exact sub_eq_zero.mp (hsub.symm.trans hzero)\n\n)"))

theorem B00_local_restriction (U : Set E2) (U_open : IsOpen U) (U_subset : U ⊆ halfDisc r) :
    H1On U v dv ∧ WeakDivergenceWithData U a e (fun _ => 0) v dv ∧
      MemLp (fun y => matrixAction (a y) (dv y)) 2 (volume.restrict U) ∧
      MemLp e 2 (volume.restrict U) := by run_tac do Lean.Elab.Tactic.evalTactic (← Lean.ofExcept (Lean.Parser.runParserCategory (← Lean.getEnv) `tactic "exact (by\n  have hH1 : H1On U v dv := by\n    refine ⟨⟨weak_equation.1.1.1.mono_set U_subset,\n      weak_equation.1.1.2.1.mono_set U_subset, ?_⟩,\n      weak_equation.1.2.1.mono_measure (Measure.restrict_mono U_subset le_rfl),\n      weak_equation.1.2.2.mono_measure (Measure.restrict_mono U_subset le_rfl)⟩\n    intro phi hp hc hs i\n    have hd : tsupport (fun x => fderiv ℝ phi x (coordinateVector 2 i)) ⊆ U :=\n      (tsupport_fderiv_apply_subset ℝ _).trans hs\n    have h0 : ∀ x ∉ U, v x * fderiv ℝ phi x (coordinateVector 2 i) = 0 := by\n      intro x hx\n      rw [image_eq_zero_of_notMem_tsupport (fun h => hx (hd h)), mul_zero]\n    have h1 : ∀ x ∉ U, dv x i * phi x = 0 := by\n      intro x hx\n      rw [image_eq_zero_of_notMem_tsupport (fun h => hx (hs h)), mul_zero]\n    have hi := weak_equation.1.1.2.2 phi hp hc (hs.trans U_subset) i\n    rw [setIntegral_eq_integral_of_forall_compl_eq_zero h0,\n      setIntegral_eq_integral_of_forall_compl_eq_zero h1]\n    rw [setIntegral_eq_integral_of_forall_compl_eq_zero\n        (fun x hx => h0 x (fun hu => hx (U_subset hu))),\n      setIntegral_eq_integral_of_forall_compl_eq_zero\n        (fun x hx => h1 x (fun hu => hx (U_subset hu)))] at hi\n    exact hi\n  have hweak : WeakDivergenceWithData U a e (fun _ => 0) v dv := by\n    refine ⟨hH1, ?_⟩\n    intro psi hp hc hs\n    obtain ⟨hleft, hright, heq⟩ := weak_equation.2 psi hp hc (hs.trans U_subset)\n    have hzero : ∀ x ∉ U, planarGradient psi x = 0 := by\n      intro x hx\n      exact planarGradient_eq_zero_off_support psi (fun ht => hx (hs ht))\n    have h0 : ∀ x ∉ U, inner ℝ (matrixAction (a x) (dv x)) (planarGradient psi x) = 0 := by\n      intro x hx\n      rw [hzero x hx, inner_zero_right]\n    have h1 : ∀ x ∉ U, inner ℝ (e x) (planarGradient psi x) + (0 : ℝ) * psi x = 0 := by\n      intro x hx\n      rw [hzero x hx, inner_zero_right, zero_mul, add_zero]\n    refine ⟨hleft.mono_set U_subset, hright.mono_set U_subset, ?_⟩\n    rw [setIntegral_eq_integral_of_forall_compl_eq_zero h0,\n      setIntegral_eq_integral_of_forall_compl_eq_zero h1]\n    rw [setIntegral_eq_integral_of_forall_compl_eq_zero\n        (fun x hx => h0 x (fun hu => hx (U_subset hu))),\n      setIntegral_eq_integral_of_forall_compl_eq_zero\n        (fun x hx => h1 x (fun hu => hx (U_subset hu)))] at heq\n    exact heq\n  have hflux : MemLp (fun y => matrixAction (a y) (dv y)) 2 (volume.restrict U) := by\n    have hterm (i j : Fin 2) : MemLp (fun y => a y i j * dv y j) 2 (volume.restrict U) := by\n      have hc : MemLp (fun y => a y i j) ∞ (volume.restrict U) :=\n        memLp_top_of_bound ((coefficient_holder i j).continuous gamma_positive).aestronglyMeasurable\n          Lambda (Eventually.of_forall fun y => by\n            rw [Real.norm_eq_abs]\n            exact (bounds y 0).2 i j)\n      exact hc.mul (hH1.2.2.eval_piLp j)\n    have h0 := ((hterm 0 0).add (hterm 0 1)).continuousLinearMap_comp\n      (ContinuousLinearMap.toSpanSingleton ℝ (coordinateVector 2 0))\n    have h1 := ((hterm 1 0).add (hterm 1 1)).continuousLinearMap_comp\n      (ContinuousLinearMap.toSpanSingleton ℝ (coordinateVector 2 1))\n    apply (h0.add h1).ae_eq\n    apply Eventually.of_forall\n    intro y\n    ext i\n    change (((a y 0 0 * dv y 0 + a y 0 1 * dv y 1) • coordinateVector 2 0 +\n      (a y 1 0 * dv y 0 + a y 1 1 * dv y 1) • coordinateVector 2 1) : E2) i =\n        ∑ j, a y i j * dv y j\n    fin_cases i <;>\n      simp [Fin.sum_univ_two, coordinateVector, EuclideanSpace.single]\n  have hbounded : Bornology.IsBounded U :=\n    Metric.isBounded_ball.subset (U_subset.trans (fun x hx => hx.1))\n  haveI : IsFiniteMeasure (volume.restrict U) :=\n    isFiniteMeasure_restrict.mpr hbounded.measure_lt_top.ne\n  have hecont : ContinuousOn e U :=\n    (forcing_holder.continuousOn gamma_positive).mono\n      (U_subset.trans (fun x hx => ⟨Metric.ball_subset_closedBall hx.1, le_of_lt hx.2⟩))\n  have heLp : MemLp e 2 (volume.restrict U) :=\n    MemLp.of_bound (hecont.aestronglyMeasurable U_open.measurableSet) Be (by\n      filter_upwards [ae_restrict_mem U_open.measurableSet] with y hy\n      exact forcing_bound y ⟨Metric.ball_subset_closedBall (U_subset hy).1,\n        le_of_lt (U_subset hy).2⟩)\n  exact ⟨hH1, hweak, hflux, heLp⟩\n)"))

theorem B00_translated_cutoff_trace
    (center : E2) (center_flat : center 1 = 0) (rho : ℝ) (rho_positive : 0 < rho)
    (closure_inside : Metric.closedBall center rho ⊆ disc r)
    (chi : E2 → ℝ) (chi_smooth : ContDiff ℝ ∞ chi)
    (chi_compact : HasCompactSupport chi) (chi_support : tsupport chi ⊆ Metric.ball center rho) :
    H10On (Metric.ball center rho ∩ {y : E2 | 0 < y 1})
      (fun y => chi y * v y) (cutoffGradient chi v dv) ∧
    H10On (halfDisc rho) (fun z => chi (z + center) * v (z + center))
      (fun z => cutoffGradient chi v dv (z + center)) := by run_tac do Lean.Elab.Tactic.evalTactic (← Lean.ofExcept (Lean.Parser.runParserCategory (← Lean.getEnv) `tactic "exact (by\n  let U := Metric.ball center rho ∩ {y : E2 | 0 < y 1}\n  let w := fun y => chi y * v y\n  let dw := cutoffGradient chi v dv\n  have hU : IsOpen U := Metric.isOpen_ball.inter (isOpen_lt continuous_const (by fun_prop))\n  have hW : IsOpen (halfDisc r) := by\n    change IsOpen (Metric.ball (0 : E2) r ∩ {y : E2 | 0 < y 1})\n    exact Metric.isOpen_ball.inter (isOpen_lt continuous_const (by fun_prop))\n  have hin : U ⊆ halfDisc r := fun y hy =>\n    ⟨closure_inside (Metric.ball_subset_closedBall hy.1), hy.2⟩\n  have hchi : tsupport chi ⊆ disc r :=\n    chi_support.trans (Metric.ball_subset_closedBall.trans closure_inside)\n  have hw : H10On (halfDisc r) w dw := flat_trace chi chi_smooth chi_compact hchi\n  have hH1 : H1On U w dw := by\n    refine ⟨⟨hw.1.1.1.mono_set hin, hw.1.1.2.1.mono_set hin, ?_⟩,\n      hw.1.2.1.mono_measure (Measure.restrict_mono hin le_rfl),\n      hw.1.2.2.mono_measure (Measure.restrict_mono hin le_rfl)⟩\n    intro phi hp hc hs i\n    have hd : tsupport (fun x => fderiv ℝ phi x (coordinateVector 2 i)) ⊆ U :=\n      (tsupport_fderiv_apply_subset ℝ _).trans hs\n    have h0 : ∀ x ∉ U, w x * fderiv ℝ phi x (coordinateVector 2 i) = 0 := by\n      intro x hx\n      rw [image_eq_zero_of_notMem_tsupport (fun h => hx (hd h)), mul_zero]\n    have h1 : ∀ x ∉ U, dw x i * phi x = 0 := by\n      intro x hx\n      rw [image_eq_zero_of_notMem_tsupport (fun h => hx (hs h)), mul_zero]\n    have hi := hw.1.1.2.2 phi hp hc (hs.trans hin) i\n    rw [setIntegral_eq_integral_of_forall_compl_eq_zero h0,\n      setIntegral_eq_integral_of_forall_compl_eq_zero h1]\n    rw [setIntegral_eq_integral_of_forall_compl_eq_zero\n        (fun x hx => h0 x (fun hu => hx (hin hu))),\n      setIntegral_eq_integral_of_forall_compl_eq_zero\n        (fun x hx => h1 x (fun hu => hx (hin hu)))] at hi\n    exac