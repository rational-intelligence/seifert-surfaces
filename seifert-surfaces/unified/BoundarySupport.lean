/-- Only the internally supported continuous data are extended.
No value or tangential component is required to vanish on the flat edge. -/
theorem positive_reflection_holder
    (x : E2) (flat_center : x 1 = 0) (rho : ℝ) (rho_positive : 0 < rho)
    (gamma : ℝ≥0) (gamma_positive : 0 < gamma) (gamma_lt_one : gamma < 1) :
    ∃ Cext : ℝ, 0 < Cext ∧
      ∀ (E : E2 → E2) (B : ℝ), 0 ≤ B → ∀ CE : ℝ≥0,
      (∀ y ∈ closedPatch x rho, ‖E y‖ ≤ B) →
      HolderOnWith CE gamma E (closedPatch x rho) →
      (∀ y ∈ closedPatch x rho, y ∉ supportMargin x rho → E y = 0) →
      (∀ y ∈ curvedEdge x rho, E y = 0) ∧
      (∀ y ∈ closedPatch x rho, positiveExtension x rho E (y - x) = E y) ∧
      (∀ y ∈ flatEdge x rho, positiveExtension x rho E (y - x) = E y) ∧
      (∀ y, ‖positiveExtension x rho E y‖ ≤ B) ∧
      tsupport (positiveExtension x rho E) ⊆ Metric.closedBall 0 (7 * rho / 4) ∧
      ∃ C : ℝ≥0, (C : ℝ) ≤ Cext * ((CE : ℝ) + Real.rpow rho (-(gamma : ℝ)) * B) ∧
        HolderWith C gamma (positiveExtension x rho E) := by classical { let q : E2 → E2 := fun y => (EuclideanSpace.equiv (Fin 2) ℝ).symm (fun i => if i = 1 then |y i| else y i); have hq1 : ∀ y, q y 1 = |y 1| := by { intro y; simp [q] }; have hqpos : ∀ y, 0 ≤ q y 1 := fun y => hq1 y ▸ abs_nonneg _; have hqn : ∀ y, ‖q y‖ = ‖y‖ := by { intro y; apply (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).mp; simp [EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_two, q, sq_abs] }; have hqd : ∀ y z, dist (q y) (q z) ≤ dist y z := by { intro y z; apply (sq_le_sq₀ (dist_nonneg) (dist_nonneg)).mp; simp only [dist_eq_norm, EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_two, PiLp.sub_apply]; have h := pow_le_pow_left₀ (abs_nonneg (|y 1| - |z 1|)) (abs_abs_sub_abs_le_abs_sub (y 1) (z 1)) 2; simp [q, sq_abs] at h ⊢; linarith }; have hqeq : ∀ y, q y = if 0 ≤ y 1 then y else reflect y := by { intro y; split_ifs with hy; { ext i; change (if i = 1 then |y i| else y i) = y i; split_ifs with hi; { subst i; exact abs_of_nonneg hy }; { rfl } }; { ext i; change (if i = 1 then |y i| else y i) = (if i = 1 then -y i else y i); split_ifs with hi; { subst i; exact abs_of_neg (lt_of_not_ge hy) }; { rfl } } }; have hval : ∀ E y, positiveExtension x rho E y = if ‖y‖ ≤ 2*rho then E (x+q y) else 0 := by { intro E y; simp [positiveExtension, hqeq]; split_ifs <;> rfl }; have hpatch : ∀ y, ‖y‖ ≤ 2*rho → x+q y ∈ closedPatch x rho := by { intro y hy; simp [closedPatch, dist_eq_norm, PiLp.add_apply, flat_center, hqn, hqpos, hy] }; let K : ℝ := ((4 : ℝ) ^ (gamma : ℝ)); have hK : 0 < K := Real.rpow_pos_of_pos (by norm_num) _; refine ⟨1 + K, by positivity, ?_⟩; intro E B hB CE hbound hholder hsupport; have hzero : ∀ y, 7*rho/4 < ‖y‖ → positiveExtension x rho E y = 0 := by { intro y hy; rw [hval]; split_ifs with hn; { apply hsupport _ (hpatch y hn); intro hm; have hd : dist (x+q y) x = ‖y‖ := by { simp [dist_eq_norm, hqn] }; change dist (x+q y) x ≤ 7*rho/4 ∧ 0 ≤ (x+q y) 1 at hm; rw [hd] at hm; exact (not_le_of_gt hy) hm.1 }; { rfl } }; have hnorm : ∀ y, ‖positiveExtension x rho E y‖ ≤ B := by { intro y; rw [hval]; split_ifs with hy; { exact hbound _ (hpatch y hy) }; { simpa using hB } }; refine ⟨?_, ?_, ?_, hnorm, ?_, ?_⟩; { intro y hy; apply hsupport y ⟨hy.1.le, hy.2⟩; intro hm; have := hm.1; dsimp [curvedEdge] at hy; linarith [rho_positive] }; { intro y hy; have hn : ‖y-x‖ ≤ 2*rho := by { simpa [dist_eq_norm] using hy.1 }; have hp : 0 ≤ (y-x) 1 := by { simpa [PiLp.sub_apply, flat_center] using hy.2 }; simp only [positiveExtension, ite_eq_left hn, ite_eq_left hp]; congr 1; abel }; { intro y hy; have hn : ‖y-x‖ ≤ 2*rho := by { simpa [dist_eq_norm] using hy.1.le }; have hp : 0 ≤ (y-x) 1 := by { simp [PiLp.sub_apply, flat_center, hy.2] }; simp only [positiveExtension, ite_eq_left hn, ite_eq_left hp]; congr 1; abel }; { apply closure_minimal; { intro y hy; by_contra hout; have hn : 7*rho/4 < ‖y‖ := by { simpa [Metric.mem_closedBall, dist_eq_norm] using hout }; exact hy (hzero y hn) }; { exact Metric.isClosed_closedBall } }; { let D : ℝ := (CE : ℝ) + K * (rho ^ (-(gamma : ℝ))) * B; have hpow : 0 < (rho ^ (gamma : ℝ)) := Real.rpow_pos_of_pos rho_positive _; have hpowneg : 0 < (rho ^ (-(gamma : ℝ))) := Real.rpow_pos_of_pos rho_positive _; have hD : 0 ≤ D := by { dsimp [D]; positivity }; let C : ℝ≥0 := ⟨D, hD⟩; refine ⟨C, ?_, ?_⟩; { change D ≤ (1+K)*((CE : ℝ)+(rho ^ (-(gamma : ℝ)))*B); dsimp [D]; nlinarith [mul_nonneg hK.le CE.coe_nonneg, mul_nonneg hpowneg.le hB] }; { have hscale : K * (rho ^ (-(gamma : ℝ))) * ((rho/4) ^ (gamma : ℝ)) = 1 := by { rw [Real.div_rpow rho_positive.le (by norm_num), Real.rpow_neg rho_positive.le]; change K * ((rho ^ (gamma : ℝ)))⁻¹ * ((rho ^ (gamma : ℝ)) / K) = 1; field_simp [ne_of_gt hpow, ne_of_gt hK] }; have hCE : (CE : ℝ) ≤ D := by { dsimp [D]; exact le_add_of_nonneg_right (by positivity) }; have hmixed : ∀ y z, ‖y‖ ≤ 2*rho → 2*rho < ‖z‖ → dist (positiveExtension x rho E y) (positiveExtension x rho E z) ≤ D * (dist y z ^ (gamma : ℝ)) := by { intro y z hy hz; have ez : positiveExtension x rho E z = 0 := by { rw [hval]; simp [not_le_of_gt hz] }; by_cases hm : 7*rho/4 < ‖y‖; { rw [hzero y hm, ez, dist_self]; positivity }; { have hd : rho/4 ≤ dist y z := by { have hn := norm_sub_norm_le z y; rw [← dist_eq_norm, dist_comm z y] at hn; push Not at hm; linarith }; have hmultip : 1 ≤ K * (rho ^ (-(gamma : ℝ))) * (dist y z ^ (gamma : ℝ)) := by { rw [← hscale]; exact mul_le_mul_of_nonneg_left (Real.rpow_le_rpow (by positivity) hd gamma.coe_nonneg) (by positivity) }; have hb : B ≤ K * (rho ^ (-(gamma : ℝ))) * B * (dist y z ^ (gamma : ℝ)) := by { nlinarith [mul_le_mul_of_nonneg_right hmultip hB] }; rw [ez, dist_zero_right]; exact (hnorm y).trans (hb.trans (by dsimp [D]; nlinarith [mul_nonneg CE.coe_nonneg (Real.rpow_nonneg (dist_nonneg (x := y) (y := z)) (gamma : ℝ))])) } }; have hreal : ∀ y z, dist (positiveExtension x rho E y) (positiveExtension x rho E z) ≤ D * (dist y z ^ (gamma : ℝ)) := by { intro y z; by_cases hy : ‖y‖ ≤ 2*rho <;> by_cases hz : ‖z‖ ≤ 2*rho; { have h := hholder.dist_le_of_le (hpatch y hy) (hpatch z hz) (show dist (x+q y) (x+q z) ≤ dist y z by simpa only [dist_add_left] using hqd y z); simp only [hval, ite_eq_left hy, ite_eq_left hz]; exact h.trans (mul_le_mul_of_nonneg_right hCE (Real.rpow_nonneg (dist_nonneg) _)) }; { exact hmixed y z hy (lt_of_not_ge hz) }; { simpa only [dist_comm] using hmixed z y hz (lt_of_not_ge hy) }; { simp only [hval, ite_eq_right hy, ite_eq_right hz, dist_self]; positivity } }; intro y z; rw [ENNReal.coe_nnreal_eq C, edist_dist, edist_dist, ENNReal.ofReal_rpow_of_nonneg (dist_nonneg) gamma.coe_nonneg]; change ENNReal.ofReal (dist (positiveExtension x rho E y) (positiveExtension x rho E z)) ≤ ENNReal.ofReal D * ENNReal.ofReal (dist y z ^ (gamma : ℝ)); rw [← ENNReal.ofReal_mul hD]; exact ENNReal.ofReal_le_ofReal (hreal y z) } } }

/-- Scalar reflection uses actual Lp membership; no pointwise boundary
representative or Hölder property of F is assumed. -/
theorem negative_reflection_lp
    (x : E2) (flat_center : x 1 = 0) (rho : ℝ) (rho_positive : 0 < rho)
    (p : ℝ) (p_gt_one : 1 < p) (F : E2 → ℝ)
    (mem : MemLp F (ENNReal.ofReal p) (volume.restrict (patch x rho)))
    (supported : ∀ᵐ y ∂volume.restrict (patch x rho), y ∉ supportMargin x rho → F y = 0) :
    MemLp (negativeExtension x rho F) (ENNReal.ofReal p) volume ∧
    Integrable (negativeExtension x rho F) volume ∧
    (eLpNorm (negativeExtension x rho F) (ENNReal.ofReal p) volume).toReal ≤
      Real.rpow 2 (1 / p) * (eLpNorm F (ENNReal.ofReal p) (volume.restrict (patch x rho))).toReal ∧
    (∀ y, y 1 = 0 → negativeExtension x rho F y = 0) ∧
    (∀ᵐ y ∂volume, y ∉ Metric.closedBall 0 (7 * rho / 4) → negativeExtension x rho F y = 0) ∧
    (∀ G : E2 → ℝ, (∀ y, y 1 ≠ 0 → G y = negativeExtension x rho F y) →
      G =ᵐ[volume] negativeExtension x rho F) := by classical { let R : E2 ≃ₗᵢ[ℝ] E2 := LinearIsometryEquiv.piLpCongrRight 2 (fun i : Fin 2 => if i = 1 then LinearIsometryEquiv.neg ℝ else LinearIsometryEquiv.refl ℝ ℝ); have hR : ∀ y, R y = reflect y := by { intro y; ext i; simp [R, reflect, LinearIsometryEquiv.piLpCongrRight_apply]; split <;> rfl }; have hRn : ∀ y, ‖reflect y‖ = ‖y‖ := fun y => hR y ▸ R.norm_map y; have hR1 : ∀ y, reflect y 1 = -y 1 := by { intro y; simp [reflect] }; have hRm : MeasurePreserving reflect volume volume := by { have hh : (fun y => R y) = reflect := funext hR; rw [← hh]; exact R.measurePreserving }; have hRe : MeasurableEmbedding reflect := by { have hh : (fun y => R y) = reflect := funext hR; rw [← hh]; exact R.toHomeomorph.measurableEmbedding }; have hs : MeasurableSet (patch x rho) := by { exact (measurableSet_lt (continuous_id.dist continuous_const).measurable measurable_const).inter (measurableSet_lt measurable_const (EuclideanSpace.proj (1 : Fin 2)).continuous.measurable) }; let f := (patch x rho).indicator F; let g : E2 → ℝ := fun y => f (x + y); have hf : MemLp f (ENNReal.ofReal p) volume := (memLp_indicator_iff_restrict hs.nullMeasurableSet).mpr mem; have hT := measurePreserving_add_left (volume : Measure E2) x; have hg : MemLp g (ENNReal.ofReal p) volume := hf.comp_measurePreserving hT; have hgR : MemLp (g ∘ reflect) (ENNReal.ofReal p) volume := hg.comp_measurePreserving hRm; have hgval : ∀ y, g y = if ‖y‖ < 2 * rho ∧ 0 < y 1 then F (x+y) else 0 := by { intro y; simp [g, f, Set.indicator, patch, dist_eq_norm, PiLp.add_apply, flat_center] }; have hExt : negativeExtension x rho F = fun y => g y - g (reflect y) := by { funext y; rw [hgval, hgval]; simp only [negativeExtension, hRn, hR1]; by_cases hn : ‖y‖ < 2*rho <;> by_cases hp : 0<y 1 <;> by_cases hm : y 1<0 <;> simp [hn, hp, hm] <;> linarith }; have he : MemLp (negativeExtension x rho F) (ENNReal.ofReal p) volume := by { rw [hExt]; exact hg.sub hgR }; have pp : 0 < p := by { linarith }; have p0 : ENNReal.ofReal p ≠ 0 := ne_of_gt (ENNReal.ofReal_pos.mpr pp); have pfin : ENNReal.ofReal p ≠ (∞ : ℝ≥0∞) := ENNReal.ofReal_ne_top; have hpower : ∀ y, ‖g y - g (reflect y)‖ₑ ^ p = ‖g y‖ₑ ^ p + ‖g (reflect y)‖ₑ ^ p := by { intro y; rw [hgval, hgval]; simp only [hRn, hR1, neg_pos]; by_cases hn : ‖y‖ < 2*rho <;> by_cases hp : 0<y 1 <;> by_cases hm : y 1<0 <;> simp [hn, hp, hm, ENNReal.zero_rpow_of_pos pp] <;> linarith }; have hIntegral : (∫⁻ y, ‖negativeExtension x rho F y‖ₑ ^ p ∂volume) = 2 * (∫⁻ y, ‖g y‖ₑ ^ p ∂volume) := by { rw [hExt, lintegral_congr hpower, lintegral_add_left' (hg.aestronglyMeasurable.enorm.pow_const p), hRm.lintegral_comp_emb hRe (fun z => ‖g z‖ₑ ^ p)]; exact (two_mul _).symm }; have hnorm : eLpNorm (negativeExtension x rho F) (ENNReal.ofReal p) volume = (2 : ℝ≥0∞) ^ (1/p) * eLpNorm F (ENNReal.ofReal p) (volume.restrict (patch x rho)) := by { rw [eLpNorm_eq_lintegral_rpow_enorm_toReal p0 pfin he.aestronglyMeasurable, ENNReal.toReal_ofReal pp.le, hIntegral, ENNReal.mul_rpow_of_nonneg (2 : ℝ≥0∞) _ (by positivity)]; have hgn := eLpNorm_eq_lintegral_rpow_enorm_toReal p0 pfin hg.aestronglyMeasurable; rw [ENNReal.toReal_ofReal pp.le] at hgn; rw [← hgn]; have htNorm : eLpNorm g (ENNReal.ofReal p) volume = eLpNorm f (ENNReal.ofReal p) volume := eLpNorm_comp_measurePreserving hf.aestronglyMeasurable hT; rw [htNorm]; simp only [f, eLpNorm_indicator_eq_eLpNorm_restrict hs.nullMeasurableSet] }; have hnormReal : (eLpNorm (negativeExtension x rho F) (ENNReal.ofReal p) volume).toReal ≤ Real.rpow 2 (1/p) * (eLpNorm F (ENNReal.ofReal p) (volume.restrict (patch x rho))).toReal := by { rw [hnorm, ENNReal.toReal_mul, ← ENNReal.toReal_rpow]; norm_num }; have hfinite : volume (patch x rho) ≠ (∞ : ℝ≥0∞) := (measure_lt_top_of_subset (show patch x rho ⊆ Metric.closedBall x (2*rho) from fun y hy => hy.1.le) measure_closedBall_lt_top.ne).ne; letI : IsFiniteMeasure (volume.restrict (patch x rho)) := isFiniteMeasure_restrict.mpr hfinite; have hfi : Integrable f volume := (integrable_indicator_iff hs).mpr (mem.integrable (by simpa using ENNReal.ofReal_le_ofReal p_gt_one.le)); have hgi : Integrable g volume := hT.integrable_comp_of_integrable hfi; have hei : Integrable (negativeExtension x rho F) volume := by { rw [hExt]; exact hgi.sub (hRm.integrable_comp_of_integrable hgi) }; refine ⟨he, hei, hnormReal, ?_, ?_, ?_⟩; { intro y hy; simp [negativeExtension, hy] }; { have hsup : ∀ᵐ z ∂volume, z ∈ patch x rho → z ∉ supportMargin x rho → F z = 0 := (ae_restrict_iff' hs).mp supported; have hgsup : ∀ᵐ y ∂volume, y ∉ Metric.closedBall 0 (7*rho/4) → g y = 0 := by { filter_upwards [hT.quasiMeasurePreserving.ae hsup] with y hy; intro hout; rw [hgval]; split_ifs with hin; { apply hy; { simp [patch, dist_eq_norm, PiLp.add_apply, flat_center, hin] }; { intro hmargin; apply hout; simpa [Metric.mem_closedBall, dist_eq_norm, supportMargin] using hmargin.1 } }; { rfl } }; filter_upwards [hgsup, hRm.quasiMeasurePreserving.ae hgsup] with y hy hry; intro hout; simp only [hExt, hy hout, hry (by simpa [Metric.mem_closedBall, dist_eq_norm, hRn] using hout), sub_self] }; { intro G hG; let L : E2 →ₗ[ℝ] ℝ := (EuclideanSpace.proj (1 : Fin 2)).toLinearMap; have hL : L.ker ≠ ⊤ := by { intro h; have hz := (LinearMap.ker_eq_top.mp h); have hv := LinearMap.congr_fun hz ((EuclideanSpace.equiv (Fin 2) ℝ).symm (fun _ => 1)); norm_num [L, EuclideanSpace.proj] at hv }; have hz : volume {y : E2 | y 1 = 0} = 0 := by { exact Measure.addHaar_submodule volume L.ker hL }; have hne : ∀ᵐ y : E2 ∂volume, y 1 ≠ 0 := by { simpa only [ae_iff, not_not] using hz }; filter_upwards [hne] with y hy; exact hG y hy } }

/-- The weak-data version keeps support almost everywhere, without imposing
boundary values on a merely Lp divergence datum. -/
theorem positive_reflection_lp
    (x : E2) (flat_center : x 1 = 0) (rho : ℝ) (rho_positive : 0 < rho)
    (p : ℝ) (p_gt_one : 1 < p) (E : E2 → E2)
    (mem : MemLp E (ENNReal.ofReal p) (volume.restrict (patch x rho)))
    (supported : ∀ᵐ y ∂volume.restrict (patch x rho), y ∉ supportMargin x rho → E y = 0) :
    MemLp (positiveExtension x rho E) (ENNReal.ofReal p) volume ∧
    Integrable (positiveExtension x rho E) volume ∧
    (eLpNorm (positiveExtension x rho E) (ENNReal.ofReal p) volume).toReal ≤
      Real.rpow 2 (1 / p) * (eLpNorm E (ENNReal.ofReal p) (volume.restrict (patch x rho))).toReal ∧
    (∀ᵐ y ∂volume, y ∉ Metric.closedBall 0 (7 * rho / 4) → positiveExtension x rho E y = 0) ∧
    (∀ G : E2 → E2, (∀ y, y 1 ≠ 0 → G y = positiveExtension x rho E y) →
      G =ᵐ[volume] positiveExtension x rho E) := by classical { have hp : 0 < p := lt_trans zero_lt_one p_gt_one; have hp0 : ENNReal.ofReal p ≠ 0 := by { positivity }; have hpt : ENNReal.ofReal p ≠ (∞ : ℝ≥0∞) := ENNReal.ofReal_ne_top; have hp1 : 1 ≤ ENNReal.ofReal p := by { rw [← ENNReal.ofReal_one, ENNReal.ofReal_le_ofReal_iff hp.le]; exact p_gt_one.le }; have hpatch : MeasurableSet (patch x rho) := (isOpen_lt (show Continuous (fun y : E2 => dist y x) by { fun_prop }) continuous_const).measurableSet.inter (isOpen_lt (show Continuous (fun _ : E2 => (0 : ℝ)) from continuous_const) (show Continuous (fun y : E2 => y 1) by { fun_prop })).measurableSet; have hrr (y : E2) : reflect (reflect y) = y := by { ext i; fin_cases i <;> (dsimp [reflect]; simp) }; let e : E2 ≃ₗᵢ[ℝ] E2 := { toFun := reflect, invFun := reflect, left_inv := hrr, right_inv := hrr, map_add' := by { intros; ext i; fin_cases i <;> (dsimp [reflect]; simp) <;> ring }, map_smul' := by { intros; ext i; fin_cases i <;> (dsimp [reflect]; simp) }, norm_map' := by { intro y; change ‖reflect y‖ = ‖y‖; have hh : ‖reflect y‖ ^ 2 = ‖y‖ ^ 2 := by { dsimp [reflect]; simp [EuclideanSpace.norm_sq_eq, Fin.sum_univ_two] }; nlinarith [norm_nonneg (reflect y), norm_nonneg y] } }; have hnorm (y : E2) : ‖reflect y‖ = ‖y‖ := e.norm_map y; have hmp : MeasurePreserving reflect volume volume := e.measurePreserving; have htrans : MeasurePreserving (fun y : E2 => x + y) volume volume := measurePreserving_add_left volume x; have hflat : volume {y : E2 | y 1 = 0} = 0 := by { have hm := PiLp.volume_preserving_ofLp (Fin 2); exact (hm.measure_preimage (s := {y : Fin 2 → ℝ | y 1 = 0}) ((isClosed_eq (continuous_apply 1) continuous_const).measurableSet.nullMeasurableSet)).trans (Measure.pi_hyperplane (fun _ : Fin 2 => volume (α := ℝ)) 1 0) }; have hne : ∀ᵐ y : E2 ∂volume, y 1 ≠ 0 := by { rw [ae_iff]; convert hflat using 1; congr 1; ext y; exact not_not }; have hsphere : ∀ᵐ y : E2 ∂volume, ‖y‖ ≠ 2 * rho := by { have h := Measure.addHaar_sphere volume (0 : E2) (2 * rho); change volume {y : E2 | dist y 0 = 2 * rho} = 0 at h; rw [ae_iff]; convert h using 1; congr 1; ext y; change (¬¬‖y‖ = 2 * rho) ↔ dist y 0 = 2 * rho; rw [dist_zero_right]; exact not_not }; let f := (patch x rho).indicator E; let g : E2 → E2 := fun y => f (x + y); have hf : MemLp f (ENNReal.ofReal p) volume := (memLp_indicator_iff_restrict hpatch.nullMeasurableSet).2 mem; have hg : MemLp g (ENNReal.ofReal p) volume := hf.comp_measurePreserving htrans; have hgr : MemLp (g ∘ reflect) (ENNReal.ofReal p) volume := hg.comp_measurePreserving hmp; have hdist (y : E2) : dist (x + y) x = ‖y‖ := by { rw [dist_eq_norm]; simp }; have hcoord (y : E2) : (x + y) 1 = y 1 := by { simp [flat_center] }; have hzero (y : E2) (hy : y 1 ≤ 0) : g y = 0 := by { exact Set.indicator_of_notMem (fun h => (not_lt.mpr hy) ((hcoord y) ▸ h.2)) E }; have heq : positiveExtension x rho E =ᵐ[volume] g + g ∘ reflect := by { filter_upwards [hne, hsphere] with y hy hz; change (if ‖y‖ ≤ 2 * rho then if 0 ≤ y 1 then E (x + y) else E (x + reflect y) else 0) = g y + g (reflect y); by_cases hb : ‖y‖ ≤ 2 * rho; · { have hbl : ‖y‖ < 2 * rho := lt_of_le_of_ne hb hz; rw [ite_eq_left hb]; by_cases hc : 0 ≤ y 1; · { have hc' : 0 < y 1 := lt_of_le_of_ne hc (Ne.symm hy); have hr : g (reflect y) = 0 := hzero _ (by { change -y 1 ≤ 0; exact neg_nonpos.mpr hc }); rw [ite_eq_left hc, hr, add_zero]; exact (Set.indicator_of_mem (show x + y ∈ patch x rho from ⟨by { rw [hdist]; exact hbl }, by { rw [hcoord]; exact hc' }⟩) E).symm }; · { have hc' : y 1 < 0 := lt_of_not_ge hc; rw [ite_eq_right hc, hzero y hc'.le, zero_add]; exact (Set.indicator_of_mem (show x + reflect y ∈ patch x rho from ⟨by { rw [hdist, hnorm]; exact hbl }, by { rw [hcoord]; change 0 < -y 1; exact neg_pos.mpr hc' }⟩) E).symm } }; · { rw [ite_eq_right hb]; have hg0 : g y = 0 := Set.indicator_of_notMem (fun h => hb (le_of_lt (by { simpa only [hdist] using h.1 }))) E; have hgr0 : g (reflect y) = 0 := Set.indicator_of_notMem (fun h => hb (le_of_lt (by { simpa only [hdist, hnorm] using h.1 }))) E; simp [hg0, hgr0] } }; have hext : MemLp (positiveExtension x rho E) (ENNReal.ofReal p) volume := (memLp_congr_ae heq).2 (hg.add hgr); have hfint : Integrable f volume := by { let : IsFiniteMeasure (volume.restrict (patch x rho)) := ⟨by { rw [Measure.restrict_apply_univ]; exact lt_of_le_of_lt (measure_mono (show patch x rho ⊆ Metric.ball x (2 * rho) from fun y hy => hy.1)) measure_ball_lt_top }⟩; exact (integrable_indicator_iff hpatch).2 (mem.integrable hp1) }; have hgint : Integrable g volume := htrans.integrable_comp_of_integrable hfint; have hextint : Integrable (positiveExtension x rho E) volume := (hgint.add (hmp.integrable_comp_of_integrable hgint)).congr heq.symm; have hpow (y : E2) : ‖g y + g (reflect y)‖ₑ ^ p = ‖g y‖ₑ ^ p + ‖g (reflect y)‖ₑ ^ p := by { by_cases hy : y 1 ≤ 0; · { simp [hzero y hy, ENNReal.zero_rpow_of_pos hp] }; · { have hr : g (reflect y) = 0 := hzero _ (by { change -y 1 ≤ 0; exact neg_nonpos.mpr (le_of_not_ge hy) }); simp [hr, ENNReal.zero_rpow_of_pos hp] } }; have hI : (∫⁻ y, ‖positiveExtension x rho E y‖ₑ ^ p ∂volume) = (2 : ℝ≥0∞) * (∫⁻ y, ‖g y‖ₑ ^ p ∂volume) := by { have hfirst : (∫⁻ y, ‖positiveExtension x rho E y‖ₑ ^ p ∂volume) = ∫⁻ y, (‖g y‖ₑ ^ p + ‖g (reflect y)‖ₑ ^ p) ∂volume := by { apply lintegral_congr_ae; filter_upwards [heq] with y hy; rw [hy]; exact hpow y }; rw [hfirst, lintegral_add_left' (hg.aestronglyMeasurable.enorm.pow_const p) _, hmp.lintegral_comp_emb e.toHomeomorph.measurableEmbedding (fun y => ‖g y‖ₑ ^ p), two_mul] }; have hnormext : eLpNorm (positiveExtension x rho E) (ENNReal.ofReal p) volume = (2 : ℝ≥0∞) ^ (1 / p) * eLpNorm E (ENNReal.ofReal p) (volume.restrict (patch x rho)) := by { rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hpt hext.aestronglyMeasurable, ENNReal.toReal_ofReal hp.le, hI, ENNReal.mul_rpow_of_nonneg _ _ (by { positivity } : 0 ≤ 1 / p)]; have hngI : (∫⁻ y, ‖g y‖ₑ ^ p ∂volume) ^ (1 / p) = eLpNorm g (ENNReal.ofReal p) volume := by { simpa only [ENNReal.toReal_ofReal hp.le] using (eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hpt hg.aestronglyMeasurable).symm }; rw [hngI]; have hng : eLpNorm g (ENNReal.ofReal p) volume = eLpNorm f (ENNReal.ofReal p) volume := eLpNorm_comp_measurePreserving hf.aestronglyMeasurable htrans; rw [hng]; exact congrArg ((2 : ℝ≥0∞) ^ (1 / p) * ·) (eLpNorm_indicator_eq_eLpNorm_restrict hpatch.nullMeasurableSet) }; have hsup : ∀ᵐ y ∂volume, y ∉ Metric.closedBall 0 (7 * rho / 4) → positiveExtension x rho E y = 0 := by { have hz : ∀ᵐ z ∂volume, z ∈ patch x rho → z ∉ supportMargin x rho → E z = 0 := (ae_restrict_iff' hpatch).1 supported; have hzg : ∀ᵐ y ∂volume, y ∉ Metric.closedBall 0 (7 * rho / 4) → g y = 0 := by { filter_upwards [htrans.quasiMeasurePreserving.ae hz] with y hy hout; by_cases hin : x + y ∈ patch x rho; · { change (patch x rho).indicator E (x + y) = 0; rw [Set.indicator_of_mem hin]; apply hy hin; change ¬(dist (x + y) x ≤ 7 * rho / 4 ∧ 0 ≤ (x + y) 1); rw [hdist]; rw [Metric.mem_closedBall, dist_zero_right, not_le] at hout; exact fun h => (not_le.mpr hout) h.1 }; · { exact Set.indicator_of_notMem hin E } }; filter_upwards [heq, hzg, hmp.quasiMeasurePreserving.ae hzg] with y hy hgy hry hout; rw [hy]; change g y + g (reflect y) = 0; rw [hgy hout, hry (by { intro h; apply hout; change dist y 0 ≤ 7 * rho / 4; change dist (reflect y) 0 ≤ 7 * rho / 4 at h; rw [dist_zero_right] at h ⊢; rwa [hnorm] at h })]; exact zero_add 0 }; refine ⟨hext, hextint, ?_, hsup, ?_⟩; · { rw [hnormext, ENNReal.toReal_mul, ← ENNReal.toReal_rpow]; norm_num }; · { intro G hG; filter_upwards [hne] with y hy; exact hG y hy } }

/-- The growth constant is fixed before F. Improved input Lp membership
is supplied later by B07 and is not added to the original endpoint. -/
theorem negative_reflection_growth
    (x : E2) (flat_center : x 1 = 0) (rho : ℝ) (rho_positive : 0 < rho)
    (gamma : ℝ≥0) (gamma_positive : 0 < gamma) (gamma_lt_one : gamma < 1)
    (p : ℝ) (p_large : 2 / (1 - (gamma : ℝ)) < p) :
    ∃ Cgrowth : ℝ, 0 < Cgrowth ∧
      ∀ F : E2 → ℝ, MemLp F (ENNReal.ofReal p) (volume.restrict (patch x rho)) →
      (∀ᵐ y ∂volume.restrict (patch x rho), y ∉ supportMargin x rho → F y = 0) →
      ScalarGrowth (Set.univ : Set E2) (negativeExtension x rho F) gamma
        (Cgrowth * (eLpNorm F (ENNReal.ofReal p) (volume.restrict (patch x rho))).toReal) := by
  classical
  have hg0 : 0 ≤ (gamma : ℝ) := gamma.coe_nonneg
  have hg1 : (gamma : ℝ) < 1 := by exact_mod_cast gamma_lt_one
  have hd : 0 < 1 - (gamma : ℝ) := by linarith
  have hp2 : 2 < p := lt_of_le_of_lt ((le_div_iff₀ hd).2 (by nlinarith)) p_large
  have hp : 0 < p := by linarith
  have hp1 : 1 ≤ ENNReal.ofReal p := by simpa using ENNReal.ofReal_le_ofReal (by linarith : 1 ≤ p)
  let a : ℝ := 1 - 1 / p
  have ha : 0 < a := by
    have h : 1 / p < 1 := (div_lt_one hp).2 (by linarith)
    dsimp [a]; linarith
  have hexp : 1 + (gamma : ℝ) ≤ 2 * a := by
    have hlarge := (div_lt_iff₀ hd).mp p_large
    have hdiv : 2 / p < 1 - (gamma : ℝ) := (div_lt_iff₀ hp).2 (by nlinarith)
    have heq : 2 / p = 2 * (1 / p) := by ring
    rw [heq] at hdiv
    dsimp [a]; linarith
  let C : ℝ := 2 * ((Real.pi ^ a) + (((2 * rho) ^ 2 * Real.pi) ^ a) + 1)
  have hC : 0 < C := by
    dsimp [C]; positivity
  refine ⟨C, hC, ?_⟩
  intro F mem supported
  let R : E2 ≃ₗᵢ[ℝ] E2 := LinearIsometryEquiv.piLpCongrRight 2
    (fun i : Fin 2 => if i = 1 then LinearIsometryEquiv.neg ℝ else LinearIsometryEquiv.refl ℝ ℝ)
  have hR : ∀ y, R y = reflect y := by
    intro y; ext i
    dsimp [reflect]
    simp [R, LinearIsometryEquiv.piLpCongrRight_apply]
    split <;> rfl
  have hRn : ∀ y, ‖reflect y‖ = ‖y‖ := fun y => hR y ▸ R.norm_map y
  have hR1 : ∀ y, reflect y 1 = -y 1 := by intro y; dsimp [reflect]; simp
  have hRm : MeasurePreserving reflect volume volume := by
    have hh : (fun y => R y) = reflect := funext hR
    rw [← hh]; exact R.measurePreserving
  have hs : MeasurableSet (patch x rho) :=
    (measurableSet_lt (continuous_id.dist continuous_const).measurable measurable_const).inter
      (measurableSet_lt measurable_const (EuclideanSpace.proj (1 : Fin 2)).continuous.measurable)
  let f := (patch x rho).indicator F
  let g : E2 → ℝ := fun y => f (x + y)
  have hf : MemLp f (ENNReal.ofReal p) volume := (memLp_indicator_iff_restrict hs.nullMeasurableSet).mpr mem
  have hT := measurePreserving_add_left (volume : Measure E2) x
  have hg : MemLp g (ENNReal.ofReal p) volume := hf.comp_measurePreserving hT
  have hgR : MemLp (g ∘ reflect) (ENNReal.ofReal p) volume := hg.comp_measurePreserving hRm
  have hgval : ∀ y, g y = if ‖y‖ < 2 * rho ∧ 0 < y 1 then F (x+y) else 0 := by
    intro y; dsimp [g, f, patch]; simp [Set.indicator, dist_eq_norm, PiLp.add_apply, flat_center]
  have hExt : negativeExtension x rho F = fun y => g y - g (reflect y) := by
    funext y; rw [hgval, hgval]; dsimp [negativeExtension]
    simp only [hRn, hR1]
    by_cases hn : ‖y‖ < 2*rho <;> by_cases hy : 0<y 1 <;> by_cases hm : y 1<0 <;> simp [hn, hy, hm] <;> linarith
  have he : MemLp (negativeExtension x rho F) (ENNReal.ofReal p) volume := by
    rw [hExt]; exact hg.sub hgR
  have hfinite : volume (patch x rho) ≠ (∞ : ℝ≥0∞) :=
    (measure_lt_top_of_subset (show patch x rho ⊆ Metric.closedBall x (2*rho) from fun y hy => hy.1.le) measure_closedBall_lt_top.ne).ne
  let : IsFiniteMeasure (volume.restrict (patch x rho)) := isFiniteMeasure_restrict.mpr hfinite
  have hfi : Integrable f volume := (integrable_indicator_iff hs).mpr (mem.integrable hp1)
  have hgi : Integrable g volume := hT.integrable_comp_of_integrable hfi
  have hei : Integrable (negativeExtension x rho F) volume := by
    rw [hExt]; exact hgi.sub (hRm.integrable_comp_of_integrable hgi)
  have hgn : eLpNorm g (ENNReal.ofReal p) volume =
      eLpNorm F (ENNReal.ofReal p) (volume.restrict (patch x rho)) := by
    change eLpNorm (f ∘ fun y => x + y) (ENNReal.ofReal p) volume = _
    rw [eLpNorm_comp_measurePreserving hf.aestronglyMeasurable hT]
    exact eLpNorm_indicator_eq_eLpNorm_restrict hs.nullMeasurableSet
  have hn : eLpNorm (negativeExtension x rho F) (ENNReal.ofReal p) volume ≤
      2 * eLpNorm F (ENNReal.ofReal p) (volume.restrict (patch x rho)) := by
    rw [hExt]
    exact (eLpNorm_sub_le hp1).trans_eq (by
      change eLpNorm g (ENNReal.ofReal p) volume + eLpNorm (g ∘ reflect) (ENNReal.ofReal p) volume = _
      rw [eLpNorm_comp_measurePreserving hg.aestronglyMeasurable hRm, hgn, two_mul])
  have hnreal : (eLpNorm (negativeExtension x rho F) (ENNReal.ofReal p) volume).toReal ≤
      2 * (eLpNorm F (ENNReal.ofReal p) (volume.restrict (patch x rho))).toReal := by
    have ht : 2 * eLpNorm F (ENNReal.ofReal p) (volume.restrict (patch x rho)) ≠ (∞ : ℝ≥0∞) := by
      exact ENNReal.mul_ne_top (by norm_num) mem.ne
    have h := ENNReal.toReal_mono ht hn
    simpa only [ENNReal.toReal_mul, ENNReal.toReal_ofNat] using h
  have hbnd (s : Set E2) (hs : MeasurableSet s) (hfin : volume s ≠ (∞ : ℝ≥0∞)) :
      (∫ y in s, |negativeExtension x rho F y|) ≤
      2 * (eLpNorm F (ENNReal.ofReal p) (volume.restrict (patch x rho))).toReal * (volume s).toReal ^ a := by
    let : IsFiniteMeasure (volume.restrict s) := isFiniteMeasure_restrict.mpr hfin
    have hr := he.mono_measure (Measure.restrict_le_self (s := s))
    have he1 := eLpNorm_le_eLpNorm_mul_rpow_measure_univ hp1 hr.aestronglyMeasurable
    rw [Measure.restrict_apply_univ, ENNReal.toReal_one, ENNReal.toReal_ofReal hp.le] at he1
    have hlocal : eLpNorm (negativeExtension x rho F) (ENNReal.ofReal p) (volume.restrict s) ≤
        eLpNorm (negativeExtension x rho F) (ENNReal.ofReal p) volume :=
      eLpNorm_mono_measure _ Measure.restrict_le_self
    simp only [div_one] at he1
    have hbound := he1.trans (show
        eLpNorm (negativeExtension x rho F) (ENNReal.ofReal p) (volume.restrict s) * (volume s) ^ a ≤
        eLpNorm (negativeExtension x rho F) (ENNReal.ofReal p) volume * (volume s) ^ a by
      gcongr)
    have ht : eLpNorm (negativeExtension x rho F) (ENNReal.ofReal p) volume * (volume s) ^ a ≠ (∞ : ℝ≥0∞) := by
      apply ENNReal.mul_ne_top he.ne
      exact ENNReal.rpow_ne_top_of_nonneg ha.le hfin
    have hreal := ENNReal.toReal_mono ht hbound
    rw [ENNReal.toReal_mul, ← ENNReal.toReal_rpow] at hreal
    have hone : (eLpNorm (negativeExtension x rho F) 1 (volume.restrict s)).toReal =
        ∫ y in s, |negativeExtension x rho F y| := by
      rw [eLpNorm_one_eq_lintegral_enorm hr.aestronglyMeasurable,
        ← integral_norm_eq_lintegral_enorm hr.aestronglyMeasurable]
      simp only [Real.norm_eq_abs]
    rw [hone] at hreal
    exact hreal.trans (mul_le_mul_of_nonneg_right hnreal (Real.rpow_nonneg (by positivity) _))
  have hsupport : ∀ y, y ∉ Metric.closedBall 0 (2 * rho) → negativeExtension x rho F y = 0 := by
    intro y hy
    have hnot : ¬‖y‖ < 2 * rho := by
      intro h; exact hy (by rw [Metric.mem_closedBall, dist_zero_right]; exact h.le)
    dsimp [negativeExtension]; rw [ite_eq_right hnot]
  have hglobal : (∫ y, |negativeExtension x rho F y|) ≤
      2 * (eLpNorm F (ENNReal.ofReal p) (volume.restrict (patch x rho))).toReal * ((2 * rho) ^ 2 * Real.pi) ^ a := by
    have heq : (Metric.closedBall 0 (2 * rho)).indicator (fun y => |negativeExtension x rho F y|) =
        (fun y => |negativeExtension x rho F y|) := by
      funext y; by_cases hy : y ∈ Metric.closedBall 0 (2 * rho)
      · exact Set.indicator_of_mem hy _
      · rw [Set.indicator_of_notMem hy, hsupport y hy, abs_zero]
    have hb := hbnd (Metric.closedBall 0 (2 * rho)) measurableSet_closedBall measure_closedBall_lt_top.ne
    rw [← integral_indicator measurableSet_closedBall, heq,
      EuclideanSpace.volume_closedBall_fin_two, ENNReal.toReal_mul, ENNReal.toReal_pow,
      ENNReal.toReal_ofReal (by positivity), ENNReal.toReal_ofReal Real.pi_pos.le] at hb
    exact hb
  refine ⟨by simpa only [IntegrableOn, Measure.restrict_univ] using hei, by positivity, ?_⟩
  intro z r hr
  rw [Set.univ_inter]
  have hN : 0 ≤ (eLpNorm F (ENNReal.ofReal p) (volume.restrict (patch x rho))).toReal := ENNReal.toReal_nonneg
  by_cases hr1 : r ≤ 1
  · have hb := hbnd (Metric.ball z r) measurableSet_ball measure_ball_lt_top.ne
    rw [EuclideanSpace.volume_ball_fin_two, ENNReal.toReal_mul, ENNReal.toReal_pow,
      ENNReal.toReal_ofReal hr.le, ENNReal.toReal_ofReal Real.pi_pos.le,
      Real.mul_rpow (sq_nonneg r) Real.pi_pos.le, ← Real.rpow_natCast_mul hr.le] at hb
    have hpow : r ^ (2 * a) ≤ r ^ (1 + (gamma : ℝ)) := Real.rpow_le_rpow_of_exponent_ge hr hr1 hexp
    have hconst : 2 * Real.pi ^ a ≤ C := by
      dsimp [C]
      nlinarith [Real.rpow_nonneg (mul_nonneg (sq_nonneg (2*rho)) Real.pi_pos.le) a, Real.rpow_nonneg Real.pi_pos.le a]
    calc
      _ ≤ 2 * (eLpNorm F (ENNReal.ofReal p) (volume.restrict (patch x rho))).toReal * (r ^ (2 * a) * Real.pi ^ a) := hb
      _ ≤ C * (eLpNorm F (ENNReal.ofReal p) (volume.restrict (patch x rho))).toReal * r ^ (1 + (gamma : ℝ)) := by
        have hp0 := Real.rpow_nonneg hr.le (1 + (gamma : ℝ))
        nlinarith [mul_le_mul_of_nonneg_left hpow (by positivity : 0 ≤ 2 * (eLpNorm F (ENNReal.ofReal p) (volume.restrict (patch x rho))).toReal * Real.pi ^ a),
          mul_le_mul_of_nonneg_right hconst (mul_nonneg hN hp0)]
  · have hrone : 1 ≤ r := (le_of_not_ge hr1)
    have hpow : 1 ≤ r ^ (1 + (gamma : ℝ)) := Real.one_le_rpow hrone (by positivity)
    have hconst : 2 * ((2 * rho) ^ 2 * Real.pi) ^ a ≤ C := by
      dsimp [C]
      nlinarith [Real.rpow_nonneg (mul_nonneg (sq_nonneg (2*rho)) Real.pi_pos.le) a, Real.rpow_nonneg Real.pi_pos.le a]
    have hball : (∫ y in Metric.ball z r, |negativeExtension x rho F y|) ≤ ∫ y, |negativeExtension x rho F y| :=
      integral_mono_measure Measure.restrict_le_self (Filter.Eventually.of_forall (fun y => abs_nonneg _)) hei.abs
    apply hball.trans
    apply hglobal.trans
    calc
      _ = (2 * ((2 * rho) ^ 2 * Real.pi) ^ a) * (eLpNorm F (ENNReal.ofReal p) (volume.restrict (patch x rho))).toReal := by ring
      _ ≤ C * (eLpNorm F (ENNReal.ofReal p) (volume.restrict (patch x rho))).toReal := mul_le_mul_of_nonneg_right hconst hN
      _ ≤ C * (eLpNorm F (ENNReal.ofReal p) (volume.restrict (patch x rho))).toReal * r ^ (1 + (gamma : ℝ)) := by
        exact le_mul_of_one_le_right (mul_nonneg hC.le hN) hpow


end SeifertSurfaces.OriginalEndpoints.B1Tangency.ChartMetricProvider.Variational.DirectWeak.BoundarySupport
