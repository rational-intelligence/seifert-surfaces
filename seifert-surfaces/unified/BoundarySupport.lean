/-- The open upper half-ball centered at a flat-plane point. -/
def patch (x : E2) (rho : ℝ) : Set E2 :=
  {y | dist y x < 2 * rho ∧ 0 < y 1}
def closedPatch (x : E2) (rho : ℝ) : Set E2 :=
  {y | dist y x ≤ 2 * rho ∧ 0 ≤ y 1}
def supportMargin (x : E2) (rho : ℝ) : Set E2 :=
  {y | dist y x ≤ 7 * rho / 4 ∧ 0 ≤ y 1}
def curvedEdge (x : E2) (rho : ℝ) : Set E2 :=
  {y | dist y x = 2 * rho ∧ 0 ≤ y 1}
def flatEdge (x : E2) (rho : ℝ) : Set E2 :=
  {y | dist y x < 2 * rho ∧ y 1 = 0}

def localizedVector (chi v : E2 → ℝ) (a : E2 → Mat2) (e : E2 → E2) : E2 → E2 :=
  fun y => chi y • e y + v y • matrixAction (a y) (planarGradient chi y)
def localizedScalar (chi : E2 → ℝ) (a : E2 → Mat2) (e dv : E2 → E2) : E2 → ℝ :=
  fun y => inner ℝ (e y - matrixAction (a y) (dv y)) (planarGradient chi y)

def reflect (y : E2) : E2 :=
  (EuclideanSpace.equiv (Fin 2) ℝ).symm (fun i => if i = 1 then -y i else y i)

/-- Even reflection of the vector values, followed by zero extension.
This is a source data extension, not a reflected PDE flux identity. -/
def positiveExtension (x : E2) (rho : ℝ) (E : E2 → E2) : E2 → E2 :=
  fun y => if ‖y‖ ≤ 2 * rho then
    if 0 ≤ y 1 then E (x + y) else E (x + reflect y)
  else 0
/-- Odd scalar reflection with the flat-plane value explicitly chosen as zero. -/
def negativeExtension (x : E2) (rho : ℝ) (F : E2 → ℝ) : E2 → ℝ :=
  fun y => if ‖y‖ < 2 * rho then
    if 0 < y 1 then F (x + y) else if y 1 < 0 then -F (x + reflect y) else 0
  else 0

/-- The cutoff and its bounds precede every forcing/solution datum.
The original nonsymmetric coefficients and arbitrary flat forcing are retained. -/
theorem cutoff_localization
    (r : ℝ) (radius_positive : 0 < r)
    (gamma : ℝ≥0) (gamma_positive : 0 < gamma) (gamma_lt_one : gamma < 1)
    (a : E2 → Mat2) (ell Lambda : ℝ) (ell_positive : 0 < ell) (Lambda_positive : 0 < Lambda)
    (bounds : ∀ y : E2, ∀ p : E2,
      ell * ‖p‖ ^ 2 ≤ inner ℝ p (matrixAction (a y) p) ∧ (∀ i j, |a y i j| ≤ Lambda))
    (Ca : ℝ≥0) (coefficient_holder : ∀ i j, HolderWith Ca gamma (fun y => a y i j))
    (x : E2) (flat_center : x 1 = 0) (rho : ℝ) (rho_positive : 0 < rho)
    (patch_inside : closedPatch x rho ⊆ disc r) :
    ∃ chi : E2 → ℝ, ∃ Bchi : ℝ, ∃ Cchi : ℝ≥0,
      0 ≤ Bchi ∧ ContDiff ℝ ∞ chi ∧ HasCompactSupport chi ∧
      (∀ y, 0 ≤ chi y ∧ chi y ≤ 1) ∧
      (∀ y ∈ Metric.closedBall x rho, chi y = 1) ∧
      tsupport chi ⊆ Metric.ball x (3 * rho / 2) ∧
      tsupport (planarGradient chi) ⊆ Metric.ball x (3 * rho / 2) ∧
      tsupport chi ⊆ disc r ∧
      (∀ y, ‖fderiv ℝ chi y‖ ≤ Bchi ∧ ‖planarGradient chi y‖ ≤ Bchi) ∧
      HolderWith Cchi gamma (fderiv ℝ chi) ∧
      HolderWith Cchi gamma (planarGradient chi) ∧
      ∀ (e : E2 → E2) (v : E2 → ℝ) (dv : E2 → E2)
        (Be : ℝ), 0 ≤ Be → ∀ Ce : ℝ≥0,
      (∀ y ∈ closedHalfDisc r, ‖e y‖ ≤ Be) →
      HolderOnWith Ce gamma e (closedHalfDisc r) →
      WeakDivergenceWithData (halfDisc r) a e (fun _ => 0) v dv →
      FlatZeroTrace r v dv →
      let U := fun y => chi y * v y
      let dU := cutoffGradient chi v dv
      let Echi := localizedVector chi v a e
      let Fchi := localizedScalar chi a e dv
      WeakDivergenceWithData (patch x rho) a Echi Fchi U dU ∧
      H10On (halfDisc r) U dU ∧ H10On (patch x rho) U dU ∧
      IntegrableOn Echi (patch x rho) ∧ IntegrableOn Fchi (patch x rho) ∧
      (∀ᵐ y ∂volume.restrict (patch x rho),
        y ∉ supportMargin x rho → U y = 0 ∧ dU y = 0 ∧ Echi y = 0 ∧ Fchi y = 0) ∧
      (∀ y, y ∉ Metric.ball x (3 * rho / 2) →
        U y = 0 ∧ dU y = 0 ∧ Echi y = 0 ∧ Fchi y = 0) ∧
      (∀ y ∈ curvedEdge x rho, U y = 0 ∧ Echi y = 0 ∧ Fchi y = 0) := by run_tac do Lean.Elab.Tactic.evalTactic (← Lean.ofExcept (Lean.Parser.runParserCategory (← Lean.getEnv) `tactic "exact (by\n  classical\n  have make_cutoff (r : ℝ) (gamma : ℝ≥0) (gamma_lt_one : gamma < 1)\n      (x : E2) (flat_center : x 1 = 0) (rho : ℝ) (rho_positive : 0 < rho)\n      (patch_inside : closedPatch x rho ⊆ disc r) :\n      ∃ chi : E2 → ℝ, ∃ Bchi : ℝ, ∃ Cchi : ℝ≥0,\n        0 ≤ Bchi ∧ ContDiff ℝ ∞ chi ∧ HasCompactSupport chi ∧\n        (∀ y, 0 ≤ chi y ∧ chi y ≤ 1) ∧\n        (∀ y ∈ Metric.closedBall x rho, chi y = 1) ∧\n        tsupport chi ⊆ Metric.ball x (3 * rho / 2) ∧\n        tsupport (planarGradient chi) ⊆ Metric.ball x (3 * rho / 2) ∧\n        tsupport chi ⊆ disc r ∧\n        (∀ y, ‖fderiv ℝ chi y‖ ≤ Bchi ∧ ‖planarGradient chi y‖ ≤ Bchi) ∧\n        HolderWith Cchi gamma (fderiv ℝ chi) ∧\n        HolderWith Cchi gamma (planarGradient chi) := by\n    have ball_inside : Metric.closedBall x (2 * rho) ⊆ disc r := by\n      intro y hy\n      let z : E2 := (EuclideanSpace.equiv (Fin 2) ℝ).symm ![y 0, |y 1|]\n      have hz0 : z 0 = y 0 := rfl\n      have hz1 : z 1 = |y 1| := rfl\n      have hnorm : ‖z‖ = ‖y‖ := by\n        rw [EuclideanSpace.norm_eq, EuclideanSpace.norm_eq]\n        congr 1\n        simp only [Fin.sum_univ_two, Real.norm_eq_abs, hz0, hz1, abs_abs]\n      have hdist : dist z x = dist y x := by\n        rw [dist_eq_norm, dist_eq_norm, EuclideanSpace.norm_eq, EuclideanSpace.norm_eq]\n        congr 1\n        simp only [Fin.sum_univ_two, PiLp.sub_apply, hz0, hz1, flat_center, sub_zero, Real.norm_eq_abs, abs_abs]\n      have hzin : z ∈ closedPatch x rho := ⟨by simpa only [hdist] using (Metric.mem_closedBall.mp hy), by rw [hz1]; exact abs_nonneg _⟩\n      have hz := patch_inside hzin\n      change dist z 0 < r at hz\n      change dist y 0 < r\n      rw [dist_zero_right, hnorm] at hz\n      rwa [dist_zero_right]\n    let bump : ContDiffBump x := ⟨rho, 5 * rho / 4, rho_positive, by linarith⟩\n    let chi : E2 → ℝ := bump\n    have hc : ContDiff ℝ ∞ chi := bump.contDiff\n    have hk : HasCompactSupport chi := bump.hasCompactSupport\n    have hgrad : tsupport (planarGradient chi) ⊆ tsupport chi := by\n      apply closure_minimal\n      · intro y hy\n        by_contra h\n        exact hy (planarGradient_eq_zero_off_support chi h)\n      · exact isClosed_tsupport _\n    have hs : tsupport chi ⊆ Metric.ball x (3 * rho / 2) := by\n      rw [show tsupport chi = Metric.closedBall x (5 * rho / 4) from bump.tsupport_eq]\n      intro y hy\n      change dist y x < _\n      change dist y x ≤ _ at hy\n      linarith\n    have hd : tsupport chi ⊆ disc r := by\n      refine hs.trans (subset_trans ?_ ball_inside)\n      intro y hy\n      change dist y x ≤ _\n      change dist y x < _ at hy\n      linarith\n    have hdc : ContDiff ℝ ∞ (fderiv ℝ chi) := hc.fderiv_right (by simp)\n    have hgc : ContDiff ℝ ∞ (planarGradient chi) := by\n      unfold planarGradient\n      exact ContDiff.sum fun i _ => (hdc.clm_apply contDiff_const).smul contDiff_const\n    have hgk : HasCompactSupport (planarGradient chi) := hk.of_isClosed_subset (isClosed_tsupport _) hgrad\n    have control {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F]\n        (z : E2 → F) (hz : ContDiff ℝ ∞ z) (hzK : HasCompactSupport z) :\n        ∃ B : ℝ, 0 ≤ B ∧ (∀ y, ‖z y‖ ≤ B) ∧ ∃ C : ℝ≥0, HolderWith C gamma z := by\n      obtain ⟨K, hK⟩ := hzK.exists_bound_of_continuous hz.continuous\n      obtain ⟨L, hL⟩ := ContDiff.lipschitzWith_of_hasCompactSupport hzK hz (by simp)\n      let B := max K 0\n      have hB : 0 ≤ B := le_max_right _ _\n      have hb (y : E2) : ‖z y‖ ≤ B := (hK y).trans (le_max_left _ _)\n      let D : ℝ≥0 := ⟨2 * B, by positivity⟩\n      have hzero : HolderWith D 0 z := by\n        intro p q\n        simp only [NNReal.coe_zero, ENNReal.rpow_zero, mul_one]\n        rw [edist_dist, ← ENNReal.ofReal_coe_nnreal, ENNReal.ofReal_le_ofReal_iff (by positivity : (0 : ℝ) ≤ D)]\n        change dist (z p) (z q) ≤ 2 * B\n        calc\n          _ ≤ ‖z p‖ + ‖z q‖ := dist_le_norm_add_norm _ _\n          _ ≤ 2 * B := by linarith [hb p, hb q]\n      exact ⟨B, hB, hb, max D L, hzero.of_le_of_le hL.holderWith zero_le gamma_lt_one.le⟩\n    obtain ⟨Bd, hBd, hdb, Cd, hdH⟩ := control _ hdc (hk.fderiv ℝ)\n    obtain ⟨Bg, hBg, hgb, Cg, hgH⟩ := control _ hgc hgk\n    refine ⟨chi, max Bd Bg, max Cd Cg, hBd.trans (le_max_left _ _), hc, hk,\n      fun y => ⟨bump.nonneg, bump.le_one⟩, fun y hy => bump.one_of_mem_closedBall hy,\n      hs, hgrad.trans hs, hd, ?_, hdH.mono (le_max_left _ _), hgH.mono (le_max_right _ _)⟩\n    exact fun y => ⟨(hdb y).trans (le_max_left _ _), (hgb y).trans (le_max_right _ _)⟩\n  have restrict_H1 (V W : Set E2) (hW : MeasurableSet W) (hVW : V ⊆ W)\n      (u : E2 → ℝ) (du : E2 → E2) (hu : H1On W u du) : H1On V u du := by\n    refine ⟨⟨hu.1.1.mono_set hVW, hu.1.2.1.mono_set hVW, ?_⟩,\n      hu.2.1.mono_measure (Measure.restrict_mono hVW le_rfl),\n      hu.2.2.mono_measure (Measure.restrict_mono hVW le_rfl)⟩\n    intro phi hc hk hs i\n    have h := hu.1.2.2 phi hc hk (hs.trans hVW) i\n    have hl : (∫ y in W, u y * fderiv ℝ phi y (coordinateVector 2 i)) =\n        ∫ y in V, u y * fderiv ℝ phi y (coordinateVector 2 i) := by\n      apply setIntegral_eq_of_subset_of_forall_sdiff_eq_zero hW hVW\n      intro y hy\n      have hn : y ∉ tsupport phi := fun hx => hy.2 (hs hx)\n      rw [fderiv_of_notMem_tsupport ℝ hn, ContinuousLinearMap.zero_apply, mul_zero]\n    have hr : (∫ y in W, du y i * phi y) = ∫ y in V, du y i * phi y := by\n      apply setIntegral_eq_of_subset_of_forall_sdiff_eq_zero hW hVW\n      intro y hy\n      have hn : y ∉ tsupport phi := fun hx => hy.2 (hs hx)\n      rw [image_eq_zero_of_notMem_tsupport hn, mul_zero]\n    rwa [hl, hr] at h\n  have transfer_H10 (V W : Set E2) (hVW : V ⊆ W)\n      (u : E2 → ℝ) (du : E2 → E2) (hu : H10On W u du) (hv : H1On V u du)\n      (eta : E2 → ℝ) (hc : ContDiff ℝ ∞ eta) (hk : HasCompactSupport eta)\n      (hs : tsupport eta ∩ W ⊆ V)\n      (hbound : ∀ y, |eta y| ≤ 1)\n      (K : ℝ) (hK : 0 ≤ K) (hgrad : ∀ y, ‖planarGradient eta y‖ ≤ K)\n      (huid : ∀ y, eta y * u y = u y)\n      (hduid : ∀ y, eta y • du y + u y • planarGradient eta y = du y) :\n      H10On V u du := by\n    have grad_mul (phi : E2 → ℝ) (hp : ContDiff ℝ ∞ phi) (y : E2) :\n        planarGradient (fun y => eta y * phi y) y =\n          eta y • planarGradient phi y + phi y • planarGradient eta y := by\n      unfold planarGradient\n      rw [fderiv_fun_mul (hc.differentiable (by simp) y) (hp.differentiable (by simp) y)]\n      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul,\n        add_smul, Finset.sum_add_distrib, Finset.smul_sum, smul_smul]\n    refine ⟨hv, ?_⟩\n    intro eps heps\n    let A := 2 + 2 * K ^ 2\n    have hA : 0 < A := by dsimp [A]; positivity\n    obtain ⟨phi, hpc, hpk, hps, happ⟩ := hu.2 (eps / A) (div_pos heps hA)\n    let psi := fun y => eta y * phi y\n    have hpsic : ContDiff ℝ ∞ psi := hc.mul hpc\n    have hpsik : HasCompactSupport psi := hk.mul_right\n    have hpsis : tsupport psi ⊆ V := by\n      intro y hy\n      exact hs ⟨tsupport_mul_subset_left hy, hps (tsupport_mul_subset_right hy)⟩\n    refine ⟨psi, hpsic, hpsik, hpsis, ?_⟩\n    have hpoint (y : E2) :\n        |u y - psi y| ^ 2 + ‖du y - planarGradient psi y‖ ^ 2 ≤\n          A * (|u y - phi y| ^ 2 + ‖du y - planarGradient phi y‖ ^ 2) := by\n      have hscalar : |u y - psi y| ≤ |u y - phi y| := by\n        rw [← huid y]\n        change |eta y * u y - eta y * phi y| ≤ |eta y * u y - phi y|\n        rw [huid y]\n        calc\n          |u y - eta y * phi y| = |eta y * (u y - phi y)| := by rw [mul_sub, huid y]\n          _ = |eta y| * |u y - phi y| := abs_mul _ _\n          _ ≤ 1 * |u y - phi y| := mul_le_mul_of_nonneg_right (hbound y) (abs_nonneg _)\n          _ = _ := one_mul _\n      have hvector : du y - planarGradient psi y =\n          eta y • (du y - planarGradient phi y) + (u y - phi y) • planarGradient eta y := by\n        rw [show planarGradient psi y = _ from grad_mul phi hpc y]\n        rw [smul_sub, sub_smul]\n        calc\n          du y - (eta y • planarGradient phi y + phi y • planarGradient eta y) =\n              (eta y • du y + u y • planarGradient eta y) -\n                (eta y • planarGradient phi y + phi y • planarGradient eta y) := by rw [hduid]\n          _ = _ := add_sub_add_comm _ _ _ _\n      have hnorm : ‖du y - planarGradient psi y‖ ≤\n          ‖du y - planarGradient phi y‖ + K * |u y - phi y| := by\n        rw [hvector]\n        calc\n          _ ≤ ‖eta y • (du y - planarGradient phi y)‖ + ‖(u y - phi y) • planarGradient eta y‖ := norm_add_le _ _\n          _ = |eta y| * ‖du y - planarGradient phi y‖ + |u y - phi y| * ‖planarGradient eta y‖ := by simp only [norm_smul, Real.norm_eq_abs]\n          _ ≤ 1 * ‖du y - planarGradient phi y‖ + |u y - phi y| * K :=\n            add_le_add (mul_le_mul_of_nonneg_right (hbound y) (norm_nonneg _))\n              (mul_le_mul_of_nonneg_left (hgrad y) (abs_nonneg _))\n          _ = _ := by ring\n      have hscalar2 := sq_le_sq₀ (abs_nonneg (u y - psi y)) (abs_nonneg (u y - phi y)) |>.mpr hscalar\n      have hnorm2 := sq_le_sq₀ (norm_nonneg (du y - planarGradient psi y))\n        (by positivity : 0 ≤ ‖du y - planarGradient phi y‖ + K * |u y - phi y|) |>.mpr hnorm\n      dsimp only [A]\n      nlinarith [sq_nonneg (‖du y - planarGradient phi y‖ - K * |u y - phi y|),\n        sq_nonneg (u y - phi y), sq_abs (u y - phi y)]\n    have error_integrable (z : E2 → ℝ) (hzc : ContDiff ℝ ∞ z) (hzk : HasCompactSupport z) :\n        IntegrableOn (fun y => |u y - z y| ^ 2 + ‖du y - planarGradient z y‖ ^ 2) W := by\n      have hz : MemLp z 2 (volume.restrict W) := (hzc.continuous.memLp_of_hasCompactSupport hzk).restrict W\n      have hgz : HasCompactSupport (planarGradient z) := by\n        apply hzk.of_isClosed_subset (isClosed_tsupport _)\n        apply closure_minimal\n        · intro y hy\n          by_contra hn\n          exact hy (planarGradient_eq_zero_off_support z hn)\n        · exact isClosed_tsupport _\n      have hzgrad : MemLp (planarGradient z) 2 (volume.restrict W) :=\n        ((continuous_planarGradient hzc).memLp_of_hasCompactSupport hgz).restrict W\n      have hsquare := (hu.1.2.1.sub hz).integrable_norm_pow (by decide : (2 : ℕ) ≠ 0)\n      have hgsquare := (hu.1.2.2.sub hzgrad).integrable_norm_pow (by decide : (2 : ℕ) ≠ 0)\n      apply Integrable.add\n      · simpa only [Pi.sub_apply, Real.norm_eq_abs] using hsquare\n      · simpa only [Pi.sub_apply] using hgsquare\n    have herr := error_integrable phi hpc hpk\n    have hnew := (error_integrable psi hpsic hpsik).mono_set hVW\n    calc\n      (∫ y in V, |u y - psi y| ^ 2 + ‖du y - planarGradient psi y‖ ^ 2) ≤\n          ∫ y in V, A * (|u y - phi y| ^ 2 + ‖du y - planarGradient phi y‖ ^ 2) :=\n        integral_mono hnew ((herr.mono_set hVW).const_mul A) hpoint\n      _ ≤ ∫ y in W, A * (|u y - phi y| ^ 2 + ‖du y - planarGradient phi y‖ ^ 2) := by\n        apply integral_mono_measure (Measure.restrict_mono hVW le_rfl)\n        · exact ae_of_all _ (fun y => by positivity)\n        · exact herr.const_mul A\n      _ = A * ∫ y in W, |u y - phi y| ^ 2 + ‖du y - planarGradient phi y‖ ^ 2 := integral_const_mul _ _\n      _ < A * (eps / A) := mul_lt_mul_of_pos_left happ hA\n      _ = eps := by rw [div_eq_mul_inv, mul_left_comm, mul_inv_cancel₀ hA.ne', mul_one]\n  have localize_weak (V W : Set E2) (hW : MeasurableSet W) (hVW : V ⊆ W)\n      (a : E2 → Mat2) (ha : ∀ i j, Continuous (fun y => a y i j))\n      (Lambda : ℝ) (hbound : ∀ y i j, |a y i j| ≤ Lambda)\n      (chi v : E2 → ℝ) (e dv : E2 → E2)\n      (hc : ContDiff ℝ ∞ chi) (hk : HasCompactSupport chi)\n      (he : IntegrableOn e W) (hv : IntegrableOn v W) (hdv : IntegrableOn dv W)\n      (hw : WeakDivergenceWithData W a e (fun _ => 0) v dv)\n      (hU : H1On V (fun y => chi y * v y) (cutoffGradient chi v dv)) :\n      WeakDivergenceWithData V a (localizedVector chi v a e)\n        (localizedScalar chi a e dv) (fun y => chi y * v y) (cutoffGradient chi v dv) ∧\n      IntegrableOn (localizedVector chi v a e) V ∧\n      IntegrableOn (localizedScalar chi a e dv) V := by\n    have vec_int (P : E2 → E2) (hP : ∀ i, IntegrableOn (fun y => P y i) W) :\n        IntegrableOn P W := by\n      apply (EuclideanSpace.equiv (Fin 2) ℝ).integrable_comp_iff.mp\n      exact integrable_pi_iff.mpr hP\n    have coord_int (P : E2 → E2) (hP : IntegrableOn P W) (i : Fin 2) :\n        IntegrableOn (fun y => P y i) W := by\n      have h := (EuclideanSpace.equiv (Fin 2) ℝ).integrable_comp_iff.mpr hP\n      exact integrable_pi_iff.mp h i\n    have matrix_int (P : E2 → E2) (hP : IntegrableOn P W) :\n        IntegrableOn (fun y => matrixAction (a y) (P y)) W := by\n      apply vec_int\n      intro i\n      change IntegrableOn (fun y => ∑ j : Fin 2, a y i j * P y j) W\n      apply integrable_finsetSum\n      intro j _\n      exact (coord_int P hP j).bdd_mul (ha i j).aestronglyMeasurable\n        (ae_of_all _ (fun y => by simpa only [Real.norm_eq_abs] using hbound y i j))\n    have grad_compact (z : E2 → ℝ) (hz : HasCompactSupport z) :\n        HasCompactSupport (planarGradient z) := by\n      apply hz.of_isClosed_subset (isClosed_tsupport _)\n      apply closure_minimal\n      · intro y hy\n        by_contra hn\n        exact hy (planarGradient_eq_zero_off_support z hn)\n      · exact isClosed_tsupport _\n    have inner_bdd (P Q : E2 → E2) (hP : IntegrableOn P W)\n        (hQ : AEStronglyMeasurable Q (volume.restrict W)) (K : ℝ)\n        (hb : ∀ y, ‖Q y‖ ≤ K) : IntegrableOn (fun y => inner ℝ (P y) (Q y)) W := by\n      apply (hP.norm.mul_const K).mono' (hP.aestronglyMeasurable.inner hQ)\n      exact ae_of_all _ (fun y => (norm_inner_le_norm (P y) (Q y)).trans\n        (mul_le_mul_of_nonneg_left (hb y) (norm_nonneg _)))\n    have inner_grad (P : E2 → E2) (hP : IntegrableOn P W)\n        (z : E2 → ℝ) (hz : ContDiff ℝ ∞ z) (hzk : HasCom