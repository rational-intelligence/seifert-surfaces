Gradient psi y) +\n            inner ℝ (v y • Q y) (planarGradient psi y)) +\n          (psi y * inner ℝ (e y) (planarGradient chi y) -\n            psi y * inner ℝ (P y) (planarGradient chi y)) := by\n        change inner ℝ (chi y • e y + v y • Q y) (planarGradient psi y) +\n          inner ℝ (e y - P y) (planarGradient chi y) * psi y = _\n        simp only [inner_add_left, real_inner_smul_left, inner_sub_left]\n        dsimp only [P, Q]\n        ring\n      simp only [heq]\n      rw [integral_add (f := fun y => chi y * inner ℝ (e y) (planarGradient psi y) + inner ℝ (v y • Q y) (planarGradient psi y))\n        (g := fun y => psi y * inner ℝ (e y) (planarGradient chi y) - psi y * inner ℝ (P y) (planarGradient chi y))\n        (Integrable.add i3 i5) (Integrable.sub i4 i2)]\n      rw [integral_add i3 i5, integral_sub i4 i2]\n    have big_eq :\n        (∫ y in W, inner ℝ (matrixAction (a y) (cutoffGradient chi v dv y)) (planarGradient psi y)) =\n        (∫ y in W, inner ℝ (localizedVector chi v a e y) (planarGradient psi y) +\n          localizedScalar chi a e dv y * psi y) := by\n      rw [left_expand, right_expand]\n      linarith\n    have reduce (P : E2 → E2) (F : E2 → ℝ) :\n        (∫ y in W, inner ℝ (P y) (planarGradient psi y) + F y * psi y) =\n        (∫ y in V, inner ℝ (P y) (planarGradient psi y) + F y * psi y) := by\n      apply setIntegral_eq_of_subset_of_forall_sdiff_eq_zero hW hVW\n      intro y hy\n      have hn : y ∉ tsupport psi := fun h => hy.2 (hps h)\n      rw [planarGradient_eq_zero_off_support psi hn, inner_zero_right,\n        image_eq_zero_of_notMem_tsupport hn, mul_zero, add_zero]\n    have hl := reduce (fun y => matrixAction (a y) (cutoffGradient chi v dv y)) (fun _ => 0)\n    simp only [zero_mul, add_zero] at hl\n    rwa [hl, reduce] at big_eq\n  obtain ⟨chi, Bchi, Cchi, hB, hc, hk, h01, hone, hs, hgs, hdisc, hbound, hdH, hgH⟩ :=\n    make_cutoff r gamma gamma_lt_one x flat_center rho rho_positive patch_inside\n  refine ⟨chi, Bchi, Cchi, hB, 