ave hegrad : HasCompactSupport (planarGradient eta) := by\n    apply hek.of_isClosed_subset (isClosed_tsupport _)\n    apply closure_minimal\n    · intro y hy\n      by_contra hn\n      exact hy (planarGradient_eq_zero_off_support eta hn)\n    · exact isClosed_tsupport _\n  obtain ⟨K,hK⟩ := hegrad.exists_bound_of_continuous (continuous_planarGradient hec)\n  have heK : 0 ≤ max K 0 := le_max_right _ _\n  have heta (y : E2) (hy : y ∈ Metric.ball x (3 * rho / 2)) :\n      eta y = 1 ∧ planarGradient eta y = 0 := by\n    have heq : eta =ᶠ[𝓝 y] (fun _ => (1 : ℝ)) := etaBump.eventuallyEq_one_of_mem_ball hy\n    refine ⟨heq.eq_of_nhds, ?_⟩\n    unfold planarGradient\n    rw [heq.fderiv_eq]\n    simp only [fderiv_const_apply, zero_apply, zero_smul, Finset.sum_const_zero]\n  have hpatchtrace : H10On (patch x rho) U dU := by\n    apply transfer_H10 _ _ hpinside U dU htrace h1patch eta hec hek\n    · intro y hy\n      have hd : dist y x ≤ 7 * rho / 4 := by\n        have hz := hy.1\n        rw [show tsupport eta = Metric.closedBall x (7 * rho / 4) from etaBump.tsupport_eq] at hz\n        exact hz\n      exact ⟨by linarith, hy.2.2⟩\n    · exact fun y => by rw [abs_of_nonneg etaBump.nonneg]; exact etaBump.le_one\n    · exact heK\n    · exact fun y => (hK y).trans (le_max_left _ _)\n    · intro y\n      by_cases hy : y ∈ Metric.ball x (3 * rho / 2)\n      · rw [(heta y hy).1, one_mul]\n      · rw [(vanish y hy).1, mul_zero]\n    · intro y\n      by_cases hy : y ∈ Metric.ball x (3 * rho / 2)\n      · rw [(heta y hy).1, (heta y hy).2, one_smul, smul_zero, add_zero]\n      · rw [(vanish y hy).1, (vanish y hy).2.1, smul_zero, zero_smul, add_zero]\n  letI : IsFiniteMeasure (volume.restrict (halfDisc r)) :=\n    isFiniteMeasure_restrict.mpr (((measure_mono (fun y (hy : y ∈ halfDisc r) => hy.1)).trans_lt\n      (measure_ball_lt_top (μ := volume) (x := (0 : E2)) (r := r))).ne)\n  have hemeas : AEStronglyMeasurable e (volume.restrict (halfDisc r)) :=\n    ((heH.continuousOn gamma_positive).