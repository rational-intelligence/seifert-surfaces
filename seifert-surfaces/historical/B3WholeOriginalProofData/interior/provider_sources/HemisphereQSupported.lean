       fin_cases i <;> simp [v] <;> ring\n      left_inv := by\n        intro p\n        ext i\n        fin_cases i <;> simp [v, hs.ne', ht.ne']\n      right_inv := by\n        intro p\n        ext i\n        fin_cases i <;> simp [v] <;> field_simp <;> ring }\n  let T := L.toContinuousLinearEquiv\n  have hT0 (p : E2) : T p 0 = s * p 0 + u * p 1 := rfl\n  have hT1 (p : E2) : T p 1 = t * p 1 := rfl\n  have hI0 (p : E2) : T.symm p 0 = (p 0 - u * (p 1 / t)) / s := rfl\n  have hI1 (p : E2) : T.symm p 1 = p 1 / t := rfl\n  have hAdj (p : E2) : T.toContinuousLinearMap.adjoint p =\n      v (s * p 0) (u * p 0 + t * p 1) := by\n    apply ext_inner_left ℝ\n    intro q\n    rw [ContinuousLinearMap.adjoint_inner_right]\n    simp only [PiLp.inner_apply, Fin.sum_univ_two, RCLike.inner_apply, conj_trivial]\n    change p 0 * (T q) 0 + p 1 * (T q) 1 =\n      (v (s * p 0) (u * p 0 + t * p 1)) 0 * q 0 +\n        (v (s * p 0) (u * p 0 + t * p 1)) 1 * q 1\n    rw [hT0, hT1, hv0, hv1]\n    ring\n  have hS (p : E2) : matrixAction (symmetricPart A) p =\n      T (T.toContinuousLinearMap.adjoint p) := by\n    rw [hAdj]\n    ext i\n    fin_cases i\n    · simp only [matrixAction, Fin.sum_univ_two]\n      change ((1 / 2 : ℝ) * (A 0 0 + A 0 0) * p 0 +\n        (1 / 2 : ℝ) * (A 0 1 + A 1 0) * p 1) =\n          s * (s * p 0) + u * (u * p 0 + t * p 1)\n      have haeq : a = s ^ 2 + u ^ 2 := by linarith [hs2]\n      calc\n        _ = a * p 0 + b * p 1 := by dsimp [a, b]; ring\n        _ = _ := by rw [haeq, ← hut]; ring\n    · simp only [matrixAction, Fin.sum_univ_two]\n      change ((1 / 2 : ℝ) * (A 1 0 + A 0 1) * p 0 +\n        (1 / 2 : ℝ) * (A 1 1 + A 1 1) * p 1) = t * (u * p 0 + t * p 1)\n      calc\n        _ = b * p 0 + c * p 1 := by dsimp [b, c]; ring\n        _ = _ := by rw [← hut, ← ht2]; ring\n  have hTI : T.toContinuousLinearMap.adjoint.comp T.symm.toContinuousLinearMap.adjoint =\n      ContinuousLinearMap.id ℝ E2 := by\n    rw [← ContinuousLinearMap.adjoint_comp]\n    have hi : T.symm.toContinuousLinearMap.comp T.toContinuousLinearMap =\n        ContinuousLinearMap.id ℝ E2 := by ext1 p; exact T.symm_apply_apply p\n    rw [hi, ContinuousLinearMap.adjoint_id]\n  have hTIap (p : E2) : T.toContinuousLinearMap.adjoint\n      (T.symm.toContinuousLinearMap.adjoint p) = p :=\n    DFunLike.congr_fun hTI p\n  refine ⟨T, ⟨t, ht, hT1⟩, ?_, ?_, ?_, ?_⟩\n  · intro p\n    rw [hS, hTIap, T.symm_apply_apply]\n  · apply ContinuousLinearMap.opNorm_le_bound _ (Real.sqrt_nonneg _)\n    intro p\n    change ‖T p‖ ≤ _\n    apply (sq_le_sq₀ (norm_nonneg _) (mul_nonneg (Real.sqrt_nonneg _) (norm_nonneg _))).mp\n    rw [mul_pow, Real.sq_sqrt (by positivity : 0 ≤ 2 * Lambda), hnorm, hT0, hT1]\n    have ha : a ≤ Lambda := (le_abs_self a).trans ((bounds 0).2 0 0)\n    have hcL : c ≤ Lambda := (le_abs_self c).trans ((bounds 0).2 1 1)\n    have hn : (s * p 0 + u * p 1) ^ 2 + (t * p 1) ^ 2 ≤\n        (a + c) * ‖p‖ ^ 2 := by\n      rw [hnorm, ← ht2]\n      have heq : a = s ^ 2 + u ^ 2 := by linarith [hs2]\n      rw [heq]\n      nlinarith [sq_nonneg (u * p 0 - s * p 1), sq_nonneg (t * p 0)]\n    exact hn.trans (mul_le_mul_of_nonneg_right (add_le_add ha hcL) (sq_nonneg _) |>.trans_eq (by ring))\n  · have hcoerc (q : E2) : ell * ‖q‖ ^ 2 ≤ inner ℝ q (matrixAction (symmetricPart A) q) := by\n      convert (bounds q).1 using 1\n      rw [hform]\n      simp only [PiLp.inner_apply, Fin.sum_univ_two, RCLike.inner_apply, conj_trivial,\n        matrixAction, symmetricPart]\n      change ((1 / 2 : ℝ) * (A 0 0 + A 0 0) * q 0 + (1 / 2 : ℝ) * (A 0 1 + A 1 0) * q 1) * q 0 +\n        ((1 / 2 : ℝ) * (A 1 0 + A 0 1) * q 0 + (1 / 2 : ℝ) * (A 1 1 + A 1 1) * q 1) * q 1 = _\n      dsimp [a, b, c]\n      ring\n    have hInv (p : E2) : ell * ‖T.symm.toContinuousLinearMap.adjoint p‖ ^ 2 ≤ ‖p‖ ^ 2 := by\n      have h := hcoerc (T.symm.toContinuousLinearMap.adjoint p)\n      rw [hS, hTIap] at h\n      change ell * ‖T.symm.toContinuousLinearMap.adjoint p‖ ^ 2 ≤ _\n      convert h using 1\n      change ‖p‖ ^ 2 = inner ℝ (T.symm.toContinuousLinearMap.adjoint p)\n        (T.toContinuousLinearMap p)\n      rw [← ContinuousLinearMap.adjoint_inner_left, hTIap, real_inner_self_eq_norm_sq]\n    have hnormI : ‖T.symm.toContinuousLinearMap.adjoint‖ ≤ (Real.sqrt ell)⁻¹ := by\n      apply ContinuousLinearMap.opNorm_le_bound _ (by positivity)\n      intro p\n      have h := hInv p\n      have hr : 0 < Real.sqrt ell := Real.sqrt_pos.2 hell\n      apply (sq_le_sq₀ (norm_nonneg _) (by positivity : 0 ≤ (Real.sqrt ell)⁻¹ * ‖p‖)).mp\n      rw [mul_pow, inv_pow, Real.sq_sqrt hell.le]\n      calc\n        _ ≤ ‖p‖ ^ 2 / ell := (le_div_iff₀ hell).2 (by simpa only [mul_comm] using h)\n        _ = _ := by ring\n    simpa only [LinearIsometryEquiv.norm_map] using hnormI\n  · have hmat : coordinateMatrix T =\n        LinearMap.toMatrix (EuclideanSpace.basisFun (Fin 2) ℝ).toBasis\n          (EuclideanSpace.basisFun (Fin 2) ℝ).toBasis T.toLinearEquiv.toLinearMap := by\n      ext i j\n      simp [coordinateMatrix, LinearMap.toMatrix_apply, EuclideanSpace.basisFun_apply,\n        coordinateVector]\n    have hdet : Matrix.det (coordinateMatrix T) = LinearMap.det T.toLinearEquiv.toLinearMap := by\n      rw [hmat, LinearMap.det_toMatrix]\n    have hd : LinearMap.det T.toLinearEquiv.toLinearMap ≠ 0 := by\n      rw [← hdet, hmat]\n      exact (T.toLinearEquiv.isUnit_det\n        (EuclideanSpace.basisFun (Fin 2) ℝ).toBasis\n        (EuclideanSpace.basisFun (Fin 2) ℝ).toBasis).ne_zero\n    change Measure.map (T.toLinearEquiv.toLinearMap : E2 → E2) volume = _\n    rw [hdet, ← abs_inv]\n    exact Measure.map_linearMap_addHaar_eq_smul_addHaar (volume : Measure E2) hd"); Lean.Elab.Tactic.evalTactic ((stx.getArg 1).rewriteBottomUp (Lean.Syntax.setInfo .none))

section OriginalFixed
variable (r : ℝ) (radius_positive : 0 < r)
    (gamma : ℝ≥0) (gamma_positive : 0 < gamma) (gamma_lt_one : gamma < 1)
    (a : E2 → Mat2) (ell Lambda : ℝ) (ell_positive : 0 < ell) (Lambda_positive : 0 < Lambda)
    (bounds : ∀ y : E2, ∀ p : E2,
      ell * ‖p‖ ^ 2 ≤ inner ℝ p (matrixAction (a y) p) ∧ (∀ i j, |a y i j| ≤ Lambda))
    (Ca : ℝ≥0) (coefficient_holder : ∀ i j, HolderWith Ca gamma (fun y => a y i j))
include radius_positive gamma_positive gamma_lt_one ell_positive Lambda_positive bounds coefficient_holder

