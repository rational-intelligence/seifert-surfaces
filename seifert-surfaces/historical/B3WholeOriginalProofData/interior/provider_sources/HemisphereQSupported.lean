/-- B03a energy and finite-p mapping for the same explicitly normalized Q.
For p below 2 only the native weak-gradient category is asserted. -/
theorem supported_Q_lp (A : Mat2) (ell Lambda : ℝ)
    (hell : 0 < ell) (hLambda : 0 < Lambda)
    (bounds : ∀ p : E2, ell * ‖p‖ ^ 2 ≤ inner ℝ p (matrixAction A p) ∧
      (∀ i j, |A i j| ≤ Lambda))
    (T : E2 ≃L[ℝ] E2) (normalized : Normalizes A ell Lambda T)
    (x : E2) (flat : x 1 = 0) (rho : ℝ) (hrho : 0 < rho)
    (p : ℝ) (hp : 1 < p) :
    ∃ Cp : ℝ, 0 < Cp ∧ ∀ E : E2 → E2,
      MemLp E (ENNReal.ofReal p) (volume.restrict (patch x rho)) →
      (∀ᵐ y ∂volume.restrict (patch x rho), y ∉ supportMargin x rho → E y = 0) →
      let q := potential T x rho E
      ∃ dq : E2 → E2,
        WeakGradientOn (patch x rho) q dq ∧
        MemLp q (ENNReal.ofReal p) (volume.restrict (patch x rho)) ∧
        MemLp dq (ENNReal.ofReal p) (volume.restrict (patch x rho)) ∧
        (eLpNorm q (ENNReal.ofReal p) (volume.restrict (patch x rho))).toReal / rho +
          (eLpNorm dq (ENNReal.ofReal p) (volume.restrict (patch x rho))).toReal ≤
            Cp * (eLpNorm E (ENNReal.ofReal p) (volume.restrict (patch x rho))).toReal ∧
        (MemLp E 2 (volume.restrict (patch x rho)) →
          WeakDivergenceWithData (patch x rho) (fun _ => A) E (fun _ => 0) q dq ∧
          LocalFlatTrace x rho q dq) := by
  run_tac do
    let savedPath ← Lean.Core.liftIOCore Lean.searchPathRef.get
    let provider ← Lean.Core.liftIOCore <| Lean.findOLean `WholeSupportedQ
    unless provider.toString == "/home/caoyichuan/test/seifert-surfaces/scratch/f-generator/generate_B1_supported_Q_all_p_large/objects/WholeSupportedQ.olean" do
      throwError "unexpected owned original-package proof provider"
    let imported ← Lean.Core.liftIOCore <| Lean.importModules (loadExts := false) #[{module := `WholeSupportedQ}] {} 0
    let imported := imported.setExporting false
    let current := (← Lean.getEnv).setExporting false
    let ns := imported.constants.toList.filter fun (n,_) => n.toString.endsWith ".complete_supported_Q_lp"
    unless ns.length == 1 do throwError "original package proof inventory mismatch"
    let (n,ci) := ns[0]!
    let some raw := ci.value? (allowOpaque := true) | throwError "original package proof absent"
    unless ci.levelParams.isEmpty do throwError "unexpected original package universes"
    let mut proof := raw
    let mut changed := true
    let mut rounds := 0
    while changed do
      changed := false
      rounds := rounds + 1
      if rounds > 1000 then throwError "original package auxiliary expansion did not terminate"
      let mut replacements : Std.HashMap Lean.Name (List Lean.Name × Lean.Expr) := {}
      for m in proof.getUsedConstantsAsSet.toArray do
        if (current.find? m).isSome then continue
        let some dep := imported.find? m | throwError "missing original package proof dependency {m}"
        let some value := dep.value? (allowOpaque := true) | throwError "non-proof foreign original package dependency {m}"
        replacements := replacements.insert m (dep.levelParams,value)
      changed := !replacements.isEmpty
      if changed then
        proof := proof.replace fun e => match e with
          | .const m us =>
            if let some (params,value) := replacements[m]? then some (value.instantiateLevelParams params us) else none
          | _ => none
    unless !proof.hasMVar && !proof.hasFVar do throwError "original package proof is not closed"
    for m in proof.getUsedConstantsAsSet.toArray do
      unless (current.find? m).isSome do throwError "foreign original package constant escaped expansion: {m}"
    Lean.Core.liftIOCore <| Lean.searchPathRef.set savedPath
    let lctx ← Lean.getLCtx
    let mut args : Array Lean.Expr := #[]
    let mut value := proof
    for expected in #[`A,`ell,`Lambda,`hell,`hLambda,`bounds,`T,`normalized,`x,`flat,`rho,`hrho,`p,`hp] do
      let .lam binder _ b _ := value | throwError "original package telescope mismatch"
      unless binder == expected do throwError "original package binder mismatch: {binder} vs {expected}"
      let some decl := lctx.findFromUserName? expected | throwError "original package binder absent"
      args := args.push decl.toExpr
      value := b
    let instantiated := value.instantiateRev args
    Lean.Meta.checkWithKernel instantiated
    let goal ← Lean.Elab.Tactic.getMainGoal
    unless ← Lean.Meta.isDefEq (← Lean.Meta.inferType instantiated) (← goal.getType) do
      throwError "exact original supported_Q_lp body type mismatch"
    goal.assign instantiated
    Lean.Elab.Tactic.replaceMainGoal []


