/-- B03c: eta and every constant precede DU. The support margin forces
curved-zero perturbation data without a flat restriction on a or DU. -/
theorem supported_perturbation_bounds :
    ∃ ccut cpert : ℝ, 0 < ccut ∧ 0 < cpert ∧
    ∀ x : E2, x 1 = 0 → ∀ rho : ℝ, 0 < rho → rho ≤ r →
    closedPatch x rho ⊆ disc r →
    ∃ eta : E2 → ℝ, ∃ Ceta : ℝ≥0,
      ContDiff ℝ ∞ eta ∧ HasCompactSupport eta ∧
      tsupport eta ⊆ Metric.ball x (7 * rho / 4) ∧
      (∀ y ∈ Metric.closedBall x rho, eta y = 1) ∧
      (∀ y, 0 ≤ eta y ∧ eta y ≤ 1) ∧ HolderWith Ceta gamma eta ∧
      Real.rpow rho (gamma : ℝ) * (Ceta : ℝ) ≤ ccut ∧
      (∀ y p, ell * ‖p‖ ^ 2 ≤ inner ℝ p (matrixAction (frozenField a x eta y) p)) ∧
      (∀ y i j, |frozenField a x eta y i j| ≤ Lambda) ∧
      (∀ DU : E2 → E2, ∀ y, y ∉ Metric.ball x (7 * rho / 4) → perturbation a x eta DU y = 0) ∧
      (∀ DU : E2 → E2, ∀ y ∈ curvedEdge x rho, perturbation a x eta DU y = 0) ∧
      (∀ (DU : E2 → E2) (B : ℝ), 0 ≤ B → ∀ CD : ℝ≥0,
        (∀ y ∈ closedPatch x rho, ‖DU y‖ ≤ B) →
        HolderOnWith CD gamma DU (closedPatch x rho) →
        ∃ BP : ℝ, ∃ CP CX : ℝ≥0, 0 ≤ BP ∧
          (∀ y ∈ closedPatch x rho, ‖perturbation a x eta DU y‖ ≤ BP) ∧
          HolderOnWith CP gamma (perturbation a x eta DU) (closedPatch x rho) ∧
          HolderWith CX gamma (positiveExtension x rho (perturbation a x eta DU)) ∧
          (∀ y, ‖positiveExtension x rho (perturbation a x eta DU) y‖ ≤ BP) ∧
          BP + Real.rpow rho (gamma : ℝ) * (CP : ℝ) ≤
            cpert * (Ca : ℝ) * Real.rpow rho (gamma : ℝ) *
              (B + Real.rpow rho (gamma : ℝ) * (CD : ℝ)) ∧
          BP + Real.rpow rho (gamma : ℝ) * (CX : ℝ) ≤
            cpert * (Ca : ℝ) * Real.rpow rho (gamma : ℝ) *
              (B + Real.rpow rho (gamma : ℝ) * (CD : ℝ))) ∧
      (∀ (p : ℝ), 1 < p → ∀ DU : E2 → E2,
        MemLp DU (ENNReal.ofReal p) (volume.restrict (patch x rho)) →
        MemLp (perturbation a x eta DU) (ENNReal.ofReal p) (volume.restrict (patch x rho)) ∧
        MemLp (positiveExtension x rho (perturbation a x eta DU)) (ENNReal.ofReal p) volume ∧
        (eLpNorm (perturbation a x eta DU) (ENNReal.ofReal p) (volume.restrict (patch x rho))).toReal ≤
          cpert * (Ca : ℝ) * Real.rpow rho (gamma : ℝ) *
            (eLpNorm DU (ENNReal.ofReal p) (volume.restrict (patch x rho))).toReal ∧
        (eLpNorm (positiveExtension x rho (perturbation a x eta DU)) (ENNReal.ofReal p) volume).toReal ≤
          Real.rpow 2 (1 / p) * cpert * (Ca : ℝ) * Real.rpow rho (gamma : ℝ) *
            (eLpNorm DU (ENNReal.ofReal p) (volume.restrict (patch x rho))).toReal) := by run_tac do Lean.Elab.Tactic.evalTactic (← Lean.ofExcept (Lean.Parser.runParserCategory (← Lean.getEnv) `tactic "exact (by\n  classical\n  have hcut :\n    ∃ ccut cpert : ℝ, 0 < ccut ∧ 0 < cpert ∧\n      ∀ center : E2, ∀ rho : ℝ, 0 < rho → rho ≤ 2 * r →\n      ∃ eta : E2 → ℝ, ∃ Ceta Cosc : ℝ≥0,\n        ContDiff ℝ ∞ eta ∧ HasCompactSupport eta ∧\n        tsupport eta ⊆ Metric.ball center (7 * rho / 8) ∧\n        (∀ y ∈ Metric.closedBall center (rho / 2), eta y = 1) ∧\n        (∀ y, 0 ≤ eta y ∧ eta y ≤ 1) ∧\n        (∀ y z, ‖y - center‖ = ‖z - center‖ → eta y = eta z) ∧\n        HolderWith Ceta gamma eta ∧\n        Real.rpow rho (gamma : ℝ) * (Ceta : ℝ) ≤ ccut ∧\n        (∀ y p, ell * ‖p‖ ^ 2 ≤ inner ℝ p (matrixAction (frozenField a center eta y) p)) ∧\n        (∀ y i j, |frozenField a center eta y i j| ≤ Lambda) ∧\n        (∀ y p, ‖matrixAction (frozenField a center eta y - a center) p‖ ≤\n          cpert * (Ca : ℝ) * Real.rpow rho (gamma : ℝ) * ‖p‖) ∧\n        (∀ i j, HolderWith Cosc gamma (fun y => (frozenField a center eta y - a center) i j)) ∧\n        Real.rpow rho (gamma : ℝ) * (Cosc : ℝ) ≤\n          cpert * (Ca : ℝ) * Real.rpow rho (gamma : ℝ) := by\n    let b := ContDiffBumpBase.ofInnerProductSpace E2\n    let chi : E2 → ℝ := fun x => b.toFun (3 / 2) ((2 : ℝ) • x)\n    have hsm : ContDiff ℝ ∞ chi := by\n      exact b.smooth.comp_contDiff\n        (contDiff_const.prodMk (contDiff_id.const_smul _))\n        (fun x => ⟨by norm_num, mem_univ _⟩)\n    have hsupport : Function.support chi = Metric.ball 0 (3 / 4 : ℝ) := by\n      ext x\n      change ((2 : ℝ) • x ∈ Function.support (b.toFun (3 / 2))) ↔ _\n      rw [b.support _ (by norm_num)]\n      change dist ((2 : ℝ) • x) 0 < 3/2 ↔ dist x 0 < 3/4\n      rw [dist_zero_right, dist_zero_right, norm_smul, Real.norm_eq_abs, abs_of_pos (by norm_num : (0 : ℝ) < 2)]\n      constructor <;> intro h <;> linarith\n    have hts : tsupport