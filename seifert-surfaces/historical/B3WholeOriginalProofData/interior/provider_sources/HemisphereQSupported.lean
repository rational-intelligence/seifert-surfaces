/-- Gradient of the planar fundamental solution with Laplacian +delta;
its totalized value at zero is zero. -/
def laplaceKernelGradient (z : E2) : E2 := ((2 * Real.pi * ‖z‖ ^ 2)⁻¹) • z

/-- Positive reflection of the actual upper-half-space datum. -/
def evenData (G : E2 → E2) (z : E2) : E2 :=
  if 0 ≤ z 1 then G z else G (reflect z)

/-- Source (5.5.20): its tangential correction is retained. The datum G is
zero outside a bounded upper-half-space set, so the integrals extend by zero. -/
def bookQ (G : E2 → E2) (z : E2) : ℝ :=
  -(∫ t, inner ℝ (laplaceKernelGradient (z - t)) (evenData G t)) +
    2 * ∫ t in {t : E2 | t 1 < 0},
      (laplaceKernelGradient (z - t)) 0 * (evenData G t) 0

/-- Pull the localized flux into normalized coordinates, with its literal
inverse linear transformation; only localized data are extended. -/
def pulledFlux (T : E2 ≃L[ℝ] E2) (x : E2) (rho : ℝ) (E : E2 → E2) : E2 → E2 :=
  by
  classical
  exact fun z => if x + T z ∈ closedPatch x rho then T.symm (E (x + T z)) else 0

/-- Native e_book=-E sign and pullback of the source potential. -/
def potential (T : E2 ≃L[ℝ] E2) (x : E2) (rho : ℝ) (E : E2 → E2) : E2 → ℝ :=
  fun y => bookQ (fun z => -pulledFlux T x rho E z) (T.symm (y - x))

def coordinateMatrix (T : E2 ≃L[ℝ] E2) : Mat2 :=
  fun i j => (T (coordinateVector 2 j)) i

/-- Concrete normalization, with the flat-plane orientation and conditioning
retained. It constrains the symmetric constant part only. -/
def Normalizes (A : Mat2) (ell Lambda : ℝ) (T : E2 ≃L[ℝ] E2) : Prop :=
  (∃ t : ℝ, 0 < t ∧ ∀ z : E2, (T z) 1 = t * z 1) ∧
  (∀ p : E2,
    T.symm (matrixAction (symmetricPart A)
      (T.symm.toContinuousLinearMap.adjoint p)) = p) ∧
  ‖T.toContinuousLinearMap‖ ≤ Real.sqrt (2 * Lambda) ∧
  ‖T.symm.toContinuousLinearMap‖ ≤ (Real.sqrt ell)⁻¹ ∧
  Measure.map T volume =
    ENNReal.ofReal (|Matrix.det (coordinateMatrix T)|⁻¹) • volume

/-- Native flat trace localized away from the outer curved edge. -/
def LocalFlatTrace (x : E2) (rho : ℝ) (q : E2 → ℝ) (dq : E2 → E2) : Prop :=
  ∀ chi : E2 → ℝ, ContDiff ℝ ∞ chi → HasCompactSupport chi →
    tsupport chi ⊆ Metric.ball x (2 * rho) →
    H10On (patch x rho) (fun y => chi y * q y) (cutoffGradient chi q dq)

def perturbation (a : E2 → Mat2) (x : E2) (eta : E2 → ℝ) (DU : E2 → E2) : E2 → E2 :=
  fun y => matrixAction (a x - frozenField a x eta y) (DU y)

/-- Coordinates are chosen from the frozen coefficient before any datum. -/
theorem normalizing_coordinates (A : Mat2) (ell Lambda : ℝ)
