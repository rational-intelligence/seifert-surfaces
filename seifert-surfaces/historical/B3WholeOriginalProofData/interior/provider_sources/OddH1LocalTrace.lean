    (hc : HasCompactSupport chi) (hs : tsupport chi ⊆ Metric.ball (0 : E2) R) :
    H10On (halfDisc R) (fun z => chi z * u z) (cutoffGradient chi u du) ∧
    ∀ ε : ℝ, 0 < ε → ∃ phi : E2 → ℝ,
      ContDiff ℝ ∞ phi ∧ HasCompactSupport phi ∧ tsupport phi ⊆ halfDisc R ∧
      IntegrableOn
        (fun z => |chi z * u z - phi z| ^ 2 +
