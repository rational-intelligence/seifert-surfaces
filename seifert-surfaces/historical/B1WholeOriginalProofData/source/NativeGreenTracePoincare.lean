/-- Native scalar H1 oscillation estimate on the same Euclidean unit disc. -/
theorem native_h1_mean_subtracted_unit_disc
    (u : E2 → ℝ) (du : E2 → E2) (h1 : H1On (disc 1) u du) :
    (∫ x in disc 1, |u x - ⨍ y in disc 1, u y ∂volume| ^ 2) ≤
      (256 : ℝ) * ∫ x in disc 1, ‖du x‖ ^ 2 := by run_tac do Lean.Elab.Tactic.evalTactic (← Lean.ofExcept (Lean.Parser.runParserCategory (← Lean.getEnv) `tactic "exact (by\n  obtain ⟨hw, hweq⟩ := native_h1_w1p_witness u du h1\n  have hp := DeGiorgi.poincare_unitBall_W1p_public (d := 2) (p := (2 : ℝ))\n    (u := u) (by norm_num)\n  have hnum : ENNReal.ofReal (2 : ℝ) = 2 := by norm_num\n  rw [hnum] at hp\n  have hb := hp hw\n  have hc : DeGiorgi.CPoincVal 2 = 16 := by norm_num [DeGiorgi.CPoincVal]\n  have hbound : eLpNorm (fun x => u x - ⨍ y in disc 1, u y) 2 (volume.restrict (disc 1)) ≤\n      ENNReal.ofReal 16 * eLpNorm (fun x => ‖du x‖) 2 (volume.restrict (disc 1)) := by\n    delta disc\n    simpa only [hc,hweq] using hb\n  have hdLp : MemLp (fun x => ‖du x‖) 2 (volume.restrict (disc 1)) := h1.2.2.norm\n  have hlLp : MemLp (fun x => u x - ⨍ y in disc 1, u y) 2 (volume.restrict (disc 1)) := by\n    exact lt_of_le_of_lt hbound (ENNReal.mul_lt_top ENNReal.ofReal_lt_top hdLp.eLpNorm_lt_top)\n  have hreal := ENNReal.toReal_mono\n    (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hdLp.eLpNorm_ne_top) hbound\n  rw [ENNReal.toReal_mul,ENNReal.toReal_ofReal (by norm_num)] at hreal\n  calc\n    _ = ∫ x in disc 1, (u x - ⨍ y in disc 1, u y) ^ 2 := by\n      apply integral_congr_ae\n      filter_upwards with x\n      exact sq_abs _\n    _ = (eLpNorm (fun x => u x - ⨍ y in disc 1, u y) 2\n        (volume.restrict (disc 1))).toReal ^ 2 :=\n      DifferentialGeometry.Analysis.Integration.integral_sq_eq_l2 hlLp\n    _ ≤ (16 * (eLpNorm (fun x => ‖du x‖) 2 (volume.restrict (disc 1))).toReal) ^ 2 :=\n      (sq_le_sq₀ ENNReal.toReal_nonneg (by positivity)).mpr hreal\n    _ = _ := by\n      rw [DifferentialGeometry.Analysis.Integration.integral_sq_eq_l2 hdLp]\n      ring\n)"))

/-- Literal Green coordinate test, using the supplied jets and boundary map. -/
theorem native_green_coordinate_mean_identity
    (f : E2 → E2) (d : Fin 2 → E2 → E2) (b : ℝ → E2)
    (i j : Fin 2) (h1 : H1On (disc 1) (fun x => f x i) (d i))
    (trace : HasGreenBoundaryTrace f d b) :
    (∫ x in disc 1, f x i) =
      (∫ t in Icc 0 (2 * Real.pi), b t i * (unitCircleParameter t j) ^ 2) -
        ∫ x in disc 1, d i x j * x j := by run_tac do Lean.Elab.Tactic.evalTactic (← Lean.ofExcept (Lean.Parser.runParserCategory (← Lean.getEnv) `tactic "exact (by\n  let P : E2 →L[ℝ] ℝ := PiLp.proj 2 (fun _ : Fin 2 => ℝ) j\n  have htest : ContDiff ℝ ∞ (fun x : E2 => x j) := P.contDiff\n  have hderiv (x : E2) :\n      fderiv ℝ (fun y : E2 => y j) x (coordinateVector 2 j) = 1 := by\n    change fderiv ℝ P x (coordinateVector 2 j) = 1\n    rw [P.hasFDerivAt.fderiv]\n    change (coordinateVector 2 j) j = 1\n    delta coordinateVector\n    simp only [PiLp.single_apply, ite_true]\n  have green := trace (fun x : E2 => x j) htest i j\n  let : IsFiniteMeasure (volume.restrict (disc 1)) :=\n    isFiniteMeasure_restrict.mpr measure_ball_lt_top.ne\n  have hf : IntegrableOn (fun x => f x i) (disc 1) :=\n    h1.2.1.integrable (by norm_num)\n  have hsum : IntegrableOn (fun x => f x i + d i x j * x j) (disc 1) := by\n    apply green.1.congr\n    exact Filter.Eventually.of_forall (fun x => by simp only [hderiv, mul_one])\n  have hp : IntegrableOn (fun x => d i x j * x j) (disc 1) := by\n    convert hsum.sub hf using 1\n    ext x\n    change d i x j * x j = (f x i + d i x j * x j) - f x i\n    ring\n  apply eq_sub_iff_add_eq.mpr\n  rw [← integral_add hf hp]\n  calc\n    _ = ∫ t in Icc 0 (2 * Real.pi),\n        b t i * unitCircleParameter t j * unitCircleParameter t j := by\n      simpa only [hderiv, mul_one] using green.2.2\n    _ = _ := integral_congr_ae (Filter.Eventually.of_forall (fun t => by ring))\n)"))

/-- The same map's integral mean is bounded by the bounded literal trace and jets. -/
theorem native_green_coordinate_mean_bound
    (f : E2 → E2) (d : Fin 2 → E2 → E2) (b : ℝ → E2) (B : ℝ)
    (i : Fin 2) (h1 : H1On (disc 1) (fun x => f x i) (d i))
    (trace : HasGreenBoundaryTrace f d b)
    (boundary_bound : ∀ t, ‖b t‖ ≤ B) (B_nonneg : 0 ≤ B) :
    (∫ x in disc 1, f x i) ^ 2 ≤
      8 * Real.pi ^ 2 * B ^ 2 +
        2 * (volume (disc 1)).toReal * ∫ x in disc 1, ‖d i x‖ ^ 2 := by run_tac do Lean.Elab.Tactic.evalTactic (← Lean.ofExcept (Lean.Parser.runParserCategory (← Lean.getEnv) `tactic "exact (by\n  let a : ℝ := ∫ t in Icc 0 (2 * Real.pi), b t i * (unitCircleParameter t 0) ^ 2\n  let c : ℝ := ∫ x in disc 1, d i x 0 * x 0\n  let V : ℝ := (volume (disc 1)).toReal\n  let N : ℝ := ∫ x in disc 1, ‖d i x‖\n  let Q : ℝ := ∫ x in disc 1, ‖d i x‖ ^ 2\n  let : IsFiniteMeasure (volume.restrict (disc 1)) :=\n    isFiniteMeasure_restrict.mpr measure_ball_lt_top.ne\n  have hV : 0 < V := ENNReal.toReal_pos\n    (Metric.measure_ball_pos volume (0 : E2) (by norm_num : (0 : ℝ) < 1)).ne'\n    measure_ball_lt_top.ne\n  have hg : IntegrableOn (fun x => ‖d i x‖) (disc 1) :=\n    h1.2.2.norm.integrable (by norm_num)\n  have hg2 : IntegrableOn (fun x => ‖d i x‖ ^ 2) (disc 1) :=\n    h1.2.2.norm.integrable_sq\n  have hcoord (x : E2) (hx : x ∈ disc 1) : ‖x 0‖ ≤ 1 := by\n    have hx' : ‖x‖ < 1 := by\n      change x ∈ Metric.ball (0 : E2) 1 at hx\n      change dist x (0 : E2) < 1 at hx\n      rw [dist_zero_right] at hx\n      exact hx\n    exact (PiLp.norm_apply_le x 0).trans hx'.le\n  have hcnorm : ‖c‖ ≤ N := by\n    apply norm_integral_le_of_norm_le hg\n    filter_upwards [ae_restrict_mem (Metric.isOpen_ball.measurableSet : MeasurableSet (disc 1))] with x hx\n    calc\n      ‖d i x 0 * x 0‖ = ‖d i x 0‖ * ‖x 0‖ := norm_mul _ _\n      _ ≤ ‖d i x‖ * 1 := mul_le_mul (PiLp.norm_apply_le (d i x) 0)\n        (hcoord x hx) (norm_nonneg _) (norm_nonneg _)\n      _ = ‖d i x‖ := mul_one _\n  have hvariance : 0 ≤ ∫ x in disc 1, (N - V * ‖d i x‖) ^ 2 :=\n    integral_nonneg (fun _ => sq_nonneg _)\n  have hvariance_eq : (∫ x in disc 1, (N - V * ‖d i x‖) ^ 2) =\n      V * N ^ 2 - (2 * N * V) * N + V ^ 2 * Q := by\n    have hconst : IntegrableOn (fun _ : E2 => N ^ 2) (disc 1) := integrable_const _\n    have hexp : (fun x : E2 => (N - V * ‖d i x‖) ^ 2) =\n        (fun x => (N ^ 2 - (2 * N * V) * ‖d i x‖) + V ^ 2 * ‖d i x‖ ^ 2) := by\n      funext x\n      ring\n    have hadd : (∫ x in disc 1, (N ^ 2 - (2 * N * V) * ‖d i x‖) +\n        V ^ 2 * ‖d i x‖ ^ 2) = (∫ x in disc 1, N ^ 2 - (2 * N * V) * ‖d i x‖) +\n          ∫ x in disc 1, V ^ 2 * ‖d i x‖ ^ 2 :=\n      integral_add (hconst.sub (hg.const_mul (2 * N * V))) (hg2.const_mul (V ^ 2))\n    have hsub : (∫ x in disc 1, N ^ 2 - (2 * N * V) * ‖d i x‖) =\n        (∫ _ : E2 in disc 1, N ^ 2) - ∫ x in disc 1, (2 * N * V) * ‖d i x‖ :=\n      integral_sub hconst (hg.const_mul (2 * N * V))\n    calc\n      _ = ∫ x in disc 1, (N ^ 2 - (2 * N * V) * ‖d i x‖) +\n          V ^ 2 * ‖d i x‖ ^ 2 := by rw [hexp]\n      _ = _ := by\n        rw [hadd, hsub, integral_const_mul,\n          integral_const_mul, setIntegral_const]\n        rfl\n  rw [hvariance_eq] at hvariance\n  have hCS : N ^ 2 ≤ V * Q := by\n    apply (mul_le_mul_iff_of_pos_left hV).mp\n    nlinarith [hvariance]\n  have hcsq : c ^ 2 ≤ V * Q := by\n    calc\n      _ = ‖c‖ ^ 2 := by rw [Real.norm_eq_abs, sq_abs]\n      _ ≤ N ^ 2 := pow_le_pow_left₀ (norm_nonneg _) hcnorm 2\n      _ ≤ V * Q := hCS\n  have hcircle (t : ℝ) : unitCircleParameter t 0 = Real.cos t := by\n    delta unitCircleParameter\n    rfl\n  have habound : ∀ t ∈ Icc 0 (2 * Real.pi),\n      ‖b t i * (unitCircleParameter t 0) ^ 2‖ ≤ B := by\n    intro t _\n    rw [hcircle, norm_mul, norm_pow]\n    have hcos : ‖Real.cos t‖ ^ 2 ≤ 1 := by\n      rw [Real.norm_eq_abs, sq_abs]\n      exact Real.cos_sq_le_one t\n    calc\n      _ ≤ B * 1 := mul_le_mul ((PiLp.norm_apply_le (b t) i).trans (boundary_bound t))\n        hcos (sq_nonneg _) B_nonneg\n      _ = B := mul_one B\n  have hanorm : ‖a‖ ≤ B * (2 * Real.pi) := by\n    have hb := norm_setIntegral_le_of_norm_le_const (μ := volume) measure_Icc_lt_top habound\n    change ‖a‖ ≤ B * (volume (Icc 0 (2 * Real.pi))).toReal at hb\n    rw [Real.volume_Icc, sub_zero,\n      ENNReal.toReal_ofReal (by positivity : (0 : ℝ) ≤ 2 * Real.pi)] at hb\n    exact hb\n  have hasq : a ^ 2 ≤ 4 * Real.pi ^ 2 * B ^ 2 := by\n    calc\n      _ = ‖a‖ ^ 2 := by rw [Real.norm_eq_abs, sq_abs]\n      _ ≤ (B * (2 * Real.pi)) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) hanorm 2\n      _ = _ := by ring\n  have hid : (∫ x in disc 1, f x i) = a - c :=\n    native_green_coordinate_mean_identity f d b i 0 h1 trace\n  rw [hid]\n  change (a - c) ^ 2 ≤ 8 * Real.pi ^ 2 * B ^ 2 + 2 * V * Q\n  nlinarith [hasq, hcsq, sq_nonneg (a + c)]\n)"))

/-- Exact remaining Euclidean bounded-native-Green-trace residual. -/
theorem bounded_native_green_trace_euclidean_poincare :
    ∃ K : ℝ, 0 < K ∧ ∀ (f : E2 → E2) (d : Fin 2 → E2 → E2)
      (b : ℝ → E2) (B : ℝ),
      (∀ i, H1On (disc 1) (fun x => f x i) (d i)) →
      HasGreenBoundaryTrace f d b →
      (∀ t, ‖b t‖ ≤ B) → 0 ≤ B →
      (∫ x in disc 1, ‖f x‖ ^ 2) ≤
        K * (B ^ 2 + ∫ x in disc 1, ∑ i : Fin 2, ‖d i x‖ ^ 2) := by run_tac do Lean.Elab.Tactic.evalTactic (← Lean.ofExcept (Lean.Parser.runParserCategory (← Lean.getEnv) `tactic "exact (by\n  let V : ℝ := (volume (disc 1)).toReal\n  let A : ℝ := 16 * Real.pi ^ 2 / V\n  let : IsFiniteMeasure (volume.restrict (disc 1)) :=\n    isFiniteMeasure_restrict.mpr measure_ball_lt_top.ne\n  have hV : 0 < V := ENNReal.toReal_pos\n    (Metric.measure_ball_pos volume (0 : E2) (by norm_num : (0 : ℝ) < 1)).ne'\n    measure_ball_lt_top.ne\n  have hA : 0 ≤ A := by positivity\n  refine ⟨2 * A + 517, by positivity, ?_⟩\n  intro f d b B h1 trace boundary_bound B_nonneg\n  have hscalar (i : Fin 2) : (∫ x in disc 1, (f x i) ^ 2) ≤\n      A * B ^ 2 + 516 * ∫ x in disc 1, ‖d i x‖ ^ 2 := by\n    let m : ℝ := ⨍ x in disc 1, f x i ∂volume\n    have hm : m = V⁻¹ * (∫ x in disc 1, f x i) := by\n      exact setAverage_eq volume (fun x => f x i) (disc 1)\n    have hvm : V * m = ∫ x in disc 1, f x i := by\n      rw [hm, ← mul_assoc, mul_inv_cancel₀ hV.ne', one_mul]\n    have hcoef : (2 / V) * V = 2 := by\n      rw [div_eq_mul_inv, mul_assoc, inv_mul_cancel₀ hV.ne', mul_one]\n    have hmean : 2 * V * m ^ 2 ≤ A * B ^ 2 +\n        4 * ∫ x in disc 1, ‖d i x‖ ^ 2 := by\n      calc\n        _ = (2 / V) * (∫ x in disc 1, f x i) ^ 2 := by\n          rw [← hvm]\n          calc\n            _ = 2 * (V * m ^ 2) := by ring\n            _ = ((2 / V) * V) * (V * m ^ 2) := by rw [hcoef]\n            _ = _ := by ring\n        _ ≤ (2 / V) * (8 * Real.pi ^ 2 * B ^ 2 +\n            2 * V * ∫ x in disc 1, ‖d i x‖ ^ 2) :=\n          mul_le_mul_of_nonneg_left\n            (native_green_coordinate_mean_bound f d b B i (h1 i) trace boundary_bound B_nonneg)\n            (by positivity)\n        _ = A * B ^ 2 + 4 * ∫ x in disc 1, ‖d i x‖ ^ 2 := by\n          calc\n            _ = ((2 / V) * 8 * Real.pi ^ 2) * B ^ 2 +\n                (2 * ((2 / V) * V)) * ∫ x in disc 1, ‖d i x‖ ^ 2 := by ring\n            _ = _ := by rw [hcoef]; dsimp [A]; rw [div_eq_mul_inv]; ring\n    have hsq : IntegrableOn (fun x => (f x i) ^ 2) (disc 1) :=\n      (h1 i).2.1.integrable_sq\n    have hosc : IntegrableOn (fun x => |f x i - m| ^ 2) (disc 1) :=\n      ((h1 i).2.1.sub (memLp_const m)).norm.integrable_sq\n    have hdecomp : (∫ x in disc 1, (f x i) ^ 2) ≤\n        2 * (∫ x in disc 1, |f x i - m| ^ 2) + 2 * V * m ^ 2 := by\n      calc\n        _ ≤ ∫ x in disc 1, 2 * |f x i - m| ^ 2 + 2 * m ^ 2 := by\n          apply integral_mono hsq ((hosc.const_mul 2).add (integrable_const _))\n          intro x\n          change (f x i) ^ 2 ≤ 2 * |f x i - m| ^ 2 + 2 * m ^ 2\n          rw [sq_abs]\n          nlinarith [sq_nonneg (f x i - 2 * m)]\n        _ = _ := by\n          rw [integral_add (hosc.const_mul 2) (integrable_const _),\n            integral_const_mul, setIntegral_const]\n          change 2 * (∫ x in disc 1, |f x i - m| ^ 2) + V * (2 * m ^ 2) = _\n          ring\n    have hpaid := native_h1_mean_subtracted_unit_disc (fun x => f x i) (d i) (h1 i)\n    change (∫ x in disc 1, |f x i - m| ^ 2) ≤\n      256 * ∫ x in disc 1, ‖d i x‖ ^ 2 at hpaid\n    nlinarith [hdecomp, hmean, hpaid]\n  let E : ℝ := ∫ x in disc 1, ∑ i : Fin 2, ‖d i x‖ ^ 2\n  have hE : E = (∫ x in disc 1, ‖d 0 x‖ ^ 2) +\n      ∫ x in disc 1, ‖d 1 x‖ ^ 2 := by\n    calc\n      _ = ∫ x in disc 1, ‖d 0 x‖ ^ 2 + ‖d 1 x‖ ^ 2 := by\n        apply integral_congr_ae\n        filter_upwards with x\n        exact Fin.sum_univ_two _\n      _ = _ := integral_add (h1 0).2.2.norm.integrable_sq (h1 1).2.2.norm.integrable_sq\n  have hE_nonneg : 0 ≤ E := integral_nonneg (fun x => Finset.sum_nonneg (fun i _ => sq_nonneg _))\n  have hFnorm : (∫ x in disc 1, ‖f x‖ ^ 2) =\n      (∫ x in disc 1, (f x 0) ^ 2) + ∫ x in disc 1, (f x 1) ^ 2 := by\n    calc\n      _ = ∫ x in disc 1, (f x 0) ^ 2 + (f x 1) ^ 2 := by\n        apply integral_congr_ae\n        filter_upwards with x\n        exact (EuclideanSpace.real_norm_sq_eq (f x)).trans (Fin.sum_univ_two _)\n      _ = _ := integral_add (h1 0).2.1.integrable_sq (h1 1).2.1.integrable_sq\n  change (∫ x in disc 1, ‖f x‖ ^ 2) ≤ (2 * A + 517) * (B ^ 2 + E)\n  calc\n    _ = (∫ x in disc 1, (f x 0) ^ 2) + ∫ x in disc 1, (f x 1) ^ 2 := hFnorm\n    _ ≤ (A * B ^ 2 + 516 * ∫ x in disc 1, ‖d 0 x‖ ^ 2) +\n        (A * B ^ 2 + 516 * ∫ x in disc 1, ‖d 1 x‖ ^ 2) :=\n      add_le_add (hscalar 0) (hscalar 1)\n    _ = 2 * A * B ^ 2 + 516 * E := by rw [hE]; ring\n    _ ≤ _ := by nlinarith [sq_nonneg B, mul_nonneg hA hE_nonneg]\n\n)"))

end SeifertSurfaces.OriginalEndpoints.B1Tangency.ChartMetricProvider.Variational.DirectMethod
