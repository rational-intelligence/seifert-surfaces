import B1MetricVariationalInterfaces import NativeH1WitnessBridge import DifferentialGeometry.External.DeGiorgi.SobolevPoincare import DifferentialGeometry.Analysis.Integration.LpNorm

noncomputable section
open Set Topology Function MeasureTheory
